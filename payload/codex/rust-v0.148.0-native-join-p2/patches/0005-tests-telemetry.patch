+#[test]
+fn agent_run_terminal_mapper_preserves_exact_outcomes() {
+    let completed = EventMsg::TurnComplete(TurnCompleteEvent {
+        turn_id: "run".to_string(),
+        last_agent_message: Some("done".to_string()),
+        error: None,
+        started_at: None,
+        completed_at: None,
+        duration_ms: None,
+        time_to_first_token_ms: None,
+    });
+    assert_eq!(
+        agent_run_terminal_from_event(&completed, None),
+        Some(AgentRunTerminal {
+            outcome: AgentRunOutcome::Completed {
+                output: Some("done".to_string()),
+            },
+        })
+    );
+
+    let aborted = |reason| {
+        EventMsg::TurnAborted(TurnAbortedEvent {
+            turn_id: Some("run".to_string()),
+            reason,
+            started_at: None,
+            completed_at: None,
+            duration_ms: None,
+        })
+    };
+    assert_eq!(
+        agent_run_terminal_from_event(&aborted(TurnAbortReason::Interrupted), None),
+        Some(AgentRunTerminal {
+            outcome: AgentRunOutcome::Cancelled {
+                reason: "interrupted".to_string(),
+            },
+        })
+    );
+    assert!(matches!(
+        agent_run_terminal_from_event(&aborted(TurnAbortReason::BudgetLimited), None),
+        Some(AgentRunTerminal {
+            outcome: AgentRunOutcome::Failed {
+                reason: Some(reason),
+                ..
+            },
+        }) if reason == "budget_limited"
+    ));
+
+    let error = ErrorEvent {
+        message: "failed".to_string(),
+        codex_error_info: None,
+    };
+    assert_eq!(
+        agent_run_terminal_from_event(&completed, Some(&error)),
+        Some(AgentRunTerminal {
+            outcome: AgentRunOutcome::Failed {
+                message: "failed".to_string(),
+                reason: None,
+            },
+        })
+    );
+}

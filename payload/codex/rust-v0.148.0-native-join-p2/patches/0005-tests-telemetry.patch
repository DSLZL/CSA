+            "join_agent",
+            function_payload(json!({"target": worker_id.to_string(), "run_id": "run"})),
+        ))
+        .await
+        .err()
+        .expect("join_agent should reject self");
+    assert_eq!(
+        self_error,
+        FunctionCallError::RespondToModel("an agent cannot join its own run".to_string())
+    );
+}

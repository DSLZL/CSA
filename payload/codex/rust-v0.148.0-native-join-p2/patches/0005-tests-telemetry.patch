+async fn run_native_join_approval_case(
+    decision: ReviewDecision,
+    child_output: &'static str,
+) -> Result<()> {
+    let server = start_mock_server().await;
+    let spawn_args = json!({
+        "message": "run the approval-requiring command, then finish",
+        "task_name": "worker"
+    })
+    .to_string();
+    mount_sse_once_match(
+        &server,
+        |request: &wiremock::Request| body_contains(request, APPROVAL_PARENT_PROMPT),
+        sse(vec![
+            ev_response_created("native-join-approval-parent-1"),
+            ev_function_call_with_namespace(
+                APPROVAL_SPAWN_CALL_ID,
+                "collaboration",
+                "spawn_agent",
+                &spawn_args,
+            ),
+            ev_completed("native-join-approval-parent-1"),
+        ]),
+    )
+    .await;
+
+    let shell_args = json!({
+        "command": "csa-native-join-approval-probe",
+        "sandbox_permissions": "require_escalated",
+        "justification": "Exercise child approval while the parent is joined."
+    })
+    .to_string();
+    mount_sse_once_match(
+        &server,
+        request_is_subagent,
+        sse(vec![
+            ev_response_created("native-join-approval-child-1"),
+            ev_function_call(APPROVAL_CHILD_CALL_ID, "shell_command", &shell_args),
+            ev_completed("native-join-approval-child-1"),
+        ]),
+    )
+    .await;
+
+    let spawned_run = Arc::new(Mutex::new(None::<(String, String)>));
+    let captured_spawned_run = Arc::clone(&spawned_run);
+    Mock::given(method("POST"))
+        .and(path("/v1/responses"))
+        .and(move |request: &wiremock::Request| {
+            body_contains(request, APPROVAL_SPAWN_CALL_ID)
+                && !request_is_subagent(request)
+                && !body_contains(request, APPROVAL_JOIN_CALL_ID)
+        })
+        .respond_with(move |request: &wiremock::Request| {
+            let spawn = function_call_output_json(request, APPROVAL_SPAWN_CALL_ID)
+                .expect("Parent request should contain JSON spawn output");
+            let target = spawn["task_name"]
+                .as_str()
+                .expect("spawn output task_name")
+                .to_string();
+            let run_id = spawn["run_id"]
+                .as_str()
+                .expect("spawn output run_id")
+                .to_string();
+            *captured_spawned_run.lock().expect("spawn capture lock") =
+                Some((target.clone(), run_id.clone()));
+            let join_args = json!({ "target": target, "run_id": run_id }).to_string();
+            sse_response(sse(vec![
+                ev_response_created("native-join-approval-parent-2"),
+                ev_function_call(APPROVAL_JOIN_CALL_ID, "join_agent", &join_args),
+                ev_completed("native-join-approval-parent-2"),
+            ]))
+        })
+        .expect(1)
+        .mount(&server)
+        .await;
+    mount_sse_once_match(
+        &server,
+        |request: &wiremock::Request| {
+            request_is_subagent(request) && body_contains(request, APPROVAL_CHILD_CALL_ID)
+        },
+        sse(vec![
+            ev_response_created("native-join-approval-child-2"),
+            ev_assistant_message("native-join-approval-child-message", child_output),
+            ev_completed("native-join-approval-child-2"),
+        ]),
+    )
+    .await;
+    let parent_after_join = mount_sse_once_match(
+        &server,
+        |request: &wiremock::Request| {
+            !request_is_subagent(request)
+                && function_call_output_json(request, APPROVAL_JOIN_CALL_ID).is_some()
+        },
+        sse(vec![
+            ev_response_created("native-join-approval-parent-3"),
+            ev_assistant_message("native-join-approval-parent-message", "parent done"),
+            ev_completed("native-join-approval-parent-3"),
+        ]),
+    )
+    .await;
+
+    let test = test_codex()
+        .with_model("test-gpt-5.1-codex")
+        .with_config(|config| {
+            config
+                .features
+                .enable(Feature::Collab)
+                .expect("test config should allow feature update");
+            config
+                .features
+                .enable(Feature::MultiAgentV2)
+                .expect("test config should allow feature update");
+        })
+        .build(&server)
+        .await?;
+    let session_model = test.session_configured.model.clone();
+    let permission_profile = PermissionProfile::read_only();
+    let (sandbox_policy, permission_profile) =
+        turn_permission_fields(permission_profile, test.cwd.path());
+    test.codex
+        .start_or_steer_turn(user_input_request(
+            APPROVAL_PARENT_PROMPT,
+            ThreadSettingsOverrides {
+                environments: Some(local_selections(test.config.cwd.clone())),
+                approval_policy: Some(AskForApproval::OnRequest),
+                sandbox_policy: Some(sandbox_policy),
+                permission_profile,
+                collaboration_mode: Some(CollaborationMode {
+                    mode: ModeKind::Default,
+                    settings: Settings {
+                        model: session_model,
+                        reasoning_effort: None,
+                        developer_instructions: None,
+                    },
+                }),
+                ..Default::default()
+            },
+        ))
+        .await?;
+
+    timeout(Duration::from_secs(5), async {
+        loop {
+            if spawned_run.lock().expect("spawn capture lock").is_some() {
+                return;
+            }
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .expect("Parent should receive spawn output and request exact join");
+    timeout(
+        Duration::from_secs(5),
+        wait_for_event(&test.codex, |event| {
+            matches!(
+                event,
+                EventMsg::ItemStarted(event)
+                    if matches!(
+                        &event.item,
+                        TurnItem::CollabAgentToolCall(item)
+                            if item.id == APPROVAL_JOIN_CALL_ID
+                                && item.tool == CollabAgentTool::Join
+                                && item.status == CollabAgentToolCallStatus::InProgress
+                    )
+            )
+        }),
+    )
+    .await
+    .expect("Join should remain pending while the child waits for approval");
+
+    let root_thread_id = test.session_configured.thread_id;
+    let child_thread_id = test
+        .thread_manager
+        .list_thread_ids()
+        .await
+        .into_iter()
+        .find(|thread_id| *thread_id != root_thread_id)
+        .expect("spawned child thread ID");
+    let child_thread = test.thread_manager.get_thread(child_thread_id).await?;
+    let approval = timeout(Duration::from_secs(20), async {
+        loop {
+            let event = child_thread
+                .next_event()
+                .await
+                .expect("child event stream should remain open");
+            match event.msg {
+                EventMsg::ExecApprovalRequest(approval) => return approval,
+                terminal @ (EventMsg::TurnComplete(_)
+                | EventMsg::TurnAborted(_)
+                | EventMsg::Error(_)) => {
+                    panic!("child became terminal before approval: {terminal:?}")
+                }
+                _ => {}
+            }
+        }
+    })
+    .await
+    .expect("child approval should remain live while Parent Join is pending");
+    assert_eq!(child_thread.agent_status().await, AgentStatus::Running);
+
+    let requests_while_pending = server
+        .received_requests()
+        .await
+        .expect("mock server should retain response requests")
+        .into_iter()
+        .filter(|request| request.url.path().ends_with("/responses"))
+        .collect::<Vec<_>>();
+    assert_eq!(requests_while_pending.len(), 3);
+    assert_eq!(
+        requests_while_pending
+            .iter()
+            .filter(|request| !request_is_subagent(request))
+            .count(),
+        2
+    );
+
+    child_thread
+        .submit(Op::ExecApproval {
+            id: approval.effective_approval_id(),
+            turn_id: None,
+            decision,
+        })
+        .await?;
+    timeout(
+        Duration::from_secs(10),
+        wait_for_event(&test.codex, |event| {
+            matches!(
+                event,
+                EventMsg::ItemCompleted(event)
+                    if matches!(
+                        &event.item,
+                        TurnItem::CollabAgentToolCall(item)
+                            if item.id == APPROVAL_JOIN_CALL_ID
+                                && item.tool == CollabAgentTool::Join
+                                && item.status == CollabAgentToolCallStatus::Completed
+                    )
+            )
+        }),
+    )
+    .await
+    .expect("terminal child run should resolve Join after approval decision");
+    timeout(
+        Duration::from_secs(5),
+        wait_for_event(&test.codex, |event| {
+            matches!(event, EventMsg::TurnComplete(_))
+        }),
+    )
+    .await
+    .expect("Join result should trigger one final Parent response");
+
+    let (_, run_id) = spawned_run
+        .lock()
+        .expect("spawn capture lock")
+        .clone()
+        .expect("spawn result should be captured");
+    let join_output = parent_after_join
+        .function_call_output_text(APPROVAL_JOIN_CALL_ID)
+        .expect("Parent continuation should contain approval Join result");
+    let join_output: serde_json::Value = serde_json::from_str(&join_output)?;
+    assert_eq!(join_output["run_id"], json!(run_id));
+    assert_eq!(join_output["status"], json!("completed"));
+    assert_eq!(join_output["output"], json!(child_output));
+
+    server.verify().await;
+    let requests = server
+        .received_requests()
+        .await
+        .expect("mock server should retain response requests")
+        .into_iter()
+        .filter(|request| request.url.path().ends_with("/responses"))
+        .collect::<Vec<_>>();
+    assert_eq!(requests.len(), 5);
+    assert_eq!(
+        requests
+            .iter()
+            .filter(|request| !request_is_subagent(request))
+            .count(),
+        3
+    );
+
+    Ok(())
+}

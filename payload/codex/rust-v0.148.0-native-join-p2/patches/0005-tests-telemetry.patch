+async fn start_pending_native_join(
+    parent_prompt: &'static str,
+    spawn_call_id: &'static str,
+    join_call_id: &'static str,
+    child_call_id: &'static str,
+    gate_id: &'static str,
+) -> Result<(MockServer, TestCodex, Arc<Mutex<Option<(String, String)>>>)> {
+    let server = start_mock_server().await;
+    let spawn_args = json!({
+        "message": "block on the test gate",
+        "task_name": "worker"
+    })
+    .to_string();
+    mount_sse_once_match(
+        &server,
+        move |request: &wiremock::Request| body_contains(request, parent_prompt),
+        sse(vec![
+            ev_response_created(&format!("{spawn_call_id}-parent-1")),
+            ev_function_call_with_namespace(
+                spawn_call_id,
+                "collaboration",
+                "spawn_agent",
+                &spawn_args,
+            ),
+            ev_completed(&format!("{spawn_call_id}-parent-1")),
+        ]),
+    )
+    .await;
+
+    let child_gate_args = json!({
+        "barrier": {
+            "id": gate_id,
+            "participants": 2,
+            "timeout_ms": 30_000
+        }
+    })
+    .to_string();
+    mount_sse_once_match(
+        &server,
+        |request: &wiremock::Request| request_has_input_type(request, "agent_message"),
+        sse(vec![
+            ev_response_created(&format!("{child_call_id}-child-1")),
+            ev_function_call(child_call_id, "test_sync_tool", &child_gate_args),
+            ev_completed(&format!("{child_call_id}-child-1")),
+        ]),
+    )
+    .await;
+
+    let spawned_run = Arc::new(Mutex::new(None::<(String, String)>));
+    let captured_spawned_run = Arc::clone(&spawned_run);
+    Mock::given(method("POST"))
+        .and(path("/v1/responses"))
+        .and(move |request: &wiremock::Request| {
+            body_contains(request, spawn_call_id)
+                && !request_has_input_type(request, "agent_message")
+                && !body_contains(request, join_call_id)
+        })
+        .respond_with(move |request: &wiremock::Request| {
+            let spawn = function_call_output_json(request, spawn_call_id)
+                .expect("Parent request should contain JSON spawn output");
+            let target = spawn["task_name"]
+                .as_str()
+                .expect("spawn output task_name")
+                .to_string();
+            let run_id = spawn["run_id"]
+                .as_str()
+                .expect("spawn output run_id")
+                .to_string();
+            *captured_spawned_run.lock().expect("spawn capture lock") =
+                Some((target.clone(), run_id.clone()));
+            let join_args = json!({ "target": target, "run_id": run_id }).to_string();
+            sse_response(sse(vec![
+                ev_response_created(&format!("{join_call_id}-parent-2")),
+                ev_function_call(join_call_id, "join_agent", &join_args),
+                ev_completed(&format!("{join_call_id}-parent-2")),
+            ]))
+        })
+        .expect(1)
+        .mount(&server)
+        .await;
+
+    let test = test_codex()
+        .with_model("test-gpt-5.1-codex")
+        .with_config(|config| {
+            config
+                .features
+                .enable(Feature::Collab)
+                .expect("test config should allow feature update");
+            config
+                .features
+                .enable(Feature::MultiAgentV2)
+                .expect("test config should allow feature update");
+        })
+        .build(&server)
+        .await?;
+    let session_model = test.session_configured.model.clone();
+    let (sandbox_policy, permission_profile) =
+        turn_permission_fields(PermissionProfile::Disabled, test.cwd.path());
+    test.codex
+        .start_or_steer_turn(user_input_request(
+            parent_prompt,
+            ThreadSettingsOverrides {
+                environments: Some(local_selections(test.config.cwd.clone())),
+                approval_policy: Some(AskForApproval::Never),
+                sandbox_policy: Some(sandbox_policy),
+                permission_profile,
+                collaboration_mode: Some(CollaborationMode {
+                    mode: ModeKind::Default,
+                    settings: Settings {
+                        model: session_model,
+                        reasoning_effort: None,
+                        developer_instructions: None,
+                    },
+                }),
+                ..Default::default()
+            },
+        ))
+        .await?;
+
+    Ok((server, test, spawned_run))
+}

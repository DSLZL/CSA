+async fn wait_for_pending_join(
+    test: &TestCodex,
+    spawned_run: &Arc<Mutex<Option<(String, String)>>>,
+    gate_id: &'static str,
+    join_call_id: &'static str,
+) {
+    timeout(
+        Duration::from_secs(5),
+        wait_for_test_sync_barrier_arrivals(gate_id, 1),
+    )
+    .await
+    .expect("child tool should reach the closed gate");
+    timeout(Duration::from_secs(5), async {
+        loop {
+            if spawned_run.lock().expect("spawn capture lock").is_some() {
+                return;
+            }
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .expect("Parent should receive spawn output and request exact join");
+    timeout(
+        Duration::from_secs(5),
+        wait_for_event(&test.codex, |event| {
+            matches!(
+                event,
+                EventMsg::ItemStarted(event)
+                    if matches!(
+                        &event.item,
+                        TurnItem::CollabAgentToolCall(item)
+                            if item.id == join_call_id
+                                && item.tool == CollabAgentTool::Join
+                                && item.status == CollabAgentToolCallStatus::InProgress
+                    )
+            )
+        }),
+    )
+    .await
+    .expect("join lifecycle should start while child is blocked");
+}
+
+async fn start_user_turn_when_idle(test: &TestCodex, prompt: &str) -> Result<()> {
+    timeout(Duration::from_secs(5), async {
+        loop {
+            let input = TurnInputRequest::user_input(vec![UserInput::Text {
+                text: prompt.to_string(),
+                text_elements: Vec::new(),
+            }]);
+            match test.codex.start_turn_if_idle(input).await? {
+                StartIfIdleSubmission::Started { .. } => return Ok(()),
+                StartIfIdleSubmission::NotSubmitted { reason } => {
+                    ensure!(
+                        matches!(
+                            reason,
+                            NotSubmittedReason::NotIdle | NotSubmittedReason::PendingTriggerTurn
+                        ),
+                        "idle turn rejected for unexpected reason: {reason:?}"
+                    );
+                    tokio::task::yield_now().await;
+                }
+            }
+        }
+    })
+    .await
+    .expect("thread should become idle after interruption")
+}

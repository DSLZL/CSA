+    const JOIN_CALL_ID: &str = "absolute-cli-join";
+    const WAIT_CALL_IDS: [&str; 3] = [
+        "absolute-cli-wait-1",
+        "absolute-cli-wait-2",
+        "absolute-cli-wait-3",
+    ];
+    const CHILD_OUTPUT: &str = "child done from patched cli";
+    const PARENT_OUTPUT: &str = "parent done from patched cli";
+
+    let mode = std::env::var("CSA_NATIVE_JOIN_MODE").unwrap_or_else(|_| "patched".to_string());
+    ensure!(
+        matches!(mode.as_str(), "patched" | "stock"),
+        "CSA_NATIVE_JOIN_MODE must be patched or stock"
+    );
+    let stock_mode = mode == "stock";
+
+    let patched = required_absolute_path("CSA_NATIVE_JOIN_PATCHED_BIN")?;
+    let official = required_absolute_path("CSA_NATIVE_JOIN_OFFICIAL_BIN")?;
+    let codex_home = required_absolute_path("CSA_NATIVE_JOIN_HOME")?;
+    let fixture = required_absolute_path("CSA_NATIVE_JOIN_FIXTURE")?;
+    let path_prefix = required_absolute_path("CSA_NATIVE_JOIN_PATH_PREFIX")?;
+    let npm_prefix = required_absolute_path("CSA_NATIVE_JOIN_NPM_PREFIX")?;
+    ensure!(
+        patched != official,
+        "patched and official executables must differ"
+    );
+    ensure!(patched.is_file(), "patched executable must be a file");
+    ensure!(official.is_file(), "official executable must be a file");
+    ensure!(codex_home.is_dir(), "isolated CODEX_HOME must exist");
+    ensure!(fixture.is_dir(), "isolated fixture must exist");
+    ensure!(path_prefix.is_dir(), "temporary PATH prefix must exist");
+    ensure!(npm_prefix.is_dir(), "temporary npm prefix must exist");
+
+    let delay_ms = std::env::var("CSA_NATIVE_JOIN_CHILD_DELAY_MS")
+        .unwrap_or_else(|_| "1000".to_string())
+        .parse::<u64>()
+        .context("parse CSA_NATIVE_JOIN_CHILD_DELAY_MS")?;
+    ensure!(delay_ms > 0, "child delay must be positive");
+
+    let server = start_mock_server().await;
+    let spawn_args = json!({
+        "message": "return after the fake provider response completes",
+        "task_name": "worker"
+    })
+    .to_string();
+    mount_sse_once_match(
+        &server,
+        |request: &wiremock::Request| {
+            body_contains(request, PROMPT) && !request_is_subagent(request)
+        },
+        sse(vec![
+            ev_response_created("absolute-cli-parent-1"),
+            ev_function_call_with_namespace(
+                SPAWN_CALL_ID,
+                "collaboration",
+                "spawn_agent",
+                &spawn_args,
+            ),
+            ev_completed("absolute-cli-parent-1"),
+        ]),
+    )
+    .await;
+    Mock::given(method("POST"))
+        .and(path("/v1/responses"))
+        .and(request_is_subagent)
+        .respond_with(
+            sse_response(sse(vec![
+                ev_response_created("absolute-cli-child-1"),
+                ev_assistant_message("absolute-cli-child-message", CHILD_OUTPUT),
+                ev_completed("absolute-cli-child-1"),
+            ]))
+            .set_delay(Duration::from_millis(delay_ms)),
+        )
+        .expect(1)
+        .mount(&server)
+        .await;
+
+    let spawned_run = Arc::new(Mutex::new(None::<(String, String)>));
+    let captured_spawned_run = Arc::clone(&spawned_run);
+    let responder_mode = mode.clone();
+    Mock::given(method("POST"))
+        .and(path("/v1/responses"))
+        .and(move |request: &wiremock::Request| {
+            body_contains(request, SPAWN_CALL_ID)
+                && !request_is_subagent(request)
+                && !body_contains(request, JOIN_CALL_ID)
+                && !body_contains(request, WAIT_CALL_IDS[0])
+        })
+        .respond_with(move |request: &wiremock::Request| {
+            let spawn = function_call_output_json(request, SPAWN_CALL_ID)
+                .expect("Parent request should contain JSON spawn output");
+            let target = spawn["task_name"]
+                .as_str()
+                .expect("spawn output task_name")
+                .to_string();
+            let run_id = spawn["run_id"]
+                .as_str()
+                .expect("spawn output run_id")
+                .to_string();
+            *captured_spawned_run.lock().expect("spawn capture lock") =
+                Some((target.clone(), run_id.clone()));
+            let tool_call = if responder_mode == "stock" {
+                ev_function_call_with_namespace(
+                    WAIT_CALL_IDS[0],
+                    "collaboration",
+                    "wait_agent",
+                    r#"{"timeout_ms":30000}"#,
+                )
+            } else {
+                ev_function_call(
+                    JOIN_CALL_ID,
+                    "join_agent",
+                    &json!({ "target": target, "run_id": run_id }).to_string(),
+                )
+            };
+            sse_response(sse(vec![
+                ev_response_created("absolute-cli-parent-2"),
+                tool_call,
+                ev_completed("absolute-cli-parent-2"),
+            ]))
+        })
+        .expect(1)
+        .mount(&server)
+        .await;
+    if stock_mode {
+        for (index, call_id) in WAIT_CALL_IDS[..2].iter().enumerate() {
+            let next_call_id = WAIT_CALL_IDS[index + 1];
+            mount_sse_once_match(
+                &server,
+                move |request: &wiremock::Request| {
+                    function_call_output_json(request, call_id).is_some()
+                        && !request_is_subagent(request)
+                },
+                sse(vec![
+                    ev_response_created(&format!("absolute-cli-parent-{}", index + 3)),
+                    ev_function_call_with_namespace(
+                        next_call_id,
+                        "collaboration",
+                        "wait_agent",
+                        r#"{"timeout_ms":30000}"#,
+                    ),
+                    ev_completed(&format!("absolute-cli-parent-{}", index + 3)),
+                ]),
+            )
+            .await;
+        }
+        mount_sse_once_match(
+            &server,
+            |request: &wiremock::Request| {
+                function_call_output_json(request, WAIT_CALL_IDS[2]).is_some()
+                    && !request_is_subagent(request)
+            },
+            sse(vec![
+                ev_response_created("absolute-cli-parent-5"),
+                ev_assistant_message("absolute-cli-parent-message", PARENT_OUTPUT),
+                ev_completed("absolute-cli-parent-5"),
+            ]),
+        )
+        .await;
+    } else {
+        mount_sse_once_match(
+            &server,
+            |request: &wiremock::Request| {
+                function_call_output_json(request, JOIN_CALL_ID).is_some()
+                    && !request_is_subagent(request)
+            },
+            sse(vec![
+                ev_response_created("absolute-cli-parent-3"),
+                ev_assistant_message("absolute-cli-parent-message", PARENT_OUTPUT),
+                ev_completed("absolute-cli-parent-3"),
+            ]),
+        )
+        .await;
+    }
+
+    let provider_override = format!(
+        "model_providers.mock={{ name = \"mock\", base_url = \"{}/v1\", env_key = \"CSA_NATIVE_JOIN_FAKE_KEY\", wire_api = \"responses\" }}",
+        server.uri()
+    );
+    let mut path_entries = vec![path_prefix.clone()];
+    path_entries.extend(std::env::split_paths(
+        &std::env::var_os("PATH").unwrap_or_default(),
+    ));
+    let child_path = std::env::join_paths(path_entries).context("build temporary child PATH")?;
+    let started_at = Instant::now();
+    let mut command = Command::new(&patched);
+    command
+        .kill_on_drop(true)
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .env("CODEX_HOME", &codex_home)
+        .env("CSA_NATIVE_JOIN_FAKE_KEY", "fake-loopback-key")
+        .env("PATH", child_path)
+        .env("npm_config_prefix", &npm_prefix)
+        .args([
+            "exec",
+            "--skip-git-repo-check",
+            "--ignore-user-config",
+            "--ignore-rules",
+            "--json",
+            "--color",
+            "never",
+            "--sandbox",
+            "danger-full-access",
+            "--model",
+            "test-gpt-5.1-codex",
+            "--enable",
+            "collab",
+            "--enable",
+            "multi_agent_v2",
+            "--disable",
+            "plugins",
+            "-c",
+            &provider_override,
+            "-c",
+            "model_provider=\"mock\"",
+            "-C",
+        ])
+        .arg(&fixture)
+        .arg(PROMPT);
+    let output = timeout(
+        Duration::from_millis(delay_ms).saturating_add(Duration::from_secs(60)),
+        command.output(),
+    )
+    .await
+    .context("patched CLI acceptance watchdog elapsed")??;
+    let elapsed = started_at.elapsed();
+    ensure!(
+        output.status.success(),
+        "patched CLI failed: stdout={} stderr={}",
+        String::from_utf8_lossy(&output.stdout),
+        String::from_utf8_lossy(&output.stderr)
+    );
+    ensure!(
+        String::from_utf8_lossy(&output.stdout).contains(PARENT_OUTPUT),
+        "patched CLI did not emit the final Parent output"
+    );
+    ensure!(
+        elapsed >= Duration::from_millis(delay_ms),
+        "Parent completed before the child delay elapsed"
+    );
+
+    server.verify().await;
+    let requests = server
+        .received_requests()
+        .await
+        .context("mock server should retain response requests")?
+        .into_iter()
+        .filter(|request| request.url.path().ends_with("/responses"))
+        .collect::<Vec<_>>();
+    let parent_request_count = requests
+        .iter()
+        .filter(|request| !request_is_subagent(request))
+        .count();
+    let child_request_count = requests
+        .iter()
+        .filter(|request| request_is_subagent(request))
+        .count();
+    let join_call_count = requests
+        .iter()
+        .filter(|request| request_has_function_call(request, "join_agent"))
+        .count();
+    let wait_call_count = requests
+        .iter()
+        .filter(|request| request_has_function_call(request, "wait_agent"))
+        .count();
+    let join_results = requests
+        .iter()
+        .filter_map(|request| function_call_output_json(request, JOIN_CALL_ID))
+        .collect::<Vec<_>>();
+    let wait_results = WAIT_CALL_IDS
+        .iter()
+        .filter_map(|call_id| {
+            requests
+                .iter()
+                .find_map(|request| function_call_output_json(request, call_id))
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(requests.len(), if stock_mode { 6 } else { 4 });
+    assert_eq!(parent_request_count, if stock_mode { 5 } else { 3 });
+    assert_eq!(child_request_count, 1);
+    assert_eq!(join_call_count, usize::from(!stock_mode));
+    assert_eq!(wait_call_count, if stock_mode { 3 } else { 0 });
+    assert_eq!(join_results.len(), usize::from(!stock_mode));
+    assert_eq!(wait_results.len(), if stock_mode { 3 } else { 0 });
+
+    let (target, run_id) = spawned_run
+        .lock()
+        .expect("spawn capture lock")
+        .clone()
+        .expect("spawned run should be captured");
+    if stock_mode {
+        assert_eq!(wait_results[0]["timed_out"], json!(true));
+        assert_eq!(wait_results[1]["timed_out"], json!(true));
+        assert_eq!(wait_results[2]["timed_out"], json!(false));
+    } else {
+        let join_result = &join_results[0];
+        assert_eq!(join_result["target"], json!(target));
+        assert_eq!(join_result["run_id"], json!(run_id));
+        assert_eq!(join_result["status"], json!("completed"));
+        assert_eq!(join_result["output"], json!(CHILD_OUTPUT));
+        assert_eq!(join_result["error"], serde_json::Value::Null);
+        assert_eq!(join_result["reason"], serde_json::Value::Null);
+    }
+
+    let requests_during_wait = parent_request_count.saturating_sub(3);
+    let tool_results = if stock_mode {
+        wait_results.len()
+    } else {
+        join_results.len()
+    };
+
+    println!(
+        "{}",
+        json!({
+            "mode": mode,
+            "patched_executable": patched,
+            "official_executable": official,
+            "codex_home": codex_home,
+            "cwd": fixture,
+            "path_prefix": path_prefix,
+            "npm_prefix": npm_prefix,
+            "child_duration_ms": delay_ms,
+            "elapsed_ms": elapsed.as_millis(),
+            "parent_requests_during_wait": requests_during_wait,
+            "join_agent_calls": join_call_count,
+            "wait_agent_calls": wait_call_count,
+            "tool_results": tool_results,
+            "resume_requests_after_terminal": 1,
+            "status": "completed",
+        })
+    );
+
+    Ok(())
+}

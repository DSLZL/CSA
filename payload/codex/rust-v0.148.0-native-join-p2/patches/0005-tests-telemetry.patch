+pub(crate) async fn wait_for_barrier_arrivals_for_tests(id: &str, arrivals: usize) {
+    loop {
+        if barrier_map()
+            .lock()
+            .await
+            .get(id)
+            .is_some_and(|state| state.arrivals >= arrivals)
+        {
+            return;
+        }
+        tokio::task::yield_now().await;
+    }
+}

+    config
+        .features
+        .enable(Feature::MultiAgentV2)
+        .expect("test config should allow feature update");
+    set_turn_config(&mut turn, config);
+    let mut session = Arc::new(session);
+    let mut turn = Arc::new(turn);
+
+    let extra_field_error = JoinAgentHandler
+        .handle(invocation(
+            session.clone(),
+            turn.clone(),
+            "join_agent",
+            function_payload(json!({
+                "target": "/root",
+                "run_id": "run",
+                "extra": true
+            })),
+        ))
+        .await
+        .err()
+        .expect("join_agent should reject extra fields");
+    assert!(matches!(
+        extra_field_error,
+        FunctionCallError::RespondToModel(message) if message.contains("unknown field `extra`")
+    ));
+
+    let empty_run_error = JoinAgentHandler
+        .handle(invocation(
+            session.clone(),
+            turn.clone(),
+            "join_agent",
+            function_payload(json!({"target": "/root", "run_id": "   "})),
+        ))
+        .await
+        .err()
+        .expect("join_agent should reject an empty run id");
+    assert_eq!(
+        empty_run_error,
+        FunctionCallError::RespondToModel(
+            "run_id must be the non-empty opaque value returned by spawn_agent".to_string()
+        )
+    );
+
+    let missing_target_error = JoinAgentHandler
+        .handle(invocation(
+            session.clone(),
+            turn.clone(),
+            "join_agent",
+            function_payload(json!({"target": "missing", "run_id": "run"})),
+        ))
+        .await
+        .err()
+        .expect("join_agent should reject an unknown target");
+    assert!(matches!(
+        missing_target_error,
+        FunctionCallError::RespondToModel(message) if message.contains("missing")
+    ));
+
+    let root_error = JoinAgentHandler
+        .handle(invocation(
+            session.clone(),
+            turn.clone(),
+            "join_agent",
+            function_payload(json!({"target": "/root", "run_id": "run"})),
+        ))
+        .await

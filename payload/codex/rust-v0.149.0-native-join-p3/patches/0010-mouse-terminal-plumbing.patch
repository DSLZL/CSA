+use super::*;
+use codex_terminal_detection::Multiplexer;
+use crossterm::Command;
+
+fn terminal(name: TerminalName, multiplexer: Option<Multiplexer>) -> TerminalInfo {
+    TerminalInfo {
+        name,
+        term_program: None,
+        version: None,
+        term: None,
+        multiplexer,
+    }
+}
+
+#[test]
+fn capture_policy_is_fail_closed_and_raw_mode_always_wins() {
+    let known = terminal(TerminalName::WindowsTerminal, None);
+    let unknown = terminal(TerminalName::Unknown, None);
+
+    assert!(!should_capture(
+        SubagentLiveMouseMode::Off,
+        &known,
+        /*alt_screen_active*/ true,
+        /*panel_renderable*/ true,
+        /*raw_output_mode*/ false,
+    ));
+    assert!(should_capture(
+        SubagentLiveMouseMode::On,
+        &unknown,
+        /*alt_screen_active*/ false,
+        /*panel_renderable*/ false,
+        /*raw_output_mode*/ false,
+    ));
+    assert!(!should_capture(
+        SubagentLiveMouseMode::On,
+        &known,
+        /*alt_screen_active*/ true,
+        /*panel_renderable*/ true,
+        /*raw_output_mode*/ true,
+    ));
+    assert!(should_capture(
+        SubagentLiveMouseMode::Auto,
+        &known,
+        /*alt_screen_active*/ true,
+        /*panel_renderable*/ true,
+        /*raw_output_mode*/ false,
+    ));
+    assert!(!should_capture(
+        SubagentLiveMouseMode::Auto,
+        &unknown,
+        /*alt_screen_active*/ true,
+        /*panel_renderable*/ true,
+        /*raw_output_mode*/ false,
+    ));
+    assert!(!should_capture(
+        SubagentLiveMouseMode::Auto,
+        &known,
+        /*alt_screen_active*/ false,
+        /*panel_renderable*/ true,
+        /*raw_output_mode*/ false,
+    ));
+    assert!(!should_capture(
+        SubagentLiveMouseMode::Auto,
+        &known,
+        /*alt_screen_active*/ true,
+        /*panel_renderable*/ false,
+        /*raw_output_mode*/ false,
+    ));
+}
+
+#[test]
+fn known_multiplexers_are_positive_auto_capabilities() {
+    let tmux = terminal(
+        TerminalName::Unknown,
+        Some(Multiplexer::Tmux { version: None }),
+    );
+    let zellij = terminal(
+        TerminalName::Unknown,
+        Some(Multiplexer::Zellij { version: None }),
+    );
+
+    assert!(auto_supported(&tmux));
+    assert!(auto_supported(&zellij));
+}
+
+#[test]
+fn transition_guard_emits_enable_and_disable_and_tracks_safe_state() {
+    let capture = MouseCapture::default();
+    let mut output = Vec::new();
+
+    capture
+        .set_with_writer(&mut output, /*enabled*/ true)
+        .expect("enable capture");
+    assert!(capture.active());
+    capture
+        .force_off_with_writer(&mut output)
+        .expect("force capture off");
+    assert!(!capture.active());
+    capture
+        .set_with_writer(&mut output, /*enabled*/ true)
+        .expect("re-enable capture");
+    capture
+        .set_with_writer(&mut output, /*enabled*/ false)
+        .expect("disable capture");
+
+    assert!(!capture.active());
+    let mut ansi = String::new();
+    EnableMouseCapture
+        .write_ansi(&mut ansi)
+        .expect("enable ANSI");
+    DisableMouseCapture
+        .write_ansi(&mut ansi)
+        .expect("disable ANSI");
+    assert_eq!(
+        ansi,
+        "\u{1b}[?1000h\u{1b}[?1002h\u{1b}[?1003h\u{1b}[?1015h\u{1b}[?1006h\u{1b}[?1006l\u{1b}[?1015l\u{1b}[?1003l\u{1b}[?1002l\u{1b}[?1000l"
+    );
+}
+
+#[test]
+fn failed_transitions_remain_fail_closed() {
+    let capture = MouseCapture::default();
+    assert!(
+        capture
+            .finish_transition(
+                /*enabled*/ true,
+                Err(std::io::Error::other("test enable failure")),
+            )
+            .is_err()
+    );
+    assert!(!capture.active());
+
+    capture
+        .finish_transition(/*enabled*/ true, Ok(()))
+        .expect("enable state");
+    assert!(
+        capture
+            .finish_transition(
+                /*enabled*/ false,
+                Err(std::io::Error::other("test disable failure")),
+            )
+            .is_err()
+    );
+    assert!(!capture.active());
+}

diff --git a/codex-rs/tui/src/csa_graphics.rs b/codex-rs/tui/src/csa_graphics.rs
new file mode 100644
index 0000000..e0f8df1
--- /dev/null
+++ b/codex-rs/tui/src/csa_graphics.rs
@@ -0,0 +1,407 @@
+//! Terminal graphics pass for CSA's one-cell sub-agent Orbit.
+
+use std::collections::HashMap;
+use std::io;
+use std::io::Write;
+use std::time::Instant;
+
+use codex_protocol::ThreadId;
+use crossterm::cursor::MoveTo;
+use crossterm::cursor::RestorePosition;
+use crossterm::cursor::SavePosition;
+use crossterm::queue;
+use ratatui::backend::Backend;
+use ratatui::layout::Size;
+
+use crate::csa_orbit::CsaOrbitFrame;
+use crate::csa_orbit::CsaOrbitFrameIndex;
+use crate::csa_orbit::csa_orbit_frame_cache;
+use crate::csa_orbit::rasterize_csa_orbit;
+use crate::pets::image_protocol::ImageProtocol;
+
+const CSA_KITTY_IMAGE_ID_START: u32 = 0x4353_4100;
+const CSA_KITTY_FALLBACK_RASTER_SIZE: u16 = 12;
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) struct CsaOrbitPlacement {
+    pub(crate) thread_id: ThreadId,
+    pub(crate) x: u16,
+    pub(crate) y: u16,
+    pub(crate) animation_started_at: Instant,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+struct CsaGraphicsKey {
+    protocol: ImageProtocol,
+    width: u16,
+    height: u16,
+    foreground: (u8, u8, u8),
+    background: (u8, u8, u8),
+}
+
+#[derive(Debug)]
+enum CsaEncodedFrame {
+    Kitty(String),
+    Sixel(Vec<u8>),
+}
+
+#[derive(Debug)]
+struct CsaEncodedFrameCache {
+    key: CsaGraphicsKey,
+    warmup: Vec<CsaEncodedFrame>,
+    steady: Vec<CsaEncodedFrame>,
+}
+
+impl CsaEncodedFrameCache {
+    fn new(key: CsaGraphicsKey) -> io::Result<Self> {
+        let source = csa_orbit_frame_cache();
+        Ok(Self {
+            key,
+            warmup: source
+                .warmup()
+                .iter()
+                .map(|frame| encode_csa_frame(key, frame))
+                .collect::<io::Result<_>>()?,
+            steady: source
+                .steady()
+                .iter()
+                .map(|frame| encode_csa_frame(key, frame))
+                .collect::<io::Result<_>>()?,
+        })
+    }
+
+    fn frame_at(&self, started_at: Instant, now: Instant) -> &CsaEncodedFrame {
+        match csa_orbit_frame_cache().frame_index_at(started_at, now) {
+            CsaOrbitFrameIndex::Warmup(index) => &self.warmup[index],
+            CsaOrbitFrameIndex::Steady(index) => &self.steady[index],
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+struct CsaActivePlacement {
+    protocol: ImageProtocol,
+    image_id: u32,
+    x: u16,
+    y: u16,
+}
+
+#[derive(Debug)]
+pub(crate) struct CsaGraphicsState {
+    protocol: Option<ImageProtocol>,
+    disabled: bool,
+    screen_size: Option<Size>,
+    cell_pixels: Option<(u16, u16)>,
+    cache: Option<CsaEncodedFrameCache>,
+    image_ids: HashMap<ThreadId, u32>,
+    next_image_id: u32,
+    active: Vec<CsaActivePlacement>,
+}
+
+impl Default for CsaGraphicsState {
+    fn default() -> Self {
+        let protocol = match crate::pets::image_protocol::detect_pet_image_support().protocol() {
+            Some(ImageProtocol::Kitty) => Some(ImageProtocol::Kitty),
+            Some(ImageProtocol::Sixel) => Some(ImageProtocol::Sixel),
+            Some(ImageProtocol::KittyLocalFile) | None => None,
+        };
+        Self {
+            protocol,
+            disabled: false,
+            screen_size: None,
+            cell_pixels: None,
+            cache: None,
+            image_ids: HashMap::new(),
+            next_image_id: CSA_KITTY_IMAGE_ID_START,
+            active: Vec::new(),
+        }
+    }
+}
+
+impl CsaGraphicsState {
+    pub(crate) fn prepare<B>(&mut self, backend: &mut B, screen_size: Size) -> io::Result<bool>
+    where
+        B: Backend<Error = io::Error>,
+    {
+        if self.disabled {
+            return Ok(false);
+        }
+        let Some(protocol) = self.protocol else {
+            return Ok(false);
+        };
+        let Some(foreground) = crate::terminal_palette::default_fg() else {
+            return Ok(false);
+        };
+        let Some(background) = crate::terminal_palette::default_bg() else {
+            return Ok(false);
+        };
+
+        if self.screen_size != Some(screen_size) {
+            self.screen_size = Some(screen_size);
+            self.cell_pixels = cell_pixels(backend, protocol);
+            self.cache = None;
+        }
+        let Some((width, height)) = self.cell_pixels else {
+            return Ok(false);
+        };
+        let key = CsaGraphicsKey {
+            protocol,
+            width,
+            height,
+            foreground,
+            background,
+        };
+        if self.cache.as_ref().is_none_or(|cache| cache.key != key) {
+            self.cache = Some(CsaEncodedFrameCache::new(key)?);
+        }
+        Ok(true)
+    }
+
+    pub(crate) fn clear(&mut self, writer: &mut impl Write) -> io::Result<()> {
+        if self.active.is_empty() {
+            return Ok(());
+        }
+
+        let needs_cursor = self
+            .active
+            .iter()
+            .any(|placement| placement.protocol == ImageProtocol::Sixel);
+        if needs_cursor {
+            queue!(writer, SavePosition)?;
+        }
+        for placement in &self.active {
+            match placement.protocol {
+                ImageProtocol::Kitty => writer.write_all(
+                    crate::pets::image_protocol::kitty_delete_image(placement.image_id).as_bytes(),
+                )?,
+                ImageProtocol::Sixel => {
+                    queue!(writer, MoveTo(placement.x, placement.y))?;
+                    writer.write_all(b" ")?;
+                }
+                ImageProtocol::KittyLocalFile => {}
+            }
+        }
+        if needs_cursor {
+            queue!(writer, RestorePosition)?;
+        }
+        self.active.clear();
+        writer.flush()
+    }
+
+    pub(crate) fn draw(
+        &mut self,
+        writer: &mut impl Write,
+        placements: &[CsaOrbitPlacement],
+        now: Instant,
+    ) -> io::Result<()> {
+        let Some(cache) = self.cache.as_ref() else {
+            return Ok(());
+        };
+        if placements.is_empty() {
+            return Ok(());
+        }
+
+        queue!(writer, SavePosition)?;
+        let image_ids = &mut self.image_ids;
+        let next_image_id = &mut self.next_image_id;
+        let active = &mut self.active;
+        for placement in placements {
+            let image_id = match image_ids.get(&placement.thread_id).copied() {
+                Some(image_id) => image_id,
+                None => {
+                    let image_id = *next_image_id;
+                    *next_image_id = next_image_id
+                        .checked_add(1)
+                        .ok_or_else(|| io::Error::other("CSA Kitty image IDs exhausted"))?;
+                    image_ids.insert(placement.thread_id, image_id);
+                    image_id
+                }
+            };
+            queue!(writer, MoveTo(placement.x, placement.y))?;
+            match cache.frame_at(placement.animation_started_at, now) {
+                CsaEncodedFrame::Kitty(payload) => writer.write_all(
+                    crate::pets::image_protocol::kitty_transmit_csa_rgba_with_id(
+                        payload,
+                        cache.key.width,
+                        cache.key.height,
+                        image_id,
+                    )
+                    .as_bytes(),
+                )?,
+                CsaEncodedFrame::Sixel(payload) => writer.write_all(payload)?,
+            }
+            active.push(CsaActivePlacement {
+                protocol: cache.key.protocol,
+                image_id,
+                x: placement.x,
+                y: placement.y,
+            });
+        }
+        queue!(writer, RestorePosition)?;
+        writer.flush()
+    }
+
+    pub(crate) fn disable(&mut self) {
+        self.disabled = true;
+        self.cache = None;
+    }
+
+    #[cfg(test)]
+    fn prepared_for_test(key: CsaGraphicsKey) -> Self {
+        Self {
+            protocol: Some(key.protocol),
+            disabled: false,
+            screen_size: Some(Size::new(80, 24)),
+            cell_pixels: Some((key.width, key.height)),
+            cache: Some(CsaEncodedFrameCache::new(key).unwrap()),
+            image_ids: HashMap::new(),
+            next_image_id: CSA_KITTY_IMAGE_ID_START,
+            active: Vec::new(),
+        }
+    }
+}
+
+fn cell_pixels<B>(backend: &mut B, protocol: ImageProtocol) -> Option<(u16, u16)>
+where
+    B: Backend<Error = io::Error>,
+{
+    let measured = backend.window_size().ok().and_then(|window| {
+        let columns = window.columns_rows.width;
+        let rows = window.columns_rows.height;
+        (columns > 0 && rows > 0 && window.pixels.width > 0 && window.pixels.height > 0).then(
+            || {
+                (
+                    (window.pixels.width / columns).max(1),
+                    (window.pixels.height / rows).max(1),
+                )
+            },
+        )
+    });
+    let windows_console = windows_console_cell_pixels();
+    match protocol {
+        ImageProtocol::Kitty => measured.or(Some((
+            CSA_KITTY_FALLBACK_RASTER_SIZE,
+            CSA_KITTY_FALLBACK_RASTER_SIZE,
+        ))),
+        ImageProtocol::Sixel => measured.or(windows_console),
+        ImageProtocol::KittyLocalFile => None,
+    }
+}
+
+#[cfg(windows)]
+fn windows_console_cell_pixels() -> Option<(u16, u16)> {
+    use windows_sys::Win32::Foundation::INVALID_HANDLE_VALUE;
+    use windows_sys::Win32::System::Console::CONSOLE_FONT_INFOEX;
+    use windows_sys::Win32::System::Console::GetCurrentConsoleFontEx;
+    use windows_sys::Win32::System::Console::GetStdHandle;
+    use windows_sys::Win32::System::Console::STD_OUTPUT_HANDLE;
+
+    let output = unsafe { GetStdHandle(STD_OUTPUT_HANDLE) };
+    if output == 0 || output == INVALID_HANDLE_VALUE {
+        return None;
+    }
+    let mut info = unsafe { std::mem::zeroed::<CONSOLE_FONT_INFOEX>() };
+    info.cbSize = std::mem::size_of::<CONSOLE_FONT_INFOEX>() as u32;
+    if unsafe { GetCurrentConsoleFontEx(output, 0, &mut info) } == 0 {
+        return None;
+    }
+    Some((
+        u16::try_from(info.dwFontSize.X)
+            .ok()
+            .filter(|value| *value > 0)?,
+        u16::try_from(info.dwFontSize.Y)
+            .ok()
+            .filter(|value| *value > 0)?,
+    ))
+}
+
+#[cfg(not(windows))]
+fn windows_console_cell_pixels() -> Option<(u16, u16)> {
+    None
+}
+
+fn encode_csa_frame(key: CsaGraphicsKey, frame: &CsaOrbitFrame) -> io::Result<CsaEncodedFrame> {
+    let raster = rasterize_csa_orbit(
+        frame.intensities,
+        key.width,
+        key.height,
+        key.foreground,
+        key.background,
+    );
+    match key.protocol {
+        ImageProtocol::Kitty => Ok(CsaEncodedFrame::Kitty(
+            crate::pets::image_protocol::kitty_encode_csa_rgba(&raster.rgba),
+        )),
+        ImageProtocol::Sixel => crate::pets::sixel::encode_rgba(
+            &raster.rgba,
+            u32::from(raster.width),
+            u32::from(raster.height),
+        )
+        .map(CsaEncodedFrame::Sixel)
+        .map_err(io::Error::other),
+        ImageProtocol::KittyLocalFile => Err(io::Error::other(
+            "CSA Orbit does not support Kitty local-file graphics",
+        )),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn test_key(protocol: ImageProtocol) -> CsaGraphicsKey {
+        CsaGraphicsKey {
+            protocol,
+            width: 12,
+            height: 12,
+            foreground: (255, 255, 255),
+            background: (0, 0, 0),
+        }
+    }
+
+    #[test]
+    fn shared_cache_draws_and_clears_multiple_agents() {
+        let mut state = CsaGraphicsState::prepared_for_test(test_key(ImageProtocol::Kitty));
+        let started_at = Instant::now();
+        let placements = [
+            CsaOrbitPlacement {
+                thread_id: ThreadId::new(),
+                x: 0,
+                y: 1,
+                animation_started_at: started_at,
+            },
+            CsaOrbitPlacement {
+                thread_id: ThreadId::new(),
+                x: 0,
+                y: 3,
+                animation_started_at: started_at - std::time::Duration::from_millis(110),
+            },
+            CsaOrbitPlacement {
+                thread_id: ThreadId::new(),
+                x: 0,
+                y: 5,
+                animation_started_at: started_at - std::time::Duration::from_millis(220),
+            },
+        ];
+        let mut output = Vec::new();
+
+        state.draw(&mut output, &placements, started_at).unwrap();
+        assert_eq!(state.active.len(), 3);
+        assert_eq!(state.image_ids.len(), 3);
+        assert_eq!(state.cache.as_ref().unwrap().warmup.len(), 20);
+        assert_eq!(state.cache.as_ref().unwrap().steady.len(), 24);
+
+        state.clear(&mut output).unwrap();
+        assert!(state.active.is_empty());
+        let output = String::from_utf8(output).unwrap();
+        assert_eq!(output.matches("a=d,d=I").count(), 3);
+    }
+
+    #[test]
+    fn sixel_cache_encodes_the_same_shared_samples() {
+        let cache = CsaEncodedFrameCache::new(test_key(ImageProtocol::Sixel)).unwrap();
+        assert_eq!(cache.warmup.len(), csa_orbit_frame_cache().warmup().len());
+        assert_eq!(cache.steady.len(), csa_orbit_frame_cache().steady().len());
+        assert!(matches!(cache.steady[0], CsaEncodedFrame::Sixel(_)));
+    }
+}

+#[test]
+fn work_activity_redacts_payloads_and_truncates_unicode_by_grapheme() {
+    let secret = "DO-NOT-RETAIN";
+    let items = [
+        command_item(CommandExecutionStatus::Completed, Some(secret)),
+        file_change_item(PatchApplyStatus::Completed, secret),
+        mcp_item(McpToolCallStatus::Completed, secret),
+        dynamic_tool_item(DynamicToolCallStatus::Completed, secret),
+        web_search_item(),
+        image_generation_item("completed"),
+    ];
+    let labels = items
+        .iter()
+        .map(|item| {
+            work_activity(item, ActivityPhase::Completed)
+                .expect("work activity")
+                .label
+        })
+        .collect::<Vec<_>>()
+        .join("\n");
+    assert!(!labels.contains(secret));
+    assert!(!labels.contains("raw-web-result"));
+    assert!(!labels.contains("raw-image-prompt"));
+    assert!(!labels.contains("raw-image-result"));
+
+    let mut unicode_command = command_item(CommandExecutionStatus::InProgress, None);
+    let ThreadItem::CommandExecution { command, .. } = &mut unicode_command else {
+        unreachable!()
+    };
+    *command = "🧪e\u{301}测试".repeat(100);
+    let label = work_activity(&unicode_command, ActivityPhase::Started)
+        .expect("unicode command activity")
+        .label;
+    assert!(label.graphemes(true).count() <= AGENT_STATUS_PREVIEW_GRAPHEMES);
+    assert!(label.starts_with("$ 🧪e\u{301}测试"));
+    assert!(label.ends_with("..."));
+}

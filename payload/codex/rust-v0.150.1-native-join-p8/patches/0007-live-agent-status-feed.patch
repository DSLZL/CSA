+fn work_summary(
+    item: &ThreadItem,
+    kind: WorkActivityKind,
+    status: ActivityStatus,
+    label: &str,
+) -> Option<ActivitySummary> {
+    Some(ActivitySummary::Work(WorkActivityInput {
+        id: item.id().to_string(),
+        kind,
+        label: bounded_summary(label)?,
+        status,
+    }))
+}
+
+fn other_summary(label: &str) -> Option<ActivitySummary> {
+    bounded_summary(label).map(ActivitySummary::Other)
+}
+
+fn phase_status(phase: ActivityPhase) -> ActivityStatus {
+    match phase {
+        ActivityPhase::Started => ActivityStatus::Running,
+        ActivityPhase::Completed => ActivityStatus::Succeeded,
+    }
+}
+
+fn command_status(status: &CommandExecutionStatus) -> ActivityStatus {
+    match status {
+        CommandExecutionStatus::InProgress => ActivityStatus::Running,
+        CommandExecutionStatus::Completed => ActivityStatus::Succeeded,
+        CommandExecutionStatus::Failed => ActivityStatus::Failed,
+        CommandExecutionStatus::Declined => ActivityStatus::Declined,
+    }
+}
+
+fn file_change_status(status: &PatchApplyStatus) -> ActivityStatus {
+    match status {
+        PatchApplyStatus::InProgress => ActivityStatus::Running,
+        PatchApplyStatus::Completed => ActivityStatus::Succeeded,
+        PatchApplyStatus::Failed => ActivityStatus::Failed,
+        PatchApplyStatus::Declined => ActivityStatus::Declined,
+    }
+}
+
+fn mcp_status(status: &McpToolCallStatus) -> ActivityStatus {
+    match status {
+        McpToolCallStatus::InProgress => ActivityStatus::Running,
+        McpToolCallStatus::Completed => ActivityStatus::Succeeded,
+        McpToolCallStatus::Failed => ActivityStatus::Failed,
+    }
+}
+
+fn dynamic_tool_status(status: &DynamicToolCallStatus) -> ActivityStatus {
+    match status {
+        DynamicToolCallStatus::InProgress => ActivityStatus::Running,
+        DynamicToolCallStatus::Completed => ActivityStatus::Succeeded,
+        DynamicToolCallStatus::Failed => ActivityStatus::Failed,
+    }
+}
+
+fn image_generation_status(status: &str, phase: ActivityPhase) -> ActivityStatus {
+    match status {
+        "completed" => ActivityStatus::Succeeded,
+        "failed" | "error" => ActivityStatus::Failed,
+        "in_progress" | "" => phase_status(phase),
+        _ => phase_status(phase),
+    }
 }
 

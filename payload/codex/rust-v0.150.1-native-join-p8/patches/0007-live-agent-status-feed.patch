+#[test]
+fn work_activity_classifies_every_included_family_with_stable_identity() {
+    let pairs = vec![
+        (
+            command_item(CommandExecutionStatus::InProgress, None),
+            command_item(CommandExecutionStatus::Completed, Some("ignored output")),
+            WorkActivityKind::Command,
+        ),
+        (
+            file_change_item(PatchApplyStatus::InProgress, "start diff"),
+            file_change_item(PatchApplyStatus::Completed, "completed diff"),
+            WorkActivityKind::FileChange,
+        ),
+        (
+            mcp_item(McpToolCallStatus::InProgress, "start secret"),
+            mcp_item(McpToolCallStatus::Completed, "completed secret"),
+            WorkActivityKind::McpTool,
+        ),
+        (
+            dynamic_tool_item(DynamicToolCallStatus::InProgress, "start secret"),
+            dynamic_tool_item(DynamicToolCallStatus::Completed, "completed secret"),
+            WorkActivityKind::DynamicTool,
+        ),
+        (
+            web_search_item(),
+            web_search_item(),
+            WorkActivityKind::WebSearch,
+        ),
+        (
+            image_view_item(),
+            image_view_item(),
+            WorkActivityKind::ImageView,
+        ),
+        (
+            image_generation_item("in_progress"),
+            image_generation_item("completed"),
+            WorkActivityKind::ImageGeneration,
+        ),
+    ];
+
+    for (started_item, completed_item, kind) in pairs {
+        let started =
+            work_activity(&started_item, ActivityPhase::Started).expect("included start activity");
+        let completed = work_activity(&completed_item, ActivityPhase::Completed)
+            .expect("included completed activity");
+        assert_eq!(started.id, completed.id);
+        assert_eq!(started.id, started_item.id());
+        assert_eq!(started.kind, kind);
+        assert_eq!(completed.kind, kind);
+        assert_eq!(started.label, completed.label);
+        assert_eq!(started.status, ActivityStatus::Running);
+        assert_eq!(completed.status, ActivityStatus::Succeeded);
+    }
+}

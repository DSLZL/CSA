+        let overlay_bin_dir = canonical_absolute_path(exe_path)?.parent()?;
+        if overlay_bin_dir.file_name() != Some(OsStr::new(BIN_DIRNAME)) {
+            return None;
+        }
+        let overlay_root = overlay_bin_dir.parent()?;
+        let official_root = canonical_absolute_path(official_package_root)?;
+        let official = Self::from_package_bin_dir(official_root.join(BIN_DIRNAME))?;
+        Some(Self {
+            package_dir: official.package_dir,
+            bin_dir: overlay_bin_dir,
+            resources_dir: existing_dir(overlay_root.join(RESOURCES_DIRNAME))
+                .or(official.resources_dir),
+            path_dir: existing_dir(overlay_root.join(PATH_DIRNAME)).or(official.path_dir),
+        })
+    }

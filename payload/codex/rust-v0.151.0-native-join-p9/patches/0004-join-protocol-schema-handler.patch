+pub fn create_join_agent_tool_v2() -> ToolSpec {
+    let properties = BTreeMap::from([
+        (
+            "target".to_string(),
+            JsonSchema::string(Some(
+                "Relative or canonical task name, or native child thread id.".to_string(),
+            )),
+        ),
+        (
+            "run_id".to_string(),
+            JsonSchema::string(Some(
+                "Opaque exact run id returned by spawn_agent. Pass it unchanged.".to_string(),
+            )),
+        ),
+    ]);
+
+    ToolSpec::Function(ResponsesApiTool {
+        name: "join_agent".to_string(),
+        description: "Wait for the exact native subagent run identified by target and the opaque run_id returned by spawn_agent. The runtime keeps this single call pending until that run completes, fails, or is cancelled. Do not repeatedly call wait_agent or query status while this call is pending."
+            .to_string(),
+        strict: false,
+        defer_loading: None,
+        parameters: JsonSchema::object(
+            properties,
+            Some(vec!["target".to_string(), "run_id".to_string()]),
+            Some(false.into()),
+        ),
+        output_schema: Some(join_agent_output_schema()),
+    })
+}

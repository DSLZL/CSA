+    #[test]
+    fn spawn_start_then_turn_start_transitions_without_resetting_orbit() {
+        let thread_id = ThreadId::new();
+        let spawned_at = Instant::now();
+        let turn_started_at = spawned_at + Duration::from_secs(1);
+        let mut state = SubagentLiveState::default();
+
+        assert_eq!(
+            state.ensure_started(thread_id, spawned_at),
+            LiveStateChange::Changed
+        );
+        let duplicate_events = state.telemetry().duplicate_events;
+        assert_eq!(
+            state.start_turn(thread_id, turn_started_at),
+            LiveStateChange::Changed
+        );
+
+        let agent = state.agent(thread_id).unwrap();
+        assert_eq!(agent.lifecycle, LiveAgentStatus::Running);
+        assert_eq!(agent.animation_started_at, spawned_at);
+        assert_eq!(agent.turn_started_at, Some(turn_started_at));
+        assert!(agent.recent.is_empty());
+        assert_eq!(state.telemetry().duplicate_events, duplicate_events);
+    }

+    let hours = tenths / 36_000;
+    let minutes = (tenths / 600) % 60;
+    let seconds = (tenths / 10) % 60;
+    let decimal = tenths % 10;
+    if hours > 0 {
+        format!("{hours}h {minutes}m {seconds}.{decimal}s")
+    } else if minutes > 0 {

+        ● emoji-agent  running · ✓ cargo test --features 你好-👩‍💻-é  succeeded
+        ");
+        assert_eq!(rendered.frame.mode(), Some(LivePanelMode::Compact));
+        assert!(
+            rendered.buffer.content.iter().all(|cell| {
+                matches!(cell.style().fg, None | Some(ratatui::style::Color::Reset))
+            }),
+            "NO_COLOR rendering must not rely on foreground color"
+        );
+
+        let mut long = Fixture::new();

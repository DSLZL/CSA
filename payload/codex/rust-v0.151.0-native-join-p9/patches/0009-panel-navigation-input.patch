+    #[test]
+    fn strict_budget_modes_and_zero_safe_rows_follow_the_formula() {
+        let mut fixture = Fixture::new();
+        let id = fixture.add_agent("Budget", LiveAgentStatus::Running);
+        for (index, label) in ["one", "two", "three"].into_iter().enumerate() {
+            fixture.add_activity(id, &index.to_string(), label, ActivityStatus::Running);
+        }
+
+        let full = fixture.render(Size::new(120, 40), 4, false);
+        let compact = fixture.render(Size::new(120, 15), 4, false);
+        let minimal = fixture.render(Size::new(60, 40), 4, false);
+        let hidden = fixture.render(Size::new(120, 10), 2, false);
+
+        assert_eq!(
+            (full.frame.mode(), full.desired_height),
+            (Some(LivePanelMode::Full), 4)
+        );
+        assert_eq!(
+            (compact.frame.mode(), compact.desired_height),
+            (Some(LivePanelMode::Compact), 1)
+        );
+        assert_eq!(
+            (minimal.frame.mode(), minimal.desired_height),
+            (Some(LivePanelMode::Minimal), 1)
+        );
+        assert_eq!(hidden.desired_height, 0);
+        assert_eq!(hidden.frame.panel_rect(), None);
+    }

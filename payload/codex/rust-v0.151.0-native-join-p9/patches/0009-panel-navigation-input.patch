+    #[test]
+    fn frame_revisions_reject_stale_hits_and_resize_clears_geometry() {
+        let mut fixture = Fixture::new();
+        let id = fixture.add_agent("Clickable", LiveAgentStatus::Running);
+        fixture.add_activity(id, "work", "cargo test", ActivityStatus::Running);
+        let frame = RefCell::new(LivePanelFrame::default());
+
+        fixture.render_with_frame(Size::new(120, 40), 4, false, &frame);
+        let first_revision = frame.borrow().render_revision();
+        assert_eq!(frame.borrow().hit_test(4, 1, first_revision), Some(id));
+        assert_eq!(frame.borrow().state_revision(), fixture.state.revision());
+
+        fixture.render_with_frame(Size::new(120, 40), 4, false, &frame);
+        let second_revision = frame.borrow().render_revision();
+        assert!(second_revision > first_revision);
+        assert_eq!(frame.borrow().hit_test(4, 1, first_revision), None);
+        assert_eq!(frame.borrow().hit_test(4, 1, second_revision), Some(id));
+
+        frame.borrow_mut().prepare_resize(Size::new(80, 24));
+        assert_eq!(frame.borrow().panel_rect(), None);
+        assert_eq!(frame.borrow().hit_test(4, 1, second_revision), None);
+
+        fixture.render_with_frame(Size::new(80, 24), 4, false, &frame);
+        assert_eq!(frame.borrow().mode(), Some(LivePanelMode::Compact));
+        assert_eq!(frame.borrow().panel_rect(), Some(Rect::new(0, 0, 80, 1)));
+    }

+    #[test]
+    fn multi_agent_snapshots_cover_completed_waiting_failed_and_overflow() {
+        let mut lifecycle = Fixture::new();
+        lifecycle.add_agent("Done", LiveAgentStatus::Completed);
+        let waiting = lifecycle.add_agent("Needs approval", LiveAgentStatus::Running);
+        lifecycle.add_activity(
+            waiting,
+            "approval",
+            "Remove cache",
+            ActivityStatus::WaitingApproval,
+        );
+        lifecycle.set_status(waiting, LiveAgentStatus::WaitingApproval);
+        let running = lifecycle.add_agent("Test agent", LiveAgentStatus::Running);
+        lifecycle.add_activity(running, "failed", "cargo test", ActivityStatus::Failed);
+        lifecycle.add_activity(running, "read", "read failure", ActivityStatus::Running);
+        let lifecycle = lifecycle.render(Size::new(120, 40), 4, false);
+
+        let mut three = Fixture::new();
+        three.add_agent("First", LiveAgentStatus::Running);
+        three.add_agent("Second", LiveAgentStatus::Running);
+        three.add_agent("Third", LiveAgentStatus::Running);
+        let three = three.render(Size::new(120, 40), 4, false);
+
+        let mut overflow = Fixture::new();
+        let overflow_ids = [
+            "Agent 1", "Agent 2", "Agent 3", "Agent 4", "Agent 5", "Agent 6",
+        ]
+        .into_iter()
+        .map(|label| overflow.add_agent(label, LiveAgentStatus::Running))
+        .collect::<Vec<_>>();
+        let overflow = overflow.render(Size::new(80, 15), 4, false);
+
+        insta::assert_snapshot!(
+            format!(
+                "{}\n---\n{}\n---\n{}",
+                lifecycle.text, three.text, overflow.text
+            ),
+            @r"
+        ! Needs approval  waiting approval
+          ! Remove cache  waiting approval
+        ● Test agent  running
+          ✗ cargo test  failed
+          ● read failure  running
+        ---
+        ● First  running
+        ● Second  running
+        ● Third  running
+        ---
+        ● Agent 1  running
+        ● Agent 2  running
+        … +4 more · /subagents
+        "
+        );
+        assert_eq!(lifecycle.frame.hit_regions().len(), 2);
+        assert_eq!(
+            lifecycle.frame.hit_regions()[1].rect,
+            Rect::new(0, 2, 120, 3)
+        );
+        assert_eq!(overflow.frame.mode(), Some(LivePanelMode::Compact));
+        assert_eq!(overflow.frame.hidden_count(), 4);
+        assert_eq!(overflow.frame.hit_regions().len(), 2);
+        let revision = overflow.frame.render_revision();
+        assert_eq!(
+            overflow.frame.hit_test(0, 0, revision),
+            Some(overflow_ids[0])
+        );
+        assert_eq!(
+            overflow.frame.hit_test(0, 1, revision),
+            Some(overflow_ids[1])
+        );
+        assert_eq!(overflow.frame.hit_test(0, 2, revision), None);
+        assert_eq!(overflow.frame.hit_test(80, 0, revision), None);
+        assert_eq!(overflow.frame.hit_test(0, 3, revision), None);
+    }

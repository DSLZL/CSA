+            ActivityStatus::Running,
+        );
+        let emoji = compact.add_agent("emoji-agent", LiveAgentStatus::Running);
+        compact.add_activity(
+            emoji,
+            "emoji",
+            "cargo test --features 你好-👩‍💻-é",
+            ActivityStatus::Succeeded,
+        );
+        let rendered = compact.render(Size::new(80, 24), 4, false);

+//! Resident, non-scrollback rendering for the App-owned sub-agent projection.
+
+use crate::app::ActivityStatus;
+use crate::app::LiveAgentState;
+use crate::app::LiveAgentStatus;
+use crate::history_cell::sanitize_user_text;
+use crate::line_truncation::truncate_line_with_ellipsis_if_overflow;
+use crate::render::renderable::Renderable;
+use codex_protocol::ThreadId;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::layout::Size;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::text::Span;
+use ratatui::widgets::Clear;
+use ratatui::widgets::Widget;
+use std::borrow::Cow;
+use std::cell::RefCell;
+
+const MIN_CONVERSATION_HEIGHT: u16 = 8;
+const PANEL_HARD_CAP: u16 = 12;
+const FULL_MODE_MIN_WIDTH: u16 = 96;
+const COMPACT_MODE_MIN_WIDTH: u16 = 72;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum LivePanelMode {
+    Full,
+    Compact,
+    Minimal,
+}
+
+pub(crate) struct LivePanelAgent<'a> {
+    thread_id: ThreadId,
+    label: String,
+    state: &'a LiveAgentState,
+}
+
+impl<'a> LivePanelAgent<'a> {
+    pub(crate) fn new(thread_id: ThreadId, label: String, state: &'a LiveAgentState) -> Self {
+        Self {
+            thread_id,
+            label,
+            state,
+        }
+    }
+}
+
+pub(crate) struct LivePanelSnapshot<'a> {
+    state_revision: u64,
+    agents: Vec<LivePanelAgent<'a>>,
+}
+
+impl<'a> LivePanelSnapshot<'a> {
+    pub(crate) fn new(state_revision: u64, agents: Vec<LivePanelAgent<'a>>) -> Self {
+        Self {
+            state_revision,
+            agents,
+        }
+    }
+
+    pub(crate) fn is_empty(&self) -> bool {
+        self.agents.is_empty()
+    }
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) struct LiveAgentHitRegion {
+    pub(crate) thread_id: ThreadId,
+    pub(crate) rect: Rect,
+    pub(crate) render_revision: u64,
+    pub(crate) state_revision: u64,
+}
+
+#[derive(Debug, Default)]
+pub(crate) struct LivePanelFrame {
+    render_revision: u64,
+    state_revision: u64,
+    screen_size: Option<Size>,
+    panel_rect: Option<Rect>,
+    mode: Option<LivePanelMode>,
+    hidden_count: usize,
+    hit_regions: Vec<LiveAgentHitRegion>,
+}
+
+#[allow(dead_code)] // TUI-06 consumes revisioned hit testing; TUI-05 verifies the contract.
+impl LivePanelFrame {
+    pub(crate) fn render_revision(&self) -> u64 {
+        self.render_revision
+    }
+
+    pub(crate) fn state_revision(&self) -> u64 {
+        self.state_revision
+    }
+
+    pub(crate) fn panel_rect(&self) -> Option<Rect> {
+        self.panel_rect
+    }
+
+    pub(crate) fn mode(&self) -> Option<LivePanelMode> {
+        self.mode
+    }
+
+    pub(crate) fn hidden_count(&self) -> usize {
+        self.hidden_count
+    }
+
+    pub(crate) fn hit_regions(&self) -> &[LiveAgentHitRegion] {
+        &self.hit_regions
+    }
+
+    pub(crate) fn prepare_resize(&mut self, screen_size: Size) {
+        if self.screen_size != Some(screen_size) {
+            self.clear_visible_frame();
+            self.screen_size = Some(screen_size);
+        }
+    }
+
+    pub(crate) fn clear(&mut self) {
+        self.clear_visible_frame();
+        self.screen_size = None;
+    }
+
+    pub(crate) fn hit_test(
+        &self,
+        x: u16,
+        y: u16,
+        expected_render_revision: u64,
+    ) -> Option<ThreadId> {
+        if expected_render_revision != self.render_revision {
+            return None;
+        }
+        self.hit_regions
+            .iter()
+            .find(|region| {
+                x >= region.rect.x
+                    && x < region.rect.right()
+                    && y >= region.rect.y
+                    && y < region.rect.bottom()
+            })
+            .map(|region| region.thread_id)
+    }
+
+    fn clear_visible_frame(&mut self) {
+        if self.panel_rect.is_some() || !self.hit_regions.is_empty() {
+            self.render_revision = self.render_revision.wrapping_add(1);
+        }
+        self.state_revision = 0;
+        self.panel_rect = None;
+        self.mode = None;
+        self.hidden_count = 0;
+        self.hit_regions.clear();
+    }
+
+    fn publish(
+        &mut self,
+        screen_size: Size,
+        state_revision: u64,
+        panel_rect: Rect,
+        mode: LivePanelMode,
+        hidden_count: usize,
+        regions: Vec<(ThreadId, Rect)>,
+    ) {
+        self.render_revision = self.render_revision.wrapping_add(1);
+        self.state_revision = state_revision;
+        self.screen_size = Some(screen_size);
+        self.panel_rect = Some(panel_rect);
+        self.mode = Some(mode);
+        self.hidden_count = hidden_count;
+        self.hit_regions = regions
+            .into_iter()
+            .map(|(thread_id, rect)| LiveAgentHitRegion {
+                thread_id,
+                rect,
+                render_revision: self.render_revision,
+                state_revision,
+            })
+            .collect();
+    }
+}
+
+pub(crate) struct SubagentLivePanelRenderable<'a> {
+    snapshot: LivePanelSnapshot<'a>,
+    screen_size: Size,
+    bottom_pane_height: u16,
+    color_enabled: bool,
+    frame: &'a RefCell<LivePanelFrame>,
+}
+
+impl<'a> SubagentLivePanelRenderable<'a> {
+    pub(crate) fn new(
+        snapshot: LivePanelSnapshot<'a>,
+        screen_size: Size,
+        bottom_pane_height: u16,
+        color_enabled: bool,
+        frame: &'a RefCell<LivePanelFrame>,
+    ) -> Self {
+        Self {
+            snapshot,
+            screen_size,
+            bottom_pane_height,
+            color_enabled,
+            frame,
+        }
+    }
+
+    fn panel_cap(&self) -> u16 {
+        let hard_cap = PANEL_HARD_CAP.min(self.screen_size.height / 3);
+        let safe_cap = self
+            .screen_size
+            .height
+            .saturating_sub(self.bottom_pane_height)
+            .saturating_sub(MIN_CONVERSATION_HEIGHT);
+        hard_cap.min(safe_cap)
+    }
+
+    fn plan(&self, width: u16) -> Option<PanelPlan> {
+        let panel_cap = self.panel_cap();
+        if panel_cap == 0 || self.snapshot.agents.is_empty() {
+            return None;
+        }
+
+        let full_height = self.snapshot.agents.iter().fold(0u16, |height, agent| {
+            height.saturating_add(1 + u16::try_from(agent.state.recent().len().min(3)).unwrap_or(3))
+        });
+        if width >= FULL_MODE_MIN_WIDTH && panel_cap >= 4 && full_height <= panel_cap {
+            return Some(PanelPlan {
+                mode: LivePanelMode::Full,
+                height: full_height,
+                visible_count: self.snapshot.agents.len(),
+                hidden_count: 0,
+                show_footer: false,
+            });
+        }
+
+        if width >= COMPACT_MODE_MIN_WIDTH && panel_cap >= 3 {
+            let capacity = usize::from(panel_cap);
+            let (visible_count, show_footer) = if self.snapshot.agents.len() <= capacity {
+                (self.snapshot.agents.len(), false)
+            } else {
+                (capacity.saturating_sub(1), true)
+            };
+            let hidden_count = self.snapshot.agents.len().saturating_sub(visible_count);
+            return Some(PanelPlan {
+                mode: LivePanelMode::Compact,
+                height: u16::try_from(visible_count + usize::from(show_footer))
+                    .unwrap_or(panel_cap)
+                    .min(panel_cap),
+                visible_count,
+                hidden_count,
+                show_footer,
+            });
+        }
+
+        Some(PanelPlan {
+            mode: LivePanelMode::Minimal,
+            height: 1,
+            visible_count: usize::from(self.snapshot.agents.len() == 1),
+            hidden_count: usize::from(self.snapshot.agents.len() != 1) * self.snapshot.agents.len(),
+            show_footer: false,
+        })
+    }
+
+    fn render_line(&self, line: Line<'static>, y: u16, area: Rect, buf: &mut Buffer) {
+        if y >= area.bottom() {
+            return;
+        }
+        let line = truncate_line_with_ellipsis_if_overflow(line, usize::from(area.width));
+        line.render(Rect::new(area.x, y, area.width, 1), buf);
+    }
+
+    fn render_full(&self, plan: PanelPlan, area: Rect, buf: &mut Buffer) -> Vec<(ThreadId, Rect)> {
+        let mut y = area.y;
+        let mut regions = Vec::with_capacity(plan.visible_count);
+        for agent in self.snapshot.agents.iter().take(plan.visible_count) {
+            let block_start = y;
+            self.render_line(agent_header_line(agent, self.color_enabled), y, area, buf);
+            y = y.saturating_add(1);
+            for activity in agent.state.recent().iter().take(3) {
+                self.render_line(activity_line(activity, self.color_enabled), y, area, buf);
+                y = y.saturating_add(1);
+            }
+            regions.push((
+                agent.thread_id,
+                Rect::new(
+                    area.x,
+                    block_start,
+                    area.width,
+                    y.saturating_sub(block_start),
+                ),
+            ));
+        }
+        regions
+    }
+
+    fn render_compact(
+        &self,
+        plan: PanelPlan,
+        area: Rect,
+        buf: &mut Buffer,
+    ) -> Vec<(ThreadId, Rect)> {
+        let mut y = area.y;
+        let mut regions = Vec::with_capacity(plan.visible_count);
+        for agent in self.snapshot.agents.iter().take(plan.visible_count) {
+            self.render_line(compact_agent_line(agent, self.color_enabled), y, area, buf);
+            regions.push((agent.thread_id, Rect::new(area.x, y, area.width, 1)));
+            y = y.saturating_add(1);
+        }
+        if plan.show_footer {
+            self.render_line(
+                overflow_line(
+                    plan.hidden_count,
+                    waiting_approval_count(&self.snapshot.agents),
+                ),
+                y,
+                area,
+                buf,
+            );
+        }
+        regions
+    }
+
+    fn render_minimal(&self, area: Rect, buf: &mut Buffer) -> Vec<(ThreadId, Rect)> {
+        self.render_line(minimal_line(&self.snapshot.agents), area.y, area, buf);
+        if self.snapshot.agents.len() == 1 {
+            vec![(
+                self.snapshot.agents[0].thread_id,
+                Rect::new(area.x, area.y, area.width, 1),
+            )]
+        } else {
+            Vec::new()
+        }
+    }
+}
+
+impl Renderable for SubagentLivePanelRenderable<'_> {
+    fn render(&self, area: Rect, buf: &mut Buffer) {
+        let Some(plan) = self.plan(area.width) else {
+            self.frame.borrow_mut().clear();
+            return;
+        };
+        if area.is_empty() {
+            self.frame.borrow_mut().clear();
+            return;
+        }
+
+        let panel_rect = Rect::new(area.x, area.y, area.width, area.height.min(plan.height));
+        Clear.render(panel_rect, buf);
+        let regions = match plan.mode {
+            LivePanelMode::Full => self.render_full(plan, panel_rect, buf),
+            LivePanelMode::Compact => self.render_compact(plan, panel_rect, buf),
+            LivePanelMode::Minimal => self.render_minimal(panel_rect, buf),
+        };
+        self.frame.borrow_mut().publish(
+            self.screen_size,
+            self.snapshot.state_revision,
+            panel_rect,
+            plan.mode,
+            plan.hidden_count,
+            regions,
+        );
+    }
+
+    fn desired_height(&self, width: u16) -> u16 {
+        self.plan(width).map_or(0, |plan| plan.height)
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+struct PanelPlan {
+    mode: LivePanelMode,
+    height: u16,
+    visible_count: usize,
+    hidden_count: usize,
+    show_footer: bool,
+}
+
+fn agent_header_line(agent: &LivePanelAgent<'_>, color_enabled: bool) -> Line<'static> {
+    let (symbol, state_word) = agent_status_copy(agent.state.lifecycle());
+    let mut spans = vec![
+        status_span(symbol, agent.state.lifecycle(), color_enabled),
+        " ".into(),
+        sanitized_single_line(&agent.label).bold(),
+        "  ".into(),
+        status_span(state_word, agent.state.lifecycle(), color_enabled),
+    ];
+    if spans[2].content.is_empty() {
+        spans[2] = "Agent".bold();
+    }
+    Line::from(spans)
+}
+
+fn compact_agent_line(agent: &LivePanelAgent<'_>, color_enabled: bool) -> Line<'static> {
+    let mut line = agent_header_line(agent, color_enabled);
+    if let Some(activity) = agent.state.recent().back() {
+        line.spans.push(" · ".into());
+        line.spans.extend(activity_spans(
+            activity,
+            color_enabled,
+            /*include_indent*/ false,
+        ));
+    }
+    line
+}
+
+fn activity_line(activity: &crate::app::WorkActivityInput, color_enabled: bool) -> Line<'static> {
+    Line::from(activity_spans(
+        activity,
+        color_enabled,
+        /*include_indent*/ true,
+    ))
+}
+
+fn activity_spans(
+    activity: &crate::app::WorkActivityInput,
+    color_enabled: bool,
+    include_indent: bool,
+) -> Vec<Span<'static>> {
+    let (symbol, state_word) = activity_status_copy(activity.status);
+    let mut spans = Vec::with_capacity(6);
+    if include_indent {
+        spans.push("  ".into());
+    }
+    spans.push(activity_status_span(symbol, activity.status, color_enabled));
+    spans.push(" ".into());
+    spans.push(sanitized_single_line(&activity.label).into());
+    spans.push("  ".into());
+    spans.push(activity_status_span(
+        state_word,
+        activity.status,
+        color_enabled,
+    ));
+    spans
+}
+
+fn overflow_line(hidden_count: usize, waiting_approval: usize) -> Line<'static> {
+    let waiting = if waiting_approval == 0 {
+        String::new()
+    } else {
+        format!(" · {waiting_approval} waiting approval")
+    };
+    format!("… +{hidden_count} more{waiting} · /subagents")
+        .dim()
+        .into()
+}
+
+fn minimal_line(agents: &[LivePanelAgent<'_>]) -> Line<'static> {
+    let waiting = waiting_approval_count(agents);
+    let failed = agents
+        .iter()
+        .filter(|agent| agent.state.lifecycle() == LiveAgentStatus::Failed)
+        .count();
+    let cancelled = agents
+        .iter()
+        .filter(|agent| agent.state.lifecycle() == LiveAgentStatus::Cancelled)
+        .count();
+    let symbol = if waiting > 0 {
+        "!"
+    } else if failed > 0 {
+        "✗"
+    } else if cancelled > 0 {
+        "×"
+    } else {
+        "●"
+    };
+    let noun = if agents.len() == 1 {
+        "subagent"
+    } else {
+        "subagents"
+    };
+    let mut text = format!("{symbol} {} {noun}", agents.len());
+    if waiting > 0 {
+        text.push_str(&format!(" · {waiting} waiting approval"));
+    }
+    if failed > 0 {
+        text.push_str(&format!(" · {failed} failed"));
+    }
+    if cancelled > 0 {
+        text.push_str(&format!(" · {cancelled} cancelled"));
+    }
+    text.push_str(" · /subagents");
+    text.into()
+}
+
+fn waiting_approval_count(agents: &[LivePanelAgent<'_>]) -> usize {
+    agents
+        .iter()
+        .filter(|agent| agent.state.lifecycle() == LiveAgentStatus::WaitingApproval)
+        .count()
+}
+
+fn sanitized_single_line(value: &str) -> String {
+    sanitize_user_text(Cow::Borrowed(value))
+        .split_whitespace()
+        .collect::<Vec<_>>()
+        .join(" ")
+}
+
+fn agent_status_copy(status: LiveAgentStatus) -> (&'static str, &'static str) {
+    match status {
+        LiveAgentStatus::Starting => ("◌", "starting"),
+        LiveAgentStatus::Running => ("●", "running"),
+        LiveAgentStatus::WaitingApproval => ("!", "waiting approval"),
+        LiveAgentStatus::Waiting => ("◌", "waiting"),
+        LiveAgentStatus::Failed => ("✗", "failed"),
+        LiveAgentStatus::Cancelled => ("×", "cancelled"),
+        LiveAgentStatus::Completed => ("✓", "completed"),
+    }
+}
+
+fn activity_status_copy(status: ActivityStatus) -> (&'static str, &'static str) {
+    match status {
+        ActivityStatus::Running => ("●", "running"),
+        ActivityStatus::WaitingApproval => ("!", "waiting approval"),
+        ActivityStatus::Succeeded => ("✓", "succeeded"),
+        ActivityStatus::Failed => ("✗", "failed"),
+        ActivityStatus::Declined => ("×", "declined"),
+        ActivityStatus::Cancelled => ("×", "cancelled"),
+    }
+}
+
+fn status_span(text: &'static str, status: LiveAgentStatus, color_enabled: bool) -> Span<'static> {
+    let span = Span::raw(text);
+    if !color_enabled {
+        return span;
+    }
+    match status {
+        LiveAgentStatus::Starting | LiveAgentStatus::Waiting => span.dim(),
+        LiveAgentStatus::Running | LiveAgentStatus::Completed => span.green(),
+        LiveAgentStatus::WaitingApproval => span.bold(),
+        LiveAgentStatus::Failed | LiveAgentStatus::Cancelled => span.red(),
+    }
+}
+
+fn activity_status_span(
+    text: &'static str,
+    status: ActivityStatus,
+    color_enabled: bool,
+) -> Span<'static> {
+    let span = Span::raw(text);
+    if !color_enabled {
+        return span;
+    }
+    match status {
+        ActivityStatus::Running | ActivityStatus::Succeeded => span.green(),
+        ActivityStatus::WaitingApproval => span.bold(),
+        ActivityStatus::Failed | ActivityStatus::Declined | ActivityStatus::Cancelled => span.red(),
+    }
+}

index 0000000..146dfd4
--- /dev/null
+++ b/codex-rs/tui/src/tui/mouse_capture.rs
@@ -0,0 +1,90 @@
+use std::io::Result;
+use std::io::Write;
+use std::io::stdout;
+use std::sync::Arc;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+
+use codex_config::types::SubagentLiveMouseMode;
+use codex_terminal_detection::TerminalInfo;
+use codex_terminal_detection::TerminalName;
+use crossterm::event::DisableMouseCapture;
+use crossterm::event::EnableMouseCapture;
+use ratatui::crossterm::execute;
+
+#[derive(Clone, Debug, Default)]
+pub(super) struct MouseCapture {
+    active: Arc<AtomicBool>,
+}
+
+impl MouseCapture {
+    pub(super) fn active(&self) -> bool {
+        self.active.load(Ordering::Relaxed)
+    }
+
+    pub(super) fn set(&self, enabled: bool) -> Result<()> {
+        let mut output = stdout();
+        self.set_with_writer(&mut output, enabled)
+    }
+
+    /// Best-effort transition guard: always emit the terminal reset and record the safe state.
+    pub(super) fn force_off(&self) -> Result<()> {
+        let mut output = stdout();
+        self.force_off_with_writer(&mut output)
+    }
+
+    fn force_off_with_writer(&self, output: &mut impl Write) -> Result<()> {
+        self.finish_transition(/*enabled*/ false, disable_unconditionally(output))
+    }
+
+    pub(super) fn set_with_writer(&self, output: &mut impl Write, enabled: bool) -> Result<()> {
+        if self.active() == enabled {
+            return Ok(());
+        }
+        let result = if enabled {
+            execute!(output, EnableMouseCapture)
+        } else {
+            disable_unconditionally(output)
+        };
+        self.finish_transition(enabled, result)
+    }
+
+    fn finish_transition(&self, enabled: bool, result: Result<()>) -> Result<()> {
+        if !enabled || result.is_ok() {
+            self.active.store(enabled, Ordering::Relaxed);
+        }
+        result
+    }
+}
+
+pub(super) fn disable_unconditionally(output: &mut impl Write) -> Result<()> {
+    execute!(output, DisableMouseCapture)
+}
+
+pub(super) fn should_capture(
+    mode: SubagentLiveMouseMode,
+    terminal: &TerminalInfo,
+    alt_screen_active: bool,
+    panel_renderable: bool,
+    raw_output_mode: bool,
+) -> bool {
+    if raw_output_mode {
+        return false;
+    }
+    match mode {
+        SubagentLiveMouseMode::Off => false,
+        SubagentLiveMouseMode::On => true,
+        SubagentLiveMouseMode::Auto => {
+            auto_supported(terminal) && alt_screen_active && panel_renderable
+        }
+    }
+}
+
+fn auto_supported(terminal: &TerminalInfo) -> bool {
+    !matches!(terminal.name, TerminalName::Dumb | TerminalName::Unknown)
+        || terminal.multiplexer.is_some()
+}
+
+#[cfg(test)]
+#[path = "mouse_capture_tests.rs"]
+mod tests;

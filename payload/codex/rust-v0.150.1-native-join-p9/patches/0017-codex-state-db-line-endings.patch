+async fn migration_history(pool: &sqlx::SqlitePool) -> Vec<(i64, String, Vec<u8>, bool, i64)> {
+    sqlx::query_as(
+        "SELECT version, description, checksum, success, execution_time FROM _sqlx_migrations ORDER BY version",
+    )

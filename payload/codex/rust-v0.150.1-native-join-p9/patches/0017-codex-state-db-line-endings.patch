+fn migration_checksum_hex(migration: &Migration) -> String {
+    let mut hex = String::with_capacity(migration.checksum.len() * 2);
+    for byte in migration.checksum.iter() {
+        std::fmt::Write::write_fmt(&mut hex, format_args!("{byte:02x}"))
+            .expect("writing to a string should succeed");
+    }
+    hex
+}

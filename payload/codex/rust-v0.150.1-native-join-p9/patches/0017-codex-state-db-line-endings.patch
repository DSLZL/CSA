+    );
+    let pool = sqlite
+        .open_read_write_pool(&state_path)
+        .await
+        .expect("legacy database should open");
+    legacy
+        .run(&pool)
+        .await
+        .expect("legacy LF migrations should apply");
+    insert_migration_line_endings_sentinel(&pool).await;
+    let before = migration_history(&pool).await;
+    pool.close().await;
+
+    let official = runtime_state_migrator();
+    let pool = sqlite
+        .open_state_db(&official, None)
+        .await
+        .expect("patched runtime should upgrade the legacy database");
+    let after = migration_history(&pool).await;
+    assert_eq!(
+        before
+            .iter()
+            .map(|(version, description, _, success, execution_time)| {
+                (version, description, success, execution_time)
+            })
+            .collect::<Vec<_>>(),
+        after
+            .iter()
+            .map(|(version, description, _, success, execution_time)| {
+                (version, description, success, execution_time)
+            })
+            .collect::<Vec<_>>()
+    );
+    assert_eq!(
+        after
+            .iter()
+            .map(|(version, _, checksum, _, _)| (*version, checksum.clone()))
+            .collect::<Vec<_>>(),
+        official
+            .migrations

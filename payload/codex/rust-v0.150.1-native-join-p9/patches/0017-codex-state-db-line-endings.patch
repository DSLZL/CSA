+#[tokio::test]
+async fn migration_line_endings_official_database_round_trips() {
+    let sqlite_home = crate::runtime::test_support::unique_temp_dir();
+    tokio::fs::create_dir_all(&sqlite_home)
+        .await
+        .expect("sqlite home should be created");
+    let _cleanup = scopeguard::guard(sqlite_home.clone(), |sqlite_home| {
+        let _ = std::fs::remove_dir_all(sqlite_home);
+    });
+    let sqlite = crate::SqliteConfig::new_for_testing(sqlite_home.as_path().abs());
+    let state_path = sqlite.state_db_path();
+    let official = runtime_state_migrator();
+    assert_eq!(
+        migration_checksum_hex(&official.migrations[0]),
+        "54bbd6f47905a4e4c674034575963d82da7b534e66e9a37a81ec2afb6a4b56ce6de9b3ecf3032796a800f650239847d4"
+    );
+    let pool = sqlite
+        .open_read_write_pool(&state_path)
+        .await
+        .expect("official database should open");
+    official
+        .run(&pool)
+        .await
+        .expect("official CRLF migrations should apply");
+    insert_migration_line_endings_sentinel(&pool).await;
+    let before = migration_history(&pool).await;
+    pool.close().await;
+
+    let patched = runtime_state_migrator();
+    let pool = sqlite
+        .open_state_db(&patched, None)
+        .await
+        .expect("patched runtime should open the official database");
+    official
+        .run(&pool)
+        .await
+        .expect("official runtime should reopen the patched database");
+    assert_eq!(migration_history(&pool).await, before);
+    assert_migration_line_endings_sentinel(&pool).await;
+    pool.close().await;
+}

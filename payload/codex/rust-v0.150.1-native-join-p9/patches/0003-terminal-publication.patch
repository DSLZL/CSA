+fn agent_run_terminal_from_event(
+    msg: &EventMsg,
+    terminal_error: Option<&ErrorEvent>,
+) -> Option<AgentRunTerminal> {
+    if let Some(error) = terminal_error {
+        return Some(AgentRunTerminal {
+            outcome: AgentRunOutcome::Failed {
+                message: error.message.clone(),
+                reason: None,
+            },
+        });
+    }
+
+    let outcome = match msg {
+        EventMsg::TurnComplete(event) => AgentRunOutcome::Completed {
+            output: event.last_agent_message.clone(),
+        },
+        EventMsg::TurnAborted(event) => match event.reason {
+            TurnAbortReason::Interrupted => AgentRunOutcome::Cancelled {
+                reason: "interrupted".to_string(),
+            },
+            TurnAbortReason::BudgetLimited => AgentRunOutcome::Failed {
+                message: "child run exceeded its token budget".to_string(),
+                reason: Some("budget_limited".to_string()),
+            },
+            TurnAbortReason::Replaced => AgentRunOutcome::Failed {
+                message: "child run was replaced".to_string(),
+                reason: Some("replaced".to_string()),
+            },
+            TurnAbortReason::ReviewEnded => AgentRunOutcome::Failed {
+                message: "child review ended".to_string(),
+                reason: Some("review_ended".to_string()),
+            },
+        },
+        _ => return None,
+    };
+    Some(AgentRunTerminal { outcome })
+}

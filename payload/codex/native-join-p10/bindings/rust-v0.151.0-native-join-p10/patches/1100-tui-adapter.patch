+            id: "started".to_string(),
+            kind: codex_app_server_protocol::SubAgentActivityKind::Started,
+            agent_thread_id: thread_id.clone(),
+            agent_path: "/root/current_time_latest".to_string(),
+        };
+        let completed = ThreadItem::SubAgentActivity {
+            id: "completed".to_string(),
+            kind: codex_app_server_protocol::SubAgentActivityKind::Completed,
+            agent_thread_id: thread_id.clone(),
+            agent_path: "/root/current_time_latest".to_string(),
+        };
+        let wait = |status| ThreadItem::CollabAgentToolCall {
+            id: "wait".to_string(),
+            tool: codex_app_server_protocol::CollabAgentTool::Wait,
+            status,
+            sender_thread_id: ThreadId::new().to_string(),

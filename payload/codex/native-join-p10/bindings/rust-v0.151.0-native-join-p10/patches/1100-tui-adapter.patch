+        let shifted = orbit_intensities_at(start, sample + ORBIT_PIXEL_STAGGER);
+        for sequence in 0..ORBIT_ORDER.len() - 1 {
+            assert!(
+                (current[ORBIT_ORDER[sequence]] - shifted[ORBIT_ORDER[sequence + 1]]).abs()
+                    < 0.000_1
+            );
+        }
+
+        for sequence in 0..ORBIT_ORDER.len() {
+            let peak_at = start
+                + Duration::from_millis(
+                    380 + ORBIT_PIXEL_STAGGER.as_millis() as u64 * sequence as u64,
+                );
+            let intensities = orbit_intensities_at(start, peak_at);
+            let maximum = intensities.into_iter().fold(0.0, f32::max);
+            let leading_peak = ORBIT_ORDER
+                .into_iter()
+                .enumerate()
+                .filter(|(_, cell)| (intensities[*cell] - maximum).abs() < 0.000_1)
+                .map(|(sequence, _)| sequence)
+                .max();
+            assert_eq!(leading_peak, Some(sequence));
+        }
+    }
 }

+/// BeautifulUI's 3×3 Orbit: eight fixed perimeter pixels sharing one opacity curve.
+pub(crate) fn orbit_intensities_at(start_time: Instant, now: Instant) -> [f32; 9] {
+    let elapsed = now.saturating_duration_since(start_time);
+    let mut intensities = [0.0; 9];
+    for (sequence, cell) in ORBIT_ORDER.into_iter().enumerate() {
+        let delay = ORBIT_PIXEL_STAGGER * sequence as u32;
+        if elapsed < delay {
+            continue;
+        }
+        let phase = (elapsed - delay).as_secs_f32() % ORBIT_DURATION.as_secs_f32()
+            / ORBIT_DURATION.as_secs_f32();
+        let source_opacity = orbit_source_opacity(phase);
+        intensities[cell] =
+            ((source_opacity - ORBIT_BASE_OPACITY) / ORBIT_OPACITY_RANGE).clamp(0.0, 1.0);
+    }
+    intensities
+}
+
+fn orbit_source_opacity(phase: f32) -> f32 {
+    let phase = phase.clamp(0.0, 1.0);
+    if phase <= 0.40 {
+        ORBIT_BASE_OPACITY + ORBIT_OPACITY_RANGE * css_ease_in_out(phase / 0.40)
+    } else if phase <= 0.55 {
+        1.0
+    } else {
+        1.0 - ORBIT_OPACITY_RANGE * css_ease_in_out((phase - 0.55) / 0.45)
+    }
+}
+
+fn css_ease_in_out(progress: f32) -> f32 {
+    let progress = progress.clamp(0.0, 1.0);
+    if progress == 0.0 || progress == 1.0 {
+        return progress;
+    }
+
+    let mut lower = 0.0;
+    let mut upper = 1.0;
+    for _ in 0..20 {
+        let t = (lower + upper) / 2.0;
+        if cubic_bezier_axis(t, 0.42, 0.58) < progress {
+            lower = t;
+        } else {
+            upper = t;
+        }
+    }
+    cubic_bezier_axis((lower + upper) / 2.0, 0.0, 1.0)
+}
+
+fn cubic_bezier_axis(t: f32, first: f32, second: f32) -> f32 {
+    let inverse = 1.0 - t;
+    3.0 * inverse * inverse * t * first + 3.0 * inverse * t * t * second + t * t * t
+}

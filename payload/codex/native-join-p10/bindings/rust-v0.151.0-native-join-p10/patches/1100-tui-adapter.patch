+#[tokio::test]
+async fn subagent_live_event_storm_stays_bounded_and_navigable_without_main_ops() -> Result<()> {
+    let (mut app, mut app_event_rx, mut op_rx) = make_test_app_with_channels().await;
+    let main_thread_id = ThreadId::new();
+    let child_thread_ids = (0..8).map(|_| ThreadId::new()).collect::<Vec<_>>();
+    app.primary_thread_id = Some(main_thread_id);
+    app.active_thread_id = Some(main_thread_id);
+
+    for (index, thread_id) in child_thread_ids.iter().copied().enumerate() {
+        app.agent_navigation.upsert(
+            thread_id,
+            Some(format!("Burst {index}")),
+            Some("worker".to_string()),
+            /*is_closed*/ false,
+        );
+        app.agent_navigation.mark_parent_owned(thread_id);
+    }
+
+    let started_at = Instant::now();
+    for (thread_index, thread_id) in child_thread_ids.iter().copied().enumerate() {
+        for item_index in 0..25 {
+            let item_id = format!("burst-{thread_index}-{item_index}");
+            for (status, completed) in [
+                (
+                    codex_app_server_protocol::CommandExecutionStatus::InProgress,
+                    false,
+                ),
+                (
+                    codex_app_server_protocol::CommandExecutionStatus::InProgress,
+                    false,
+                ),
+                (
+                    codex_app_server_protocol::CommandExecutionStatus::Completed,
+                    true,
+                ),
+                (
+                    codex_app_server_protocol::CommandExecutionStatus::InProgress,
+                    false,
+                ),
+            ] {
+                app.enqueue_thread_notification(
+                    thread_id,
+                    command_item_notification(thread_id, "burst-turn", &item_id, status, completed),
+                )
+                .await?;
+            }
+        }
+    }
+    let elapsed = started_at.elapsed();
+
+    assert_eq!(app.subagent_live_state().retained_activity_count(), 24);
+    assert!(
+        child_thread_ids.iter().copied().all(|thread_id| {
+            app.subagent_live_state()
+                .agent(thread_id)
+                .is_some_and(|agent| agent.recent().len() == 3)
+        }),
+        "each agent should retain only its latest three activities"
+    );
+    assert!(
+        elapsed < Duration::from_secs(10),
+        "800 routed events took {elapsed:?}"
+    );
+    assert!(op_rx.try_recv().is_err());
+
+    let screen_size = Size::new(120, 40);
+    let panel = app
+        .subagent_live_panel_renderable(screen_size, Instant::now())
+        .expect("live panel after routed burst");
+    let area = Rect::new(
+        /*x*/ 0,
+        /*y*/ 0,
+        screen_size.width,
+        panel.desired_height(screen_size.width),
+    );
+    panel.render(area, &mut Buffer::empty(area));
+    drop(panel);
+    let frame = app.subagent_live_panel_frame.borrow();
+    let region = frame.hit_regions()[0].clone();
+    let selected_thread_id = frame
+        .hit_test(region.rect.x, region.rect.y, frame.render_revision())
+        .expect("rendered row should be selectable");
+    drop(frame);
+
+    app.handle_mouse_event(MouseEvent {
+        kind: MouseEventKind::Down(MouseButton::Left),
+        column: region.rect.x,
+        row: region.rect.y,
+        modifiers: KeyModifiers::NONE,
+    });
+    assert_matches!(
+        app_event_rx.try_recv(),
+        Ok(AppEvent::SelectAgentThread(thread_id)) if thread_id == selected_thread_id
+    );
+    app.active_thread_id = Some(selected_thread_id);
+    assert_eq!(
+        app.left_return_target(KeyEvent::new(KeyCode::Left, KeyModifiers::NONE)),
+        Some(main_thread_id)
+    );
+    assert!(op_rx.try_recv().is_err());
+    Ok(())
+}

+#[tokio::test]
+async fn safe_left_target_and_footer_follow_child_input_precedence() {
+    let mut app = make_test_app().await;
+    let main_thread_id = ThreadId::new();
+    let child_thread_id = ThreadId::new();
+    let nested_child_id = ThreadId::new();
+    let unrelated_thread_id = ThreadId::new();
+    for (thread_id, nickname) in [
+        (main_thread_id, "Main"),
+        (child_thread_id, "Child"),
+        (nested_child_id, "Nested"),
+        (unrelated_thread_id, "Unrelated"),
+    ] {
+        app.agent_navigation.upsert(
+            thread_id,
+            Some(nickname.to_string()),
+            Some("worker".to_string()),
+            /*is_closed*/ false,
+        );
+    }
+    app.agent_navigation.mark_parent_owned(child_thread_id);
+    app.agent_navigation.mark_parent_owned(nested_child_id);
+    app.primary_thread_id = Some(main_thread_id);
+    app.active_thread_id = Some(child_thread_id);
+
+    let left = KeyEvent::new(KeyCode::Left, KeyModifiers::NONE);
+    assert_eq!(app.left_return_target(left), Some(main_thread_id));
+    assert_eq!(
+        app.left_return_target(KeyEvent::new_with_kind(
+            KeyCode::Left,
+            KeyModifiers::NONE,
+            KeyEventKind::Repeat,
+        )),
+        Some(main_thread_id)
+    );
+    assert_eq!(
+        app.left_return_target(KeyEvent::new(KeyCode::Left, KeyModifiers::ALT)),
+        None
+    );
+    assert_eq!(
+        app.left_return_target(KeyEvent::new_with_kind(
+            KeyCode::Left,
+            KeyModifiers::NONE,
+            KeyEventKind::Release,
+        )),
+        None
+    );
+
+    app.sync_active_agent_footer_label();
+    assert!(render_bottom_popup(&app.chat_widget, /*width*/ 100).contains("← Main"));
+
+    app.active_thread_id = Some(main_thread_id);
+    assert_eq!(app.left_return_target(left), None);
+    app.active_thread_id = Some(unrelated_thread_id);
+    assert_eq!(app.left_return_target(left), None);
+    app.active_thread_id = Some(nested_child_id);
+    assert_eq!(app.left_return_target(left), Some(main_thread_id));
+    app.active_thread_id = Some(child_thread_id);
+
+    app.chat_widget.apply_external_edit("draft".to_string());
+    assert_eq!(app.left_return_target(left), None);
+    app.sync_active_agent_footer_label();
+    assert!(!render_bottom_popup(&app.chat_widget, /*width*/ 100).contains("← Main"));
+    app.chat_widget.apply_external_edit(String::new());
+
+    app.overlay = Some(Overlay::new_transcript(
+        Vec::new(),
+        crate::keymap::RuntimeKeymap::defaults().pager,
+    ));
+    assert_eq!(app.left_return_target(left), None);
+    app.overlay = None;
+
+    app.chat_widget.open_multi_agent_enable_prompt();
+    assert_eq!(app.left_return_target(left), None);
+}

+#[tokio::test]
+async fn subagent_live_resume_reconciliation_covers_i09_and_i10() -> Result<()> {
+    let mut app = make_test_app().await;
+    let historical_child_id = ThreadId::new();
+    let live_child_id = ThreadId::new();
+    app.primary_thread_id = Some(ThreadId::new());
+    app.subagent_live
+        .hydrate_live_agent(historical_child_id, subagent_live::LiveAgentStatus::Running);
+
+    let loaded = vec![
+        LoadedSubagentThread {
+            thread_id: historical_child_id,
+            agent_nickname: Some("Done".to_string()),
+            agent_role: Some("worker".to_string()),
+            agent_path: Some("/root/done".to_string()),
+            blocks_direct_input: true,
+            is_running: false,
+            is_closed: true,
+        },
+        LoadedSubagentThread {
+            thread_id: live_child_id,
+            agent_nickname: Some("Live".to_string()),
+            agent_role: Some("worker".to_string()),
+            agent_path: Some("/root/live".to_string()),
+            blocks_direct_input: true,
+            is_running: true,
+            is_closed: false,
+        },
+    ];
+    app.reconcile_subagent_live_from_loaded_threads(&loaded, /*completed*/ true);
+    assert!(
+        app.subagent_live_state()
+            .agent(historical_child_id)
+            .is_none(),
+        "I-09 historical terminal child must not be resurrected"
+    );
+    assert_eq!(
+        app.subagent_live_state()
+            .agent(live_child_id)
+            .expect("I-10 live child should hydrate")
+            .lifecycle(),
+        subagent_live::LiveAgentStatus::Running
+    );
+    let hydrated_revision = app.subagent_live_state().revision();
+    app.reconcile_subagent_live_from_loaded_threads(&loaded, /*completed*/ true);
+    assert_eq!(
+        app.subagent_live_state().revision(),
+        hydrated_revision,
+        "identical authoritative hydration is one-shot/idempotent"
+    );
+
+    app.agent_navigation.mark_parent_owned(live_child_id);
+    app.enqueue_thread_notification(
+        live_child_id,
+        command_item_notification(
+            live_child_id,
+            "turn-live",
+            "call-live",
+            codex_app_server_protocol::CommandExecutionStatus::InProgress,
+            /*completed*/ false,
+        ),
+    )
+    .await?;
+    assert_eq!(
+        app.subagent_live_state()
+            .agent(live_child_id)
+            .unwrap()
+            .recent()
+            .len(),
+        1,
+        "hydrated child must continue from the event-driven route"
+    );
+    Ok(())
+}

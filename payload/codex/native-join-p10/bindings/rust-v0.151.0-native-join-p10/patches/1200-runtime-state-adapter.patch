+pub(crate) async fn repair_migration_line_endings(
+    pool: &SqlitePool,
+    migrator: &Migrator,
+) -> anyhow::Result<()> {
+    let migrations_table_exists = sqlx::query_scalar::<_, i64>(
+        "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = '_sqlx_migrations'",
+    )
+    .fetch_optional(pool)
+    .await?
+    .is_some();
+    if !migrations_table_exists {
+        return Ok(());
+    }
+
+    let mut transaction = pool.begin().await?;
+    let applied = sqlx::query_as::<_, (i64, Vec<u8>, bool)>(
+        "SELECT version, checksum, success FROM _sqlx_migrations ORDER BY version",
+    )
+    .fetch_all(&mut *transaction)
+    .await?;
+    let mut repairs = Vec::new();
+    for (version, checksum, success) in applied {
+        if !success {
+            transaction.rollback().await?;
+            return Ok(());
+        }
+        let Some(migration) = migrator
+            .migrations
+            .iter()
+            .find(|migration| migration.version == version)
+        else {
+            continue;
+        };
+        if checksum == migration.checksum.as_ref() {
+            continue;
+        }
+        let legacy_checksum = migration_with_lf(migration).checksum;
+        if checksum != legacy_checksum.as_ref() {
+            transaction.rollback().await?;
+            return Ok(());
+        }
+        repairs.push((version, checksum, migration.checksum.to_vec()));
+    }
+
+    for (version, legacy_checksum, checksum) in repairs {
+        let result = sqlx::query(
+            "UPDATE _sqlx_migrations SET checksum = ? WHERE version = ? AND checksum = ?",
+        )
+        .bind(checksum)
+        .bind(version)
+        .bind(legacy_checksum)
+        .execute(&mut *transaction)
+        .await?;
+        anyhow::ensure!(
+            result.rows_affected() == 1,
+            "migration history changed while repairing line endings"
+        );
+    }
+    transaction.commit().await?;
+    Ok(())
+}

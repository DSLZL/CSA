+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn full_shutdown_terminates_parent_and_child_during_pending_join() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+
+    let (server, test, spawned_run) = start_pending_native_join(
+        SHUTDOWN_PARENT_PROMPT,
+        SHUTDOWN_SPAWN_CALL_ID,
+        SHUTDOWN_JOIN_CALL_ID,
+        SHUTDOWN_CHILD_CALL_ID,
+        SHUTDOWN_GATE_ID,
+    )
+    .await?;
+    wait_for_pending_join(&test, &spawned_run, SHUTDOWN_GATE_ID, SHUTDOWN_JOIN_CALL_ID).await;
+
+    let root_thread_id = test.session_configured.thread_id;
+    let child_thread_id = test
+        .thread_manager
+        .list_thread_ids()
+        .await
+        .into_iter()
+        .find(|thread_id| *thread_id != root_thread_id)
+        .expect("spawned child thread ID");
+    let child_thread = test.thread_manager.get_thread(child_thread_id).await?;
+    assert_eq!(child_thread.agent_status().await, AgentStatus::Running);
+
+    let report = timeout(
+        Duration::from_secs(10),
+        test.thread_manager
+            .shutdown_all_threads_bounded(Duration::from_secs(5)),
+    )
+    .await
+    .expect("full shutdown should not leave Join or child parked");
+    assert!(report.submit_failed.is_empty());
+    assert!(report.timed_out.is_empty());
+    assert_eq!(report.completed.len(), 2);
+    assert!(report.completed.contains(&root_thread_id));
+    assert!(report.completed.contains(&child_thread_id));
+    assert!(test.thread_manager.list_thread_ids().await.is_empty());
+    timeout(Duration::from_secs(1), child_thread.wait_until_terminated())
+        .await
+        .expect("child session loop should terminate during full shutdown");
+    timeout(Duration::from_secs(1), test.codex.wait_until_terminated())
+        .await
+        .expect("Parent session loop should terminate during full shutdown");
+
+    let requests = server
+        .received_requests()
+        .await
+        .expect("mock server should retain response requests")
+        .into_iter()
+        .filter(|request| request.url.path().ends_with("/responses"))
+        .collect::<Vec<_>>();
+    assert_eq!(requests.len(), 3);
+    assert_eq!(
+        requests
+            .iter()
+            .filter(|request| !request_is_subagent(request))
+            .count(),
+        2
+    );
+
+    Ok(())
+}

+                    if matches!(
+                        &event.item,
+                        TurnItem::CollabAgentToolCall(item)
+                            if item.id == REJOIN_CALL_ID
+                                && item.tool == CollabAgentTool::Join
+                                && item.status == CollabAgentToolCallStatus::Completed
+                    )
+            )
+        }),
+    )
+    .await
+    .expect("rejoined running receipt should complete");
+    timeout(
+        Duration::from_secs(5),
+        wait_for_event(&test.codex, |event| {
+            matches!(event, EventMsg::TurnComplete(_))
+        }),
+    )
+    .await
+    .expect("rejoin result should resume Parent once");
+    let rejoin_output = parent_after_rejoin
+        .function_call_output_text(REJOIN_CALL_ID)
+        .expect("Parent continuation should contain rejoin result");
+    let rejoin_output: serde_json::Value = serde_json::from_str(&rejoin_output)?;
+    assert_eq!(rejoin_output["status"], json!("completed"));
+    assert_eq!(rejoin_output["output"], json!("child done after rejoin"));
+
+    let replay_args = json!({ "target": target, "run_id": run_id }).to_string();
+    mount_sse_once_match(
+        &server,
+        |request: &wiremock::Request| body_contains(request, REPLAY_PROMPT),
+        sse(vec![
+            ev_response_created("resp-replay-1"),
+            ev_function_call(REPLAY_CALL_ID, "join_agent", &replay_args),
+            ev_completed("resp-replay-1"),
+        ]),
+    )
+    .await;
+    let parent_after_replay = mount_sse_once_match(
+        &server,
+        |request: &wiremock::Request| body_contains(request, REPLAY_CALL_ID),
+        sse(vec![
+            ev_response_created("resp-replay-2"),
+            ev_assistant_message("msg-replay-2", "replay done"),
+            ev_completed("resp-replay-2"),
+        ]),
+    )
+    .await;
+    test.submit_turn(REPLAY_PROMPT).await?;
+    let replay_output = parent_after_replay
+        .function_call_output_text(REPLAY_CALL_ID)
+        .expect("cached terminal receipt should replay immediately");
+    let replay_output: serde_json::Value = serde_json::from_str(&replay_output)?;
+    assert_eq!(replay_output["run_id"], json!(run_id));
+    assert_eq!(replay_output["status"], json!("completed"));
+    assert_eq!(replay_output["output"], json!("child done after rejoin"));
+    assert!(matches!(
+        child_thread.agent_status().await,
+        AgentStatus::Completed(_)
+    ));
+
+    Ok(())
+}

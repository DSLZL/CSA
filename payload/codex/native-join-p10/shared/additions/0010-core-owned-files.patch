+    )
+    .await
+    .expect("child tool should reach the closed gate");
+    timeout(Duration::from_secs(5), async {
+        loop {
+            if spawned_run.lock().expect("spawn capture lock").is_some() {
+                return;
+            }
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .expect("Parent should receive spawn output and request exact join");
+    timeout(
+        Duration::from_secs(5),
+        wait_for_event(&test.codex, |event| {
+            matches!(
+                event,
+                EventMsg::ItemStarted(event)
+                    if matches!(
+                        &event.item,
+                        TurnItem::CollabAgentToolCall(item)
+                            if item.id == join_call_id
+                                && item.tool == CollabAgentTool::Join
+                                && item.status == CollabAgentToolCallStatus::InProgress
+                    )
+            )
+        }),
+    )

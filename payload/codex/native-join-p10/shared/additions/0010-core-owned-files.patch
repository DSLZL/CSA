+            if spawned_run.lock().expect("spawn capture lock").is_some() {
+                return;
+            }
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .expect("Parent should receive spawn output and request exact join");
+    timeout(
+        Duration::from_secs(5),
+        wait_for_event(&test.codex, |event| {
+            matches!(
+                event,
+                EventMsg::ItemStarted(event)
+                    if matches!(
+                        &event.item,
+                        TurnItem::CollabAgentToolCall(item)
+                            if item.id == APPROVAL_JOIN_CALL_ID
+                                && item.tool == CollabAgentTool::Join
+                                && item.status == CollabAgentToolCallStatus::InProgress
+                    )
+            )
+        }),
+    )
+    .await
+    .expect("Join should remain pending while the child waits for approval");
+
+    let root_thread_id = test.session_configured.thread_id;
+    let child_thread_id = test
+        .thread_manager
+        .list_thread_ids()
+        .await
+        .into_iter()
+        .find(|thread_id| *thread_id != root_thread_id)
+        .expect("spawned child thread ID");
+    let child_thread = test.thread_manager.get_thread(child_thread_id).await?;
+    let approval = timeout(Duration::from_secs(20), async {
+        loop {
+            let event = child_thread
+                .next_event()
+                .await
+                .expect("child event stream should remain open");
+            match event.msg {
+                EventMsg::ExecApprovalRequest(approval) => return approval,
+                terminal @ (EventMsg::TurnComplete(_)
+                | EventMsg::TurnAborted(_)
+                | EventMsg::Error(_)) => {
+                    panic!("child became terminal before approval: {terminal:?}")
+                }
+                _ => {}
+            }
+        }
+    })
+    .await
+    .expect("child approval should remain live while Parent Join is pending");
+    assert_eq!(child_thread.agent_status().await, AgentStatus::Running);
+
+    let requests_while_pending = server
+        .received_requests()
+        .await
+        .expect("mock server should retain response requests")
+        .into_iter()
+        .filter(|request| request.url.path().ends_with("/responses"))
+        .collect::<Vec<_>>();
+    assert_eq!(requests_while_pending.len(), 3);
+    assert_eq!(
+        requests_while_pending
+            .iter()
+            .filter(|request| !request_is_subagent(request))
+            .count(),
+        2
+    );
+
+    child_thread
+        .submit(Op::ExecApproval {
+            id: approval.effective_approval_id(),
+            turn_id: None,
+            decision,
+        })
+        .await?;
+    timeout(
+        Duration::from_secs(10),
+        wait_for_event(&test.codex, |event| {
+            matches!(
+                event,
+                EventMsg::ItemCompleted(event)
+                    if matches!(
+                        &event.item,
+                        TurnItem::CollabAgentToolCall(item)
+                            if item.id == APPROVAL_JOIN_CALL_ID
+                                && item.tool == CollabAgentTool::Join
+                                && item.status == CollabAgentToolCallStatus::Completed
+                    )
+            )
+        }),
+    )
+    .await
+    .expect("terminal child run should resolve Join after approval decision");
+    timeout(
+        Duration::from_secs(5),
+        wait_for_event(&test.codex, |event| {
+            matches!(event, EventMsg::TurnComplete(_))
+        }),
+    )
+    .await
+    .expect("Join result should trigger one final Parent response");
+
+    let (_, run_id) = spawned_run
+        .lock()
+        .expect("spawn capture lock")
+        .clone()
+        .expect("spawn result should be captured");
+    let join_output = parent_after_join
+        .function_call_output_text(APPROVAL_JOIN_CALL_ID)
+        .expect("Parent continuation should contain approval Join result");
+    let join_output: serde_json::Value = serde_json::from_str(&join_output)?;
+    assert_eq!(join_output["run_id"], json!(run_id));
+    assert_eq!(join_output["status"], json!("completed"));
+    assert_eq!(join_output["output"], json!(child_output));
+
+    server.verify().await;
+    let requests = server
+        .received_requests()
+        .await
+        .expect("mock server should retain response requests")
+        .into_iter()
+        .filter(|request| request.url.path().ends_with("/responses"))
+        .collect::<Vec<_>>();
+    assert_eq!(requests.len(), 5);
+    assert_eq!(
+        requests
+            .iter()
+            .filter(|request| !request_is_subagent(request))
+            .count(),
+        3
+    );
+
+    Ok(())
+}

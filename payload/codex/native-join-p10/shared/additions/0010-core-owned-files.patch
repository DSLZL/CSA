@@ -0,0 +1,286 @@
+use std::collections::HashMap;
+use std::collections::hash_map::Entry;
+use std::sync::Arc;
+use std::sync::Mutex;
+
+use codex_protocol::ThreadId;
+use tokio::sync::watch;
+
+use crate::agent::AgentControl;
+
+#[derive(Clone, Debug, PartialEq, Eq, Hash)]
+pub(crate) struct AgentRunRef {
+    pub(crate) thread_id: ThreadId,
+    pub(crate) run_id: String,
+}
+
+impl AgentRunRef {
+    pub(crate) fn new(thread_id: ThreadId, run_id: String) -> Self {
+        Self { thread_id, run_id }
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum AgentRunPhase {
+    Running,
+    Terminal(Arc<AgentRunTerminal>),
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct AgentRunTerminal {
+    pub(crate) outcome: AgentRunOutcome,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum AgentRunOutcome {
+    Completed {
+        output: Option<String>,
+    },
+    Failed {
+        message: String,
+        reason: Option<String>,
+    },
+    Cancelled {
+        reason: String,
+    },
+}
+
+#[derive(Debug, thiserror::Error, PartialEq, Eq)]
+pub(crate) enum JoinError {
+    #[error("unknown agent run")]
+    UnknownRun,
+    #[error("agent run completion source closed")]
+    SourceClosed,
+    #[error("agent run completion invariant failed: {0}")]
+    #[allow(dead_code)]
+    Internal(String),
+}
+
+#[derive(Default)]
+pub(crate) struct AgentRunCompletionRegistry {
+    runs: Mutex<HashMap<AgentRunRef, watch::Sender<AgentRunPhase>>>,
+}
+
+impl AgentRunCompletionRegistry {
+    pub(crate) fn register_running(&self, target: AgentRunRef) {
+        let mut runs = self
+            .runs
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if let Entry::Vacant(entry) = runs.entry(target) {
+            tracing::debug!(
+                thread_id = %entry.key().thread_id,
+                run_id = %entry.key().run_id,
+                "agent run registered"
+            );
+            entry.insert(watch::channel(AgentRunPhase::Running).0);
+        }
+    }
+
+    pub(crate) fn complete(&self, target: AgentRunRef, terminal: Arc<AgentRunTerminal>) {
+        let mut runs = self
+            .runs
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let Some(sender) = runs.get(&target) else {
+            tracing::debug!(
+                thread_id = %target.thread_id,
+                run_id = %target.run_id,
+                outcome = terminal_outcome_name(terminal.as_ref()),
+                "agent run terminal receipt published before registration"
+            );
+            runs.insert(target, watch::channel(AgentRunPhase::Terminal(terminal)).0);
+            return;
+        };
+        let phase = sender.borrow().clone();
+        match phase {
+            AgentRunPhase::Running => {
+                tracing::debug!(
+                    thread_id = %target.thread_id,
+                    run_id = %target.run_id,
+                    outcome = terminal_outcome_name(terminal.as_ref()),
+                    "agent run terminal receipt published"
+                );
+                sender.send_replace(AgentRunPhase::Terminal(terminal));
+            }
+            AgentRunPhase::Terminal(existing) if existing == terminal => {
+                tracing::debug!(
+                    thread_id = %target.thread_id,
+                    run_id = %target.run_id,
+                    "duplicate agent run terminal receipt ignored"
+                );
+            }
+            AgentRunPhase::Terminal(_) => {
+                tracing::error!(
+                    thread_id = %target.thread_id,
+                    run_id = %target.run_id,
+                    "conflicting agent run terminal receipt ignored"
+                );
+            }
+        }
+    }
+
+    pub(crate) fn subscribe(
+        &self,
+        target: &AgentRunRef,
+    ) -> Result<watch::Receiver<AgentRunPhase>, JoinError> {
+        self.runs
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .get(target)
+            .map(watch::Sender::subscribe)
+            .ok_or(JoinError::UnknownRun)
+    }
+}
+
+fn terminal_outcome_name(terminal: &AgentRunTerminal) -> &'static str {
+    match &terminal.outcome {
+        AgentRunOutcome::Completed { .. } => "completed",
+        AgentRunOutcome::Failed { .. } => "failed",
+        AgentRunOutcome::Cancelled { .. } => "cancelled",
+    }
+}
+
+pub(crate) trait CompletionSource: Send + Sync {
+    fn subscribe(&self, target: &AgentRunRef) -> Result<watch::Receiver<AgentRunPhase>, JoinError>;
+}
+
+impl CompletionSource for AgentRunCompletionRegistry {
+    fn subscribe(&self, target: &AgentRunRef) -> Result<watch::Receiver<AgentRunPhase>, JoinError> {
+        AgentRunCompletionRegistry::subscribe(self, target)
+    }
+}
+
+impl CompletionSource for AgentControl {
+    fn subscribe(&self, target: &AgentRunRef) -> Result<watch::Receiver<AgentRunPhase>, JoinError> {
+        self.subscribe_run(target)
+    }
+}
+
+pub(crate) async fn join_one(
+    source: &dyn CompletionSource,
+    target: &AgentRunRef,
+) -> Result<Arc<AgentRunTerminal>, JoinError> {
+    let mut receiver = source.subscribe(target)?;
+    loop {
+        if let AgentRunPhase::Terminal(terminal) = receiver.borrow().clone() {
+            return Ok(terminal);
+        }
+        if receiver.changed().await.is_err() {
+            return match receiver.borrow().clone() {
+                AgentRunPhase::Terminal(terminal) => Ok(terminal),
+                AgentRunPhase::Running => Err(JoinError::SourceClosed),
+            };
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use tokio::time::Duration;
+    use tokio::time::timeout;
+
+    fn run(thread_id: ThreadId, run_id: &str) -> AgentRunRef {
+        AgentRunRef::new(thread_id, run_id.to_string())
+    }
+
+    fn completed(output: &str) -> Arc<AgentRunTerminal> {
+        Arc::new(AgentRunTerminal {
+            outcome: AgentRunOutcome::Completed {
+                output: Some(output.to_string()),
+            },
+        })
+    }
+
+    #[tokio::test]
+    async fn registry_is_monotonic_and_isolates_exact_runs() {
+        let registry = AgentRunCompletionRegistry::default();
+        let thread_id = ThreadId::new();
+        let first = run(thread_id, "run-1");
+        let second = run(thread_id, "run-2");
+        assert_eq!(
+            registry.subscribe(&first).err(),
+            Some(JoinError::UnknownRun)
+        );
+
+        registry.register_running(first.clone());
+        registry.register_running(second.clone());
+        let mut first_rx = registry.subscribe(&first).expect("known first run");
+        let second_rx = registry.subscribe(&second).expect("known second run");
+        assert_eq!(first_rx.borrow().clone(), AgentRunPhase::Running);
+
+        let first_terminal = completed("first");
+        registry.complete(first.clone(), Arc::clone(&first_terminal));
+        first_rx.changed().await.expect("first run should wake");
+        assert_eq!(
+            first_rx.borrow().clone(),
+            AgentRunPhase::Terminal(Arc::clone(&first_terminal))
+        );
+        assert_eq!(second_rx.borrow().clone(), AgentRunPhase::Running);
+
+        registry.register_running(first.clone());
+        registry.complete(first.clone(), Arc::clone(&first_terminal));
+        registry.complete(first.clone(), completed("conflict"));
+        assert_eq!(
+            registry
+                .subscribe(&first)
+                .expect("first run replay")
+                .borrow()
+                .clone(),
+            AgentRunPhase::Terminal(first_terminal)
+        );
+
+        let completed_before_registration = run(ThreadId::new(), "already-terminal");
+        let early_terminal = completed("early");
+        registry.complete(
+            completed_before_registration.clone(),
+            Arc::clone(&early_terminal),
+        );
+        registry.register_running(completed_before_registration.clone());
+        assert_eq!(
+            registry
+                .subscribe(&completed_before_registration)
+                .expect("early terminal replay")
+                .borrow()
+                .clone(),
+            AgentRunPhase::Terminal(early_terminal)
+        );
+    }
+
+    #[tokio::test]
+    async fn join_one_waits_replays_and_reports_source_close() {
+        let registry = Arc::new(AgentRunCompletionRegistry::default());
+        let target = run(ThreadId::new(), "run");
+        registry.register_running(target.clone());
+        let waiter = tokio::spawn({
+            let registry = Arc::clone(&registry);
+            let target = target.clone();
+            async move { join_one(registry.as_ref(), &target).await }
+        });
+        tokio::task::yield_now().await;
+        let terminal = completed("done");
+        registry.complete(target.clone(), Arc::clone(&terminal));
+        assert_eq!(waiter.await.expect("join task"), Ok(Arc::clone(&terminal)));
+        assert_eq!(join_one(registry.as_ref(), &target).await, Ok(terminal));
+
+        struct ClosedSource(watch::Receiver<AgentRunPhase>);
+        impl CompletionSource for ClosedSource {
+            fn subscribe(
+                &self,
+                _target: &AgentRunRef,
+            ) -> Result<watch::Receiver<AgentRunPhase>, JoinError> {
+                Ok(self.0.clone())
+            }
+        }
+        let (sender, receiver) = watch::channel(AgentRunPhase::Running);
+        drop(sender);
+        let closed = ClosedSource(receiver);
+        assert_eq!(
+            timeout(Duration::from_secs(1), join_one(&closed, &target))
+                .await
+                .expect("closed source should resolve"),
+            Err(JoinError::SourceClosed)
+        );
+    }
+}

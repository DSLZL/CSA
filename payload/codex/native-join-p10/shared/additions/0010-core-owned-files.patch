+++ b/codex-rs/core/src/tools/handlers/multi_agents_v2/join_many.rs
@@ -0,0 +1,133 @@
+use super::*;
+use crate::tools::handlers::multi_agents_spec::create_join_agents_tool_v2;
+use codex_tools::ToolSpec;
+use futures::future::join_all;
+use std::collections::HashSet;
+
+pub(crate) struct Handler;
+
+impl ToolExecutor<ToolInvocation> for Handler {
+    fn tool_name(&self) -> ToolName {
+        ToolName::plain("join_agents")
+    }
+
+    fn spec(&self) -> ToolSpec {
+        create_join_agents_tool_v2()
+    }
+
+    fn handle<'a>(&'a self, invocation: ToolInvocation) -> codex_tools::ToolExecutorFuture<'a>
+    where
+        ToolInvocation: 'a,
+    {
+        Box::pin(self.handle_call(invocation))
+    }
+}
+
+impl Handler {
+    async fn handle_call(
+        &self,
+        invocation: ToolInvocation,
+    ) -> Result<Box<dyn ToolOutput>, FunctionCallError> {
+        let ToolInvocation {
+            session,
+            turn,
+            payload,
+            call_id,
+            ..
+        } = invocation;
+        let arguments = function_arguments(payload)?;
+        let args: JoinAgentsArgs = parse_arguments(&arguments)?;
+        if args.runs.is_empty() {
+            return Err(FunctionCallError::RespondToModel(
+                "runs must contain at least one exact target/run_id pair".to_string(),
+            ));
+        }
+
+        let mut seen = HashSet::new();
+        let mut resolved = Vec::with_capacity(args.runs.len());
+        for run in args.runs {
+            let run = join::resolve_join_target(&session, &turn, run).await?;
+            let key = (run.agent_id, run.run_ref.run_id.clone());
+            if !seen.insert(key) {
+                return Err(FunctionCallError::RespondToModel(
+                    "runs must not contain duplicate target/run_id pairs".to_string(),
+                ));
+            }
+            resolved.push(run);
+        }
+
+        let receiver_thread_ids = resolved.iter().map(|run| run.agent_id).collect::<Vec<_>>();
+        session
+            .emit_turn_item_started(
+                &turn,
+                &TurnItem::CollabAgentToolCall(join::join_item(
+                    call_id.clone(),
+                    session.thread_id,
+                    receiver_thread_ids.clone(),
+                    CollabAgentToolCallStatus::InProgress,
+                )),
+            )
+            .await;
+
+        let joined = join_all(
+            resolved
+                .into_iter()
+                .map(|run| join::join_run(&session, &turn, run)),
+        )
+        .await;
+        let status = if joined.iter().all(Result::is_ok) {
+            CollabAgentToolCallStatus::Completed
+        } else {
+            CollabAgentToolCallStatus::Failed
+        };
+        session
+            .emit_turn_item_completed(
+                &turn,
+                TurnItem::CollabAgentToolCall(join::join_item(
+                    call_id,
+                    session.thread_id,
+                    receiver_thread_ids,
+                    status,
+                )),
+            )
+            .await;
+
+        let results = joined.into_iter().collect::<Result<Vec<_>, _>>()?;
+        Ok(boxed_tool_output(JoinAgentsResult { results }))
+    }
+}
+
+impl CoreToolRuntime for Handler {
+    fn matches_kind(&self, payload: &ToolPayload) -> bool {
+        matches!(payload, ToolPayload::Function { .. })
+    }
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct JoinAgentsArgs {
+    runs: Vec<join::JoinAgentArgs>,
+}
+
+#[derive(Debug, Serialize)]
+struct JoinAgentsResult {
+    results: Vec<join::JoinAgentResult>,
+}
+
+impl ToolOutput for JoinAgentsResult {
+    fn log_output(&self) -> String {
+        tool_output_json_text(self, "join_agents")
+    }
+
+    fn success_for_logging(&self) -> bool {
+        true
+    }
+
+    fn to_response_item(&self, call_id: &str, payload: &ToolPayload) -> ResponseInputItem {
+        tool_output_response_item(call_id, payload, self, Some(true), "join_agents")
+    }
+
+    fn code_mode_result(&self, _payload: &ToolPayload) -> JsonValue {
+        tool_output_code_mode_result(self, "join_agents")
+    }
+}

+pub(crate) struct SubagentLivePanelRenderable<'a> {
+    snapshot: LivePanelSnapshot<'a>,
+    screen_size: Size,
+    bottom_pane_height: u16,
+    color_enabled: bool,
+    animations_enabled: bool,
+    csa_graphics_enabled: bool,
+    frame: &'a RefCell<LivePanelFrame>,
+}
+
+impl<'a> SubagentLivePanelRenderable<'a> {
+    pub(crate) fn new(
+        snapshot: LivePanelSnapshot<'a>,
+        screen_size: Size,
+        bottom_pane_height: u16,
+        color_enabled: bool,
+        animations_enabled: bool,
+        csa_graphics_enabled: bool,
+        frame: &'a RefCell<LivePanelFrame>,
+    ) -> Self {
+        Self {
+            snapshot,
+            screen_size,
+            bottom_pane_height,
+            color_enabled,
+            animations_enabled,
+            csa_graphics_enabled,
+            frame,
+        }
+    }
+
+    fn panel_cap(&self) -> u16 {
+        let hard_cap = PANEL_HARD_CAP.min(self.screen_size.height / 3);
+        let safe_cap = self
+            .screen_size
+            .height
+            .saturating_sub(self.bottom_pane_height)
+            .saturating_sub(MIN_CONVERSATION_HEIGHT);
+        hard_cap.min(safe_cap)
+    }
+
+    fn plan(&self, width: u16) -> Option<PanelPlan> {
+        let panel_cap = self.panel_cap();
+        if panel_cap == 0 || self.snapshot.agents.is_empty() {
+            return None;
+        }
+
+        let full_height = self.snapshot.agents.iter().fold(0u16, |height, agent| {
+            height.saturating_add(agent_block_height(agent, /*recent_limit*/ 3))
+        });
+        if width >= FULL_MODE_MIN_WIDTH && panel_cap >= 4 && full_height <= panel_cap {
+            return Some(PanelPlan {
+                mode: LivePanelMode::Full,
+                height: full_height,
+                visible_count: self.snapshot.agents.len(),
+                hidden_count: 0,
+                show_footer: false,
+            });
+        }
+
+        if width >= COMPACT_MODE_MIN_WIDTH && panel_cap >= 3 {
+            let mut height = 0u16;
+            let mut visible_count = 0usize;
+            for (index, agent) in self.snapshot.agents.iter().enumerate() {
+                let block_height = agent_block_height(agent, /*recent_limit*/ 1);
+                let footer_height = u16::from(index + 1 < self.snapshot.agents.len());
+                if height
+                    .saturating_add(block_height)
+                    .saturating_add(footer_height)
+                    > panel_cap
+                {
+                    break;
+                }
+                height = height.saturating_add(block_height);
+                visible_count += 1;
+            }
+            let hidden_count = self.snapshot.agents.len().saturating_sub(visible_count);
+            let show_footer = hidden_count > 0 && height < panel_cap;
+            return Some(PanelPlan {
+                mode: LivePanelMode::Compact,
+                height: height.saturating_add(u16::from(show_footer)),
+                visible_count,
+                hidden_count,
+                show_footer,
+            });
+        }
+
+        Some(PanelPlan {
+            mode: LivePanelMode::Minimal,
+            height: 1,
+            visible_count: usize::from(self.snapshot.agents.len() == 1),
+            hidden_count: usize::from(self.snapshot.agents.len() != 1) * self.snapshot.agents.len(),
+            show_footer: false,
+        })
+    }
+
+    fn render_line(&self, line: Line<'static>, y: u16, area: Rect, buf: &mut Buffer) {
+        if y >= area.bottom() {
+            return;
+        }
+        let line = truncate_line_with_ellipsis_if_overflow(line, usize::from(area.width));
+        line.render(Rect::new(area.x, y, area.width, 1), buf);
+    }
+
+    fn render_agent_header(
+        &self,
+        agent: &LivePanelAgent<'_>,
+        y: u16,
+        area: Rect,
+        buf: &mut Buffer,
+        placements: &mut Vec<CsaOrbitPlacement>,
+    ) {
+        let use_csa_graphics =
+            self.animations_enabled && self.csa_graphics_enabled && agent.is_animating();
+        self.render_line(
+            agent_header_line(agent, self.color_enabled, use_csa_graphics),
+            y,
+            area,
+            buf,
+        );
+        if use_csa_graphics && area.width > 0 && y < area.bottom() {
+            buf[(area.x, y)].set_diff_option(CellDiffOption::Skip);
+            placements.push(CsaOrbitPlacement {
+                thread_id: agent.thread_id,
+                x: area.x,
+                y,
+                animation_started_at: agent.state.animation_started_at(),
+            });
+        }
+    }
+
+    fn render_full(
+        &self,
+        plan: PanelPlan,
+        area: Rect,
+        buf: &mut Buffer,
+    ) -> (Vec<(ThreadId, Rect)>, Vec<CsaOrbitPlacement>) {
+        let mut y = area.y;
+        let mut regions = Vec::with_capacity(plan.visible_count);
+        let mut placements = Vec::with_capacity(plan.visible_count);
+        for agent in self.snapshot.agents.iter().take(plan.visible_count) {
+            let block_start = y;
+            self.render_agent_header(agent, y, area, buf, &mut placements);
+            y = y.saturating_add(1);
+            if let Some(line) = terminal_line(agent.state, self.color_enabled) {
+                self.render_line(line, y, area, buf);
+                y = y.saturating_add(1);
+            } else {
+                let visible_count = agent.state.recent().len().min(3);
+                for (index, activity) in agent.state.recent().iter().take(visible_count).enumerate()
+                {
+                    self.render_line(
+                        activity_line(
+                            activity,
+                            /*is_last*/ index + 1 == visible_count,
+                            self.color_enabled,
+                        ),
+                        y,
+                        area,
+                        buf,
+                    );
+                    y = y.saturating_add(1);
+                }
+            }
+            regions.push((
+                agent.thread_id,
+                Rect::new(
+                    area.x,
+                    block_start,
+                    area.width,
+                    y.saturating_sub(block_start),
+                ),
+            ));
+        }
+        (regions, placements)
+    }
+
+    fn render_compact(
+        &self,
+        plan: PanelPlan,
+        area: Rect,
+        buf: &mut Buffer,
+    ) -> (Vec<(ThreadId, Rect)>, Vec<CsaOrbitPlacement>) {
+        let mut y = area.y;
+        let mut regions = Vec::with_capacity(plan.visible_count);
+        let mut placements = Vec::with_capacity(plan.visible_count);
+        for agent in self.snapshot.agents.iter().take(plan.visible_count) {
+            let block_start = y;
+            self.render_agent_header(agent, y, area, buf, &mut placements);
+            y = y.saturating_add(1);
+            if let Some(line) = terminal_line(agent.state, self.color_enabled) {
+                self.render_line(line, y, area, buf);
+                y = y.saturating_add(1);
+            } else if let Some(activity) = agent.state.recent().back() {
+                self.render_line(
+                    activity_line(activity, /*is_last*/ true, self.color_enabled),
+                    y,
+                    area,
+                    buf,
+                );
+                y = y.saturating_add(1);
+            }
+            regions.push((
+                agent.thread_id,
+                Rect::new(
+                    area.x,
+                    block_start,
+                    area.width,
+                    y.saturating_sub(block_start),
+                ),
+            ));
+        }
+        if plan.show_footer {
+            self.render_line(
+                overflow_line(
+                    plan.hidden_count,
+                    waiting_approval_count(&self.snapshot.agents),
+                ),
+                y,
+                area,
+                buf,
+            );
+        }
+        (regions, placements)
+    }
+
+    fn render_minimal(&self, area: Rect, buf: &mut Buffer) -> Vec<(ThreadId, Rect)> {
+        self.render_line(minimal_line(&self.snapshot.agents), area.y, area, buf);
+        if self.snapshot.agents.len() == 1 {
+            vec![(
+                self.snapshot.agents[0].thread_id,
+                Rect::new(area.x, area.y, area.width, 1),
+            )]
+        } else {
+            Vec::new()
+        }
+    }
+}
+
+impl Renderable for SubagentLivePanelRenderable<'_> {
+    fn render(&self, area: Rect, buf: &mut Buffer) {
+        let Some(plan) = self.plan(area.width) else {
+            self.frame.borrow_mut().clear();
+            return;
+        };
+        if area.is_empty() {
+            self.frame.borrow_mut().clear();
+            return;
+        }
+
+        let panel_rect = Rect::new(area.x, area.y, area.width, area.height.min(plan.height));
+        Clear.render(panel_rect, buf);
+        let (regions, csa_orbit_placements) = match plan.mode {
+            LivePanelMode::Full => self.render_full(plan, panel_rect, buf),
+            LivePanelMode::Compact => self.render_compact(plan, panel_rect, buf),
+            LivePanelMode::Minimal => (self.render_minimal(panel_rect, buf), Vec::new()),
+        };
+        self.frame.borrow_mut().publish(
+            self.screen_size,
+            self.snapshot.state_revision,
+            panel_rect,
+            plan.mode,
+            plan.hidden_count,
+            regions,
+            csa_orbit_placements,
+        );
+    }
+
+    fn desired_height(&self, width: u16) -> u16 {
+        self.plan(width).map_or(0, |plan| plan.height)
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+struct PanelPlan {
+    mode: LivePanelMode,
+    height: u16,
+    visible_count: usize,
+    hidden_count: usize,
+    show_footer: bool,
+}
+
+fn agent_block_height(agent: &LivePanelAgent<'_>, recent_limit: usize) -> u16 {
+    let details = if matches!(
+        agent.state.lifecycle(),
+        LiveAgentStatus::Failed | LiveAgentStatus::Cancelled | LiveAgentStatus::Completed
+    ) {
+        1
+    } else {
+        agent.state.recent().len().min(recent_limit)
+    };
+    1u16.saturating_add(u16::try_from(details).unwrap_or(u16::MAX))
+}
+
+fn agent_header_line(
+    agent: &LivePanelAgent<'_>,
+    color_enabled: bool,
+    use_csa_graphics: bool,
+) -> Line<'static> {
+    let lifecycle = agent.state.lifecycle();
+    let mut symbol: Span<'static> = if use_csa_graphics {
+        " ".into()
+    } else {
+        match lifecycle {
+            LiveAgentStatus::Starting | LiveAgentStatus::Running => "◌".dim(),
+            LiveAgentStatus::WaitingApproval => "!".into(),
+            LiveAgentStatus::Waiting => "◌".into(),
+            LiveAgentStatus::Failed => "✗".into(),
+            LiveAgentStatus::Cancelled => "×".into(),
+            LiveAgentStatus::Completed => "✓".into(),
+        }
+    };
+    if color_enabled {
+        symbol = match lifecycle {
+            LiveAgentStatus::Starting | LiveAgentStatus::Running | LiveAgentStatus::Completed => {
+                symbol
+            }
+            LiveAgentStatus::WaitingApproval => symbol.bold(),
+            LiveAgentStatus::Waiting => symbol.dim(),
+            LiveAgentStatus::Failed | LiveAgentStatus::Cancelled => symbol.red(),
+        };
+    }
+    let mut spans = vec![
+        symbol,
+        " ".into(),
+        sanitized_single_line(&agent.label).bold(),
+    ];
+    if spans[2].content.is_empty() {
+        spans[2] = "Agent".bold();
+    }
+    if let Some(state_word) = match lifecycle {
+        LiveAgentStatus::WaitingApproval => Some("waiting approval"),
+        LiveAgentStatus::Waiting => Some("waiting"),
+        _ => None,
+    } {
+        spans.push("  ".into());
+        spans.push(status_span(state_word, lifecycle, color_enabled));
+    }
+    Line::from(spans)
+}
+
+fn activity_line(
+    activity: &crate::app::WorkActivityInput,
+    is_last: bool,
+    color_enabled: bool,
+) -> Line<'static> {
+    let label = sanitized_single_line(&activity.label);
+    let (action, detail) = label.split_once(' ').unwrap_or((label.as_str(), ""));
+    let mut spans = vec![
+        if is_last {
+            "└─".dim()
+        } else {
+            "├─".dim()
+        },
+        activity_status_span(
+            activity_status_symbol(activity.status),
+            activity.status,
+            color_enabled,
+        ),
+        " ".into(),
+        action.to_string().bold(),
+    ];
+    if !detail.is_empty() {
+        spans.push(" ".into());
+        spans.push(detail.to_string().dim());
+    }
+    if activity.status == ActivityStatus::WaitingApproval {
+        spans.push("  waiting approval".dim());
+    }
+    Line::from(spans)
+}
+
+fn terminal_line(state: &LiveAgentState, color_enabled: bool) -> Option<Line<'static>> {
+    let label = match state.lifecycle() {
+        LiveAgentStatus::Completed => "Done",
+        LiveAgentStatus::Failed => "Failed",
+        LiveAgentStatus::Cancelled => "Cancelled",
+        _ => return None,
+    };
+    let mut status = Span::raw(label);
+    if color_enabled {
+        status = match state.lifecycle() {
+            LiveAgentStatus::Completed => status.green().bold(),
+            LiveAgentStatus::Failed | LiveAgentStatus::Cancelled => status.red().bold(),
+            _ => status,
+        };
+    }
+    let mut spans = vec!["└─ ".dim(), status];
+    if let Some(stats) = state.terminal_stats() {
+        spans.push(format!(" ({})", format_terminal_stats(stats)).dim());
+    }
+    Some(Line::from(spans))
+}
+
+fn format_terminal_stats(stats: crate::app::LiveAgentStats) -> String {
+    let tool_uses = if stats.tool_uses == 1 {
+        "1 tool use".to_string()
+    } else {
+        format!("{} tool uses", stats.tool_uses)
+    };
+    format!(
+        "{tool_uses} ⋅ {} tokens ⋅ {}",
+        format_tokens(stats.tokens),
+        format_duration(stats.duration)
+    )
+}
+
+fn format_tokens(tokens: i64) -> String {
+    let tokens = tokens.max(0) as f64;
+    if tokens < 1_000.0 {
+        return (tokens as i64).to_string();
+    }
+    if tokens < 1_000_000.0 {
+        return format!("{:.1}k", tokens / 1_000.0);
+    }
+    if tokens < 1_000_000_000.0 {
+        return format!("{:.1}m", tokens / 1_000_000.0);
+    }
+    format!("{:.1}b", tokens / 1_000_000_000.0)
+}
+
+fn format_duration(duration: std::time::Duration) -> String {
+    let tenths = duration.as_millis() / 100;
+    let hours = tenths / 36_000;
+    let minutes = (tenths / 600) % 60;
+    let seconds = (tenths / 10) % 60;
+    let decimal = tenths % 10;
+    if hours > 0 {
+        format!("{hours}h {minutes}m {seconds}.{decimal}s")
+    } else if minutes > 0 {
+        format!("{minutes}m {seconds}.{decimal}s")
+    } else {
+        format!("{seconds}.{decimal}s")
+    }
+}
+
+fn overflow_line(hidden_count: usize, waiting_approval: usize) -> Line<'static> {
+    let waiting = if waiting_approval == 0 {
+        String::new()
+    } else {
+        format!(" · {waiting_approval} waiting approval")
+    };
+    format!("… +{hidden_count} more{waiting} · /subagents")
+        .dim()
+        .into()
+}
+
+fn minimal_line(agents: &[LivePanelAgent<'_>]) -> Line<'static> {
+    let waiting = waiting_approval_count(agents);
+    let failed = agents
+        .iter()
+        .filter(|agent| agent.state.lifecycle() == LiveAgentStatus::Failed)
+        .count();
+    let cancelled = agents
+        .iter()
+        .filter(|agent| agent.state.lifecycle() == LiveAgentStatus::Cancelled)
+        .count();
+    let symbol = if waiting > 0 {
+        "!"
+    } else if failed > 0 {
+        "✗"
+    } else if cancelled > 0 {
+        "×"
+    } else {
+        "●"
+    };
+    let noun = if agents.len() == 1 {
+        "subagent"
+    } else {
+        "subagents"
+    };
+    let mut text = format!("{symbol} {} {noun}", agents.len());
+    if waiting > 0 {
+        text.push_str(&format!(" · {waiting} waiting approval"));
+    }
+    if failed > 0 {
+        text.push_str(&format!(" · {failed} failed"));
+    }
+    if cancelled > 0 {
+        text.push_str(&format!(" · {cancelled} cancelled"));
+    }
+    text.push_str(" · /subagents");
+    text.into()
+}
+
+fn waiting_approval_count(agents: &[LivePanelAgent<'_>]) -> usize {
+    agents
+        .iter()
+        .filter(|agent| agent.state.lifecycle() == LiveAgentStatus::WaitingApproval)
+        .count()
+}
+
+fn sanitized_single_line(value: &str) -> String {
+    sanitize_user_text(Cow::Borrowed(value))
+        .split_whitespace()
+        .collect::<Vec<_>>()
+        .join(" ")
+}
+
+fn activity_status_symbol(status: ActivityStatus) -> &'static str {
+    match status {
+        ActivityStatus::Running => "›",
+        ActivityStatus::WaitingApproval => "!",
+        ActivityStatus::Succeeded => "✓",
+        ActivityStatus::Failed => "✗",
+        ActivityStatus::Declined | ActivityStatus::Cancelled => "×",
+    }
+}
+
+fn status_span(text: &'static str, status: LiveAgentStatus, color_enabled: bool) -> Span<'static> {
+    let span = Span::raw(text);
+    if !color_enabled {
+        return span;
+    }
+    match status {
+        LiveAgentStatus::Starting | LiveAgentStatus::Waiting => span.dim(),
+        LiveAgentStatus::Running | LiveAgentStatus::Completed => span.green(),
+        LiveAgentStatus::WaitingApproval => span.bold(),
+        LiveAgentStatus::Failed | LiveAgentStatus::Cancelled => span.red(),
+    }
+}
+
+fn activity_status_span(
+    text: &'static str,
+    status: ActivityStatus,
+    color_enabled: bool,
+) -> Span<'static> {
+    let span = Span::raw(text);
+    if !color_enabled {
+        return span;
+    }
+    match status {
+        ActivityStatus::Running | ActivityStatus::Succeeded => span.green(),
+        ActivityStatus::WaitingApproval => span.bold(),
+        ActivityStatus::Failed | ActivityStatus::Declined | ActivityStatus::Cancelled => span.red(),
+    }
+}

+        fn render_with_frame_and_animations(
+            &self,
+            screen_size: Size,
+            bottom_pane_height: u16,
+            color_enabled: bool,
+            animations_enabled: bool,
+            csa_graphics_enabled: bool,
+            frame: &RefCell<LivePanelFrame>,
+        ) -> (String, Buffer, u16) {
+            let now = Instant::now();
+            let agents = self
+                .agents
+                .iter()
+                .filter_map(|(thread_id, label)| {
+                    self.state
+                        .agent(*thread_id)
+                        .filter(|state| state.is_renderable_at(now))
+                        .map(|state| LivePanelAgent::new(*thread_id, label.clone(), state))
+                })
+                .collect();
+            let snapshot = LivePanelSnapshot::new(self.state.revision(), agents);
+            let panel = SubagentLivePanelRenderable::new(
+                snapshot,
+                screen_size,
+                bottom_pane_height,
+                color_enabled,
+                animations_enabled,
+                csa_graphics_enabled,
+                frame,
+            );
+            let desired_height = panel.desired_height(screen_size.width);
+            let area = Rect::new(0, 0, screen_size.width, desired_height);
+            let mut buffer = Buffer::empty(area);
+            panel.render(area, &mut buffer);
+            let text = buffer_text(&buffer);
+            (text, buffer, desired_height)
+        }
+    }
+
+    fn buffer_text(buffer: &Buffer) -> String {
+        (0..buffer.area.height)
+            .map(|row| {
+                let mut line = String::new();
+                let mut column = 0;
+                while column < buffer.area.width {
+                    let symbol = buffer[(column, row)].symbol();
+                    line.push_str(symbol);
+                    column = column.saturating_add(
+                        u16::try_from(unicode_width::UnicodeWidthStr::width(symbol).max(1))
+                            .unwrap_or(1),
+                    );
+                }
+                line.trim_end().to_string()
+            })
+            .collect::<Vec<_>>()
+            .join("\n")
+    }

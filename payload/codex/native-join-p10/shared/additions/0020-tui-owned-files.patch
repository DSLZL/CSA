+//! Pure projection of the current sub-agent activity batch.
+//!
+//! Navigation order and display metadata remain owned by `AgentNavigationState`; this module
+//! stores only the active batch's lifecycle and compact activity records.
+
+use super::agent_status_feed::ActivityPhase;
+use super::agent_status_feed::ActivityStatus;
+use super::agent_status_feed::ActivitySummary;
+use super::agent_status_feed::WorkActivityInput;
+use super::agent_status_feed::classify_activity;
+use codex_app_server_protocol::ServerNotification;
+use codex_app_server_protocol::ServerRequest;
+use codex_app_server_protocol::TurnStatus;
+use codex_protocol::ThreadId;
+use std::collections::HashMap;
+use std::collections::HashSet;
+use std::collections::VecDeque;
+use std::time::Duration;
+use std::time::Instant;
+
+pub(crate) const RECENT_ACTIVITY_LIMIT: usize = 3;
+
+pub(crate) type RecentActivity = WorkActivityInput;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum LiveAgentStatus {
+    #[allow(dead_code)] // Authoritative hydration can expose this state as sources become richer.
+    Starting,
+    Running,
+    WaitingApproval,
+    #[allow(dead_code)] // Authoritative hydration can expose this state as sources become richer.
+    Waiting,
+    Failed,
+    Cancelled,
+    Completed,
+}
+
+impl LiveAgentStatus {
+    fn is_terminal(self) -> bool {
+        matches!(self, Self::Failed | Self::Cancelled | Self::Completed)
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) struct LiveAgentStats {
+    pub(crate) tool_uses: usize,
+    pub(crate) tokens: i64,
+    pub(crate) duration: Duration,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+struct ApprovalRef {
+    request_id: String,
+    item_id: Option<String>,
+    previous_agent_status: LiveAgentStatus,
+    previous_activity_status: Option<ActivityStatus>,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) struct LiveAgentState {
+    lifecycle: LiveAgentStatus,
+    recent: VecDeque<RecentActivity>,
+    open_approval: Option<ApprovalRef>,
+    animation_started_at: Instant,
+    turn_started_at: Option<Instant>,
+    tool_uses_started: usize,
+    total_tokens: i64,
+    tokens_at_turn_start: i64,
+    terminal_stats: Option<LiveAgentStats>,
+}
+
+impl LiveAgentState {
+    fn new(lifecycle: LiveAgentStatus, now: Instant) -> Self {
+        Self {
+            lifecycle,
+            recent: VecDeque::with_capacity(RECENT_ACTIVITY_LIMIT),
+            open_approval: None,
+            animation_started_at: now,
+            turn_started_at: (lifecycle != LiveAgentStatus::Starting).then_some(now),
+            tool_uses_started: 0,
+            total_tokens: 0,
+            tokens_at_turn_start: 0,
+            terminal_stats: None,
+        }
+    }
+
+    pub(crate) fn lifecycle(&self) -> LiveAgentStatus {
+        self.lifecycle
+    }
+
+    pub(crate) fn recent(&self) -> &VecDeque<RecentActivity> {
+        &self.recent
+    }
+
+    pub(crate) fn animation_started_at(&self) -> Instant {
+        self.animation_started_at
+    }
+
+    pub(crate) fn terminal_stats(&self) -> Option<LiveAgentStats> {
+        self.terminal_stats
+    }
+
+    pub(crate) fn is_renderable_at(&self, _now: Instant) -> bool {
+        true
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum LiveStateChange {
+    Unchanged,
+    Changed,
+}
+
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub(crate) struct SubagentLiveTelemetry {
+    events_reduced: u64,
+    duplicate_events: u64,
+    conflicting_terminal_events: u64,
+}
+
+#[derive(Debug, Default)]
+pub(crate) struct SubagentLiveState {
+    agents: HashMap<ThreadId, LiveAgentState>,
+    archived_agents: HashSet<ThreadId>,
+    revision: u64,
+    telemetry: SubagentLiveTelemetry,
+}
+
+impl SubagentLiveState {
+    pub(crate) fn revision(&self) -> u64 {
+        self.revision
+    }
+
+    pub(crate) fn agent(&self, thread_id: ThreadId) -> Option<&LiveAgentState> {
+        self.agents.get(&thread_id)
+    }
+
+    #[cfg(test)]
+    pub(crate) fn telemetry(&self) -> SubagentLiveTelemetry {
+        self.telemetry
+    }
+
+    pub(crate) fn has_renderable_rows_at(&self, now: Instant) -> bool {
+        self.agents
+            .values()
+            .any(|agent| agent.is_renderable_at(now))
+    }
+
+    pub(crate) fn ensure_started(&mut self, thread_id: ThreadId, now: Instant) -> LiveStateChange {
+        self.telemetry.events_reduced = self.telemetry.events_reduced.saturating_add(1);
+        if self.agents.contains_key(&thread_id) {
+            self.telemetry.duplicate_events = self.telemetry.duplicate_events.saturating_add(1);
+            return LiveStateChange::Unchanged;
+        }
+        self.archived_agents.remove(&thread_id);
+        self.agents.insert(
+            thread_id,
+            LiveAgentState::new(LiveAgentStatus::Starting, now),
+        );
+        self.finish_change(true)
+    }
+
+    #[cfg(test)]
+    pub(crate) fn retained_activity_count(&self) -> usize {
+        self.agents.values().map(|agent| agent.recent.len()).sum()
+    }
+
+    pub(super) fn reduce_notification(
+        &mut self,
+        thread_id: ThreadId,
+        notification: &ServerNotification,
+        now: Instant,
+    ) -> LiveStateChange {
+        match notification {
+            ServerNotification::ItemStarted(notification) => self.reduce_summary_at(
+                thread_id,
+                classify_activity(&notification.item, ActivityPhase::Started),
+                now,
+            ),
+            ServerNotification::ItemCompleted(notification) => self.reduce_summary_at(
+                thread_id,
+                classify_activity(&notification.item, ActivityPhase::Completed),
+                now,
+            ),
+            ServerNotification::TurnStarted(_) => self.start_turn(thread_id, now),
+            ServerNotification::ThreadTokenUsageUpdated(notification) => {
+                self.set_total_tokens(thread_id, notification.token_usage.total.total_tokens, now)
+            }
+            ServerNotification::TurnCompleted(notification) => {
+                self.finish_turn(thread_id, &notification.turn, now)
+            }
+            ServerNotification::ThreadClosed(_) => self.remove_agent(thread_id),
+            ServerNotification::ServerRequestResolved(notification) => {
+                self.resolve_approval(thread_id, &notification.request_id.to_string())
+            }
+            _ => LiveStateChange::Unchanged,
+        }
+    }
+
+    pub(super) fn reduce_request(
+        &mut self,
+        thread_id: ThreadId,
+        request: &ServerRequest,
+    ) -> LiveStateChange {
+        let item_id = match request {
+            ServerRequest::CommandExecutionRequestApproval { params, .. } => {
+                Some(params.item_id.clone())
+            }
+            ServerRequest::FileChangeRequestApproval { params, .. } => Some(params.item_id.clone()),
+            ServerRequest::McpServerElicitationRequest { .. } => None,
+            ServerRequest::PermissionsRequestApproval { params, .. } => {
+                Some(params.item_id.clone())
+            }
+            ServerRequest::ToolRequestUserInput { .. }
+            | ServerRequest::DynamicToolCall { .. }
+            | ServerRequest::ChatgptAuthTokensRefresh { .. }
+            | ServerRequest::AttestationGenerate { .. }
+            | ServerRequest::CurrentTimeRead { .. }
+            | ServerRequest::ApplyPatchApproval { .. }
+            | ServerRequest::ExecCommandApproval { .. } => return LiveStateChange::Unchanged,
+        };
+        self.mark_waiting_approval(thread_id, request.id().to_string(), item_id)
+    }
+
+    #[cfg(test)]
+    pub(super) fn reduce_summary(
+        &mut self,
+        thread_id: ThreadId,
+        summary: Option<ActivitySummary>,
+    ) -> LiveStateChange {
+        self.reduce_summary_at(thread_id, summary, Instant::now())
+    }
+
+    fn reduce_summary_at(
+        &mut self,
+        thread_id: ThreadId,
+        summary: Option<ActivitySummary>,
+        now: Instant,
+    ) -> LiveStateChange {
+        match summary {
+            Some(ActivitySummary::Work(activity)) => {
+                self.reduce_activity_at(thread_id, activity, now)
+            }
+            Some(ActivitySummary::Other(_)) | None => LiveStateChange::Unchanged,
+        }
+    }
+
+    #[cfg(test)]
+    pub(crate) fn reduce_activity(
+        &mut self,
+        thread_id: ThreadId,
+        activity: WorkActivityInput,
+    ) -> LiveStateChange {
+        self.reduce_activity_at(thread_id, activity, Instant::now())
+    }
+
+    fn reduce_activity_at(
+        &mut self,
+        thread_id: ThreadId,
+        activity: WorkActivityInput,
+        now: Instant,
+    ) -> LiveStateChange {
+        self.telemetry.events_reduced = self.telemetry.events_reduced.saturating_add(1);
+
+        if self.archived_agents.contains(&thread_id) {
+            self.telemetry.duplicate_events = self.telemetry.duplicate_events.saturating_add(1);
+            return LiveStateChange::Unchanged;
+        }
+
+        if self
+            .agents
+            .get(&thread_id)
+            .is_some_and(|agent| agent.lifecycle.is_terminal())
+        {
+            self.telemetry.duplicate_events = self.telemetry.duplicate_events.saturating_add(1);
+            return LiveStateChange::Unchanged;
+        }
+
+        let mut changed = false;
+        let mut duplicate = false;
+        let mut conflict = false;
+        let agent = self.agents.entry(thread_id).or_insert_with(|| {
+            changed = true;
+            LiveAgentState::new(LiveAgentStatus::Running, now)
+        });
+        begin_turn_if_needed(agent, now);
+
+        if let Some(approval) = agent
+            .open_approval
+            .take_if(|approval| approval.item_id.as_deref() == Some(activity.id.as_str()))
+        {
+            if agent.lifecycle == LiveAgentStatus::WaitingApproval {
+                agent.lifecycle = approval.previous_agent_status;
+            }
+            changed = true;
+        }
+
+        if let Some(existing) = agent
+            .recent
+            .iter_mut()
+            .find(|existing| existing.id == activity.id)
+        {
+            if activity_status_is_terminal(existing.status) {
+                if activity_status_is_terminal(activity.status)
+                    && existing.status != activity.status
+                {
+                    conflict = true;
+                } else {
+                    duplicate = true;
+                }
+            } else if *existing == activity {
+                duplicate = true;
+            } else {
+                *existing = activity;
+                changed = true;
+            }
+        } else {
+            if activity.status == ActivityStatus::Running {
+                agent.tool_uses_started = agent.tool_uses_started.saturating_add(1);
+            }
+            if agent.recent.len() == RECENT_ACTIVITY_LIMIT
+                && let Some(evicted) = agent.recent.pop_front()
+                && let Some(approval) = agent.open_approval.as_mut()
+                && approval.item_id.as_deref() == Some(evicted.id.as_str())
+            {
+                approval.previous_activity_status = None;
+            }
+            agent.recent.push_back(activity);
+            changed = true;
+        }
+
+        if agent.open_approval.is_none()
+            && matches!(
+                agent.lifecycle,
+                LiveAgentStatus::Starting
+                    | LiveAgentStatus::Waiting
+                    | LiveAgentStatus::WaitingApproval
+            )
+        {
+            agent.lifecycle = LiveAgentStatus::Running;
+            changed = true;
+        }
+
+        if duplicate {
+            self.telemetry.duplicate_events = self.telemetry.duplicate_events.saturating_add(1);
+        }
+        if conflict {
+            self.telemetry.conflicting_terminal_events =
+                self.telemetry.conflicting_terminal_events.saturating_add(1);
+        }
+        self.finish_change(changed)
+    }
+
+    fn start_turn(&mut self, thread_id: ThreadId, now: Instant) -> LiveStateChange {
+        self.telemetry.events_reduced = self.telemetry.events_reduced.saturating_add(1);
+        self.archived_agents.remove(&thread_id);
+        let Some(agent) = self.agents.get_mut(&thread_id) else {
+            self.agents.insert(
+                thread_id,
+                LiveAgentState::new(LiveAgentStatus::Running, now),
+            );
+            return self.finish_change(true);
+        };
+        match agent.lifecycle {
+            LiveAgentStatus::Starting => {
+                agent.lifecycle = LiveAgentStatus::Running;
+                begin_turn_if_needed(agent, now);
+                agent.terminal_stats = None;
+                return self.finish_change(true);
+            }
+            LiveAgentStatus::Running
+            | LiveAgentStatus::Waiting
+            | LiveAgentStatus::WaitingApproval => {
+                self.telemetry.duplicate_events = self.telemetry.duplicate_events.saturating_add(1);
+                return LiveStateChange::Unchanged;
+            }
+            LiveAgentStatus::Failed | LiveAgentStatus::Cancelled | LiveAgentStatus::Completed => {}
+        }
+        agent.lifecycle = LiveAgentStatus::Running;
+        agent.recent.clear();
+        agent.open_approval = None;
+        agent.animation_started_at = now;
+        agent.turn_started_at = Some(now);
+        agent.tool_uses_started = 0;
+        agent.tokens_at_turn_start = agent.total_tokens;
+        agent.terminal_stats = None;
+        self.finish_change(true)
+    }
+
+    fn set_total_tokens(
+        &mut self,
+        thread_id: ThreadId,
+        total_tokens: i64,
+        now: Instant,
+    ) -> LiveStateChange {
+        if self.archived_agents.contains(&thread_id) {
+            self.telemetry.duplicate_events = self.telemetry.duplicate_events.saturating_add(1);
+            return LiveStateChange::Unchanged;
+        }
+        let total_tokens = total_tokens.max(0);
+        let agent = self
+            .agents
+            .entry(thread_id)
+            .or_insert_with(|| LiveAgentState::new(LiveAgentStatus::Running, now));
+        let mut changed = agent.total_tokens != total_tokens;
+        agent.total_tokens = total_tokens;
+        let turn_tokens = current_turn_tokens(agent);
+        if let Some(stats) = agent.terminal_stats.as_mut()
+            && stats.tokens != turn_tokens
+        {
+            stats.tokens = turn_tokens;
+            changed = true;
+        }
+        self.finish_change(changed)
+    }
+
+    fn finish_turn(
+        &mut self,
+        thread_id: ThreadId,
+        turn: &codex_app_server_protocol::Turn,
+        now: Instant,
+    ) -> LiveStateChange {
+        if self.archived_agents.contains(&thread_id) {
+            self.telemetry.duplicate_events = self.telemetry.duplicate_events.saturating_add(1);
+            return LiveStateChange::Unchanged;
+        }
+        let status = match turn.status {
+            TurnStatus::Completed => LiveAgentStatus::Completed,
+            TurnStatus::Interrupted => LiveAgentStatus::Cancelled,
+            TurnStatus::Failed => LiveAgentStatus::Failed,
+            TurnStatus::InProgress => {
+                return self.set_agent_status(thread_id, LiveAgentStatus::Running, now);
+            }
+        };
+        let agent = self
+            .agents
+            .entry(thread_id)
+            .or_insert_with(|| LiveAgentState::new(LiveAgentStatus::Running, now));
+        let classified_tool_uses = turn
+            .items
+            .iter()
+            .filter(|item| {
+                matches!(
+                    classify_activity(item, ActivityPhase::Completed),
+                    Some(ActivitySummary::Work(_))
+                )
+            })
+            .count();
+        let stats = LiveAgentStats {
+            tool_uses: if classified_tool_uses == 0 {
+                agent.tool_uses_started
+            } else {
+                classified_tool_uses
+            },
+            tokens: current_turn_tokens(agent),
+            duration: turn
+                .duration_ms
+                .and_then(|duration_ms| u64::try_from(duration_ms).ok())
+                .map(Duration::from_millis)
+                .unwrap_or_else(|| {
+                    now.saturating_duration_since(
+                        agent.turn_started_at.unwrap_or(agent.animation_started_at),
+                    )
+                }),
+        };
+        self.set_terminal(thread_id, status, now, Some(stats))
+    }
+
+    pub(crate) fn set_agent_status(
+        &mut self,
+        thread_id: ThreadId,
+        status: LiveAgentStatus,
+        now: Instant,
+    ) -> LiveStateChange {
+        self.telemetry.events_reduced = self.telemetry.events_reduced.saturating_add(1);
+        if status.is_terminal() {
+            return self.set_terminal(thread_id, status, now, /*stats*/ None);
+        }
+
+        if let Some(agent) = self.agents.get_mut(&thread_id) {
+            if agent.lifecycle.is_terminal() {
+                self.telemetry.duplicate_events = self.telemetry.duplicate_events.saturating_add(1);
+                return LiveStateChange::Unchanged;
+            }
+            if status != LiveAgentStatus::Starting {
+                begin_turn_if_needed(agent, now);
+            }
+            let changed = if let Some(approval) = agent.open_approval.as_mut() {
+                let changed = approval.previous_agent_status != status;
+                approval.previous_agent_status = status;
+                changed
+            } else if agent.lifecycle != status {
+                agent.lifecycle = status;
+                true
+            } else {
+                self.telemetry.duplicate_events = self.telemetry.duplicate_events.saturating_add(1);
+                false
+            };
+            return self.finish_change(changed);
+        }
+
+        self.agents
+            .insert(thread_id, LiveAgentState::new(status, now));
+        self.finish_change(true)
+    }
+
+    #[cfg(test)]
+    pub(crate) fn set_terminal_stats_for_test(
+        &mut self,
+        thread_id: ThreadId,
+        status: LiveAgentStatus,
+        now: Instant,
+        stats: LiveAgentStats,
+    ) -> LiveStateChange {
+        self.set_terminal(thread_id, status, now, Some(stats))
+    }
+
+    pub(crate) fn mark_waiting_approval(
+        &mut self,
+        thread_id: ThreadId,
+        request_id: String,
+        item_id: Option<String>,
+    ) -> LiveStateChange {
+        self.telemetry.events_reduced = self.telemetry.events_reduced.saturating_add(1);
+        if self.archived_agents.contains(&thread_id) {
+            self.telemetry.duplicate_events = self.telemetry.duplicate_events.saturating_add(1);
+            return LiveStateChange::Unchanged;
+        }
+        if self
+            .agents
+            .get(&thread_id)
+            .is_some_and(|agent| agent.lifecycle.is_terminal())
+        {
+            self.telemetry.duplicate_events = self.telemetry.duplicate_events.saturating_add(1);
+            return LiveStateChange::Unchanged;
+        }
+
+        let agent = self
+            .agents
+            .entry(thread_id)
+            .or_insert_with(|| LiveAgentState::new(LiveAgentStatus::Running, Instant::now()));
+        if agent.open_approval.as_ref().is_some_and(|approval| {
+            approval.request_id == request_id && approval.item_id == item_id
+        }) {
+            self.telemetry.duplicate_events = self.telemetry.duplicate_events.saturating_add(1);
+            return LiveStateChange::Unchanged;
+        }
+
+        let previous_agent_status = if let Some(previous) = agent.open_approval.take() {
+            restore_approval_activity(agent, &previous);
+            previous.previous_agent_status
+        } else if agent.lifecycle == LiveAgentStatus::WaitingApproval {
+            LiveAgentStatus::Running
+        } else {
+            agent.lifecycle
+        };
+        let previous_activity_status = item_id.as_deref().and_then(|item_id| {
+            let activity = agent.recent.iter_mut().find(|activity| {
+                activity.id == item_id && !activity_status_is_terminal(activity.status)
+            })?;
+            let previous = activity.status;
+            activity.status = ActivityStatus::WaitingApproval;
+            Some(previous)
+        });
+        agent.lifecycle = LiveAgentStatus::WaitingApproval;
+        agent.open_approval = Some(ApprovalRef {
+            request_id,
+            item_id,
+            previous_agent_status,
+            previous_activity_status,
+        });
+        self.finish_change(true)
+    }
+
+    pub(crate) fn resolve_approval(
+        &mut self,
+        thread_id: ThreadId,
+        request_id: &str,
+    ) -> LiveStateChange {
+        self.telemetry.events_reduced = self.telemetry.events_reduced.saturating_add(1);
+        let Some(agent) = self.agents.get_mut(&thread_id) else {
+            return LiveStateChange::Unchanged;
+        };
+        let Some(approval) = agent
+            .open_approval
+            .take_if(|approval| approval.request_id == request_id)
+        else {
+            return LiveStateChange::Unchanged;
+        };
+        if agent.lifecycle == LiveAgentStatus::WaitingApproval {
+            agent.lifecycle = approval.previous_agent_status;
+        }
+        restore_approval_activity(agent, &approval);
+        self.finish_change(true)
+    }
+
+    pub(crate) fn remove_agent(&mut self, thread_id: ThreadId) -> LiveStateChange {
+        self.telemetry.events_reduced = self.telemetry.events_reduced.saturating_add(1);
+        let changed = self.agents.remove(&thread_id).is_some();
+        self.finish_change(changed)
+    }
+
+    /// Authoritative one-shot hydration may begin a new live epoch for a terminal tombstone.
+    #[cfg(test)]
+    pub(crate) fn hydrate_live_agent(
+        &mut self,
+        thread_id: ThreadId,
+        status: LiveAgentStatus,
+    ) -> LiveStateChange {
+        if status.is_terminal() {
+            let changed = self.agents.remove(&thread_id).is_some();
+            return self.finish_change(changed);
+        }
+        self.archived_agents.remove(&thread_id);
+        let changed = hydrate_agent(&mut self.agents, thread_id, status, Instant::now());
+        self.finish_change(changed)
+    }
+
+    /// Reconciles once against authoritative live children; it performs no polling or replay.
+    pub(crate) fn reconcile_live_agents(
+        &mut self,
+        live_agents: impl IntoIterator<Item = (ThreadId, LiveAgentStatus)>,
+    ) -> LiveStateChange {
+        let authoritative = live_agents
+            .into_iter()
+            .filter(|(_, status)| !status.is_terminal())
+            .collect::<HashMap<_, _>>();
+        let original_len = self.agents.len();
+        self.agents
+            .retain(|thread_id, _| authoritative.contains_key(thread_id));
+        let mut changed = self.agents.len() != original_len;
+        let now = Instant::now();
+        for (thread_id, status) in authoritative {
+            self.archived_agents.remove(&thread_id);
+            changed |= hydrate_agent(&mut self.agents, thread_id, status, now);
+        }
+        self.finish_change(changed)
+    }
+
+    pub(crate) fn reset(&mut self) -> LiveStateChange {
+        let changed = !self.agents.is_empty() || !self.archived_agents.is_empty();
+        self.agents.clear();
+        self.archived_agents.clear();
+        self.finish_change(changed)
+    }
+
+    pub(crate) fn take_terminal_batch(&mut self) -> Option<HashMap<ThreadId, LiveAgentState>> {
+        if self.agents.is_empty()
+            || self
+                .agents
+                .values()
+                .any(|agent| !agent.lifecycle.is_terminal())
+        {
+            return None;
+        }
+
+        self.archived_agents.extend(self.agents.keys().copied());
+        self.revision = self.revision.wrapping_add(1);
+        Some(std::mem::take(&mut self.agents))
+    }
+
+    fn set_terminal(
+        &mut self,
+        thread_id: ThreadId,
+        status: LiveAgentStatus,
+        now: Instant,
+        stats: Option<LiveAgentStats>,
+    ) -> LiveStateChange {
+        if self.archived_agents.contains(&thread_id) {
+            self.telemetry.duplicate_events = self.telemetry.duplicate_events.saturating_add(1);
+            return LiveStateChange::Unchanged;
+        }
+        if let Some(agent) = self.agents.get(&thread_id)
+            && agent.lifecycle.is_terminal()
+        {
+            if agent.lifecycle == status {
+                self.telemetry.duplicate_events = self.telemetry.duplicate_events.saturating_add(1);
+            } else {
+                self.telemetry.conflicting_terminal_events =
+                    self.telemetry.conflicting_terminal_events.saturating_add(1);
+            }
+            return LiveStateChange::Unchanged;
+        }
+
+        let agent = self
+            .agents
+            .entry(thread_id)
+            .or_insert_with(|| LiveAgentState::new(status, now));
+        let stats = stats.unwrap_or(LiveAgentStats {
+            tool_uses: agent.tool_uses_started,
+            tokens: current_turn_tokens(agent),
+            duration: now.saturating_duration_since(
+                agent.turn_started_at.unwrap_or(agent.animation_started_at),
+            ),
+        });
+        agent.lifecycle = status;
+        agent.recent.clear();
+        agent.open_approval = None;
+        agent.terminal_stats = Some(stats);
+        self.finish_change(true)
+    }
+
+    fn finish_change(&mut self, changed: bool) -> LiveStateChange {
+        if changed {
+            self.revision = self.revision.wrapping_add(1);
+            LiveStateChange::Changed
+        } else {
+            LiveStateChange::Unchanged
+        }
+    }
+}
+
+fn activity_status_is_terminal(status: ActivityStatus) -> bool {
+    matches!(
+        status,
+        ActivityStatus::Succeeded
+            | ActivityStatus::Failed
+            | ActivityStatus::Declined
+            | ActivityStatus::Cancelled
+    )
+}
+
+fn begin_turn_if_needed(agent: &mut LiveAgentState, now: Instant) {
+    if agent.turn_started_at.is_none() {
+        agent.turn_started_at = Some(now);
+        agent.tokens_at_turn_start = agent.total_tokens;
+        agent.tool_uses_started = 0;
+    }
+}
+
+fn current_turn_tokens(agent: &LiveAgentState) -> i64 {
+    agent
+        .total_tokens
+        .saturating_sub(agent.tokens_at_turn_start)
+        .max(0)
+}
+
+fn restore_approval_activity(agent: &mut LiveAgentState, approval: &ApprovalRef) {
+    let Some(previous_status) = approval.previous_activity_status else {
+        return;
+    };
+    let Some(item_id) = approval.item_id.as_deref() else {
+        return;
+    };
+    if let Some(activity) = agent.recent.iter_mut().find(|activity| {
+        activity.id == item_id && activity.status == ActivityStatus::WaitingApproval
+    }) {
+        activity.status = previous_status;
+    }
+}
+
+fn hydrate_agent(
+    agents: &mut HashMap<ThreadId, LiveAgentState>,
+    thread_id: ThreadId,
+    status: LiveAgentStatus,
+    now: Instant,
+) -> bool {
+    let Some(agent) = agents.get_mut(&thread_id) else {
+        agents.insert(thread_id, LiveAgentState::new(status, now));
+        return true;
+    };
+    let was_terminal = agent.lifecycle.is_terminal();
+    let changed = agent.lifecycle != status || agent.open_approval.is_some();
+    agent.lifecycle = status;
+    agent.open_approval = None;
+    agent.terminal_stats = None;
+    if was_terminal {
+        agent.recent.clear();
+        agent.animation_started_at = now;
+        agent.turn_started_at = None;
+        agent.tool_uses_started = 0;
+        agent.tokens_at_turn_start = agent.total_tokens;
+    }
+    if status != LiveAgentStatus::Starting {
+        begin_turn_if_needed(agent, now);
+    }
+    changed
+}

+#[test]
+fn failed_transitions_remain_fail_closed() {
+    let capture = MouseCapture::default();
+    assert!(
+        capture
+            .finish_transition(
+                /*enabled*/ true,
+                Err(std::io::Error::other("test enable failure")),
+            )
+            .is_err()
+    );
+    assert!(!capture.active());
+
+    capture
+        .finish_transition(/*enabled*/ true, Ok(()))
+        .expect("enable state");
+    assert!(
+        capture
+            .finish_transition(
+                /*enabled*/ false,
+                Err(std::io::Error::other("test disable failure")),
+            )
+            .is_err()
+    );
+    assert!(!capture.active());
+}

+#[test]
+fn transition_guard_emits_enable_and_disable_and_tracks_safe_state() {
+    let capture = MouseCapture::default();
+    let mut output = Vec::new();
+
+    capture
+        .set_with_writer(&mut output, /*enabled*/ true)
+        .expect("enable capture");
+    assert!(capture.active());
+    capture
+        .force_off_with_writer(&mut output)
+        .expect("force capture off");
+    assert!(!capture.active());
+    capture
+        .set_with_writer(&mut output, /*enabled*/ true)
+        .expect("re-enable capture");
+    capture
+        .set_with_writer(&mut output, /*enabled*/ false)
+        .expect("disable capture");
+
+    assert!(!capture.active());
+    let mut ansi = String::new();
+    EnableMouseCapture
+        .write_ansi(&mut ansi)
+        .expect("enable ANSI");
+    DisableMouseCapture
+        .write_ansi(&mut ansi)
+        .expect("disable ANSI");
+    assert_eq!(
+        ansi,
+        "\u{1b}[?1000h\u{1b}[?1002h\u{1b}[?1003h\u{1b}[?1015h\u{1b}[?1006h\u{1b}[?1006l\u{1b}[?1015l\u{1b}[?1003l\u{1b}[?1002l\u{1b}[?1000l"
+    );
+}

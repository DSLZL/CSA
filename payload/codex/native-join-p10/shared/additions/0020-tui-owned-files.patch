+//! Resident rendering and final-history formatting for the App-owned sub-agent projection.
+
+use crate::app::ActivityStatus;
+use crate::app::LiveAgentState;
+use crate::app::LiveAgentStatus;
+use crate::csa_graphics::CsaOrbitPlacement;
+use crate::history_cell::sanitize_user_text;
+use crate::line_truncation::truncate_line_with_ellipsis_if_overflow;
+use crate::render::renderable::Renderable;
+use codex_protocol::ThreadId;
+use ratatui::buffer::Buffer;
+use ratatui::buffer::CellDiffOption;
+use ratatui::layout::Rect;
+use ratatui::layout::Size;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::text::Span;
+use ratatui::widgets::Clear;
+use ratatui::widgets::Widget;
+use std::borrow::Cow;
+use std::cell::RefCell;
+
+const MIN_CONVERSATION_HEIGHT: u16 = 8;
+const PANEL_HARD_CAP: u16 = 12;
+const FULL_MODE_MIN_WIDTH: u16 = 96;
+const COMPACT_MODE_MIN_WIDTH: u16 = 72;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum LivePanelMode {

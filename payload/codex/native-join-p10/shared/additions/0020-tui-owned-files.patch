+#[allow(dead_code)] // TUI-06 consumes revisioned hit testing; TUI-05 verifies the contract.
+impl LivePanelFrame {
+    pub(crate) fn render_revision(&self) -> u64 {
+        self.render_revision
+    }
+
+    pub(crate) fn state_revision(&self) -> u64 {
+        self.state_revision
+    }
+
+    pub(crate) fn panel_rect(&self) -> Option<Rect> {
+        self.panel_rect
+    }
+
+    pub(crate) fn mode(&self) -> Option<LivePanelMode> {
+        self.mode
+    }
+
+    pub(crate) fn hidden_count(&self) -> usize {
+        self.hidden_count
+    }
+
+    pub(crate) fn hit_regions(&self) -> &[LiveAgentHitRegion] {
+        &self.hit_regions
+    }
+
+    pub(crate) fn csa_orbit_placements(&self) -> &[CsaOrbitPlacement] {
+        &self.csa_orbit_placements
+    }
+
+    pub(crate) fn prepare_resize(&mut self, screen_size: Size) {
+        if self.screen_size != Some(screen_size) {
+            self.clear_visible_frame();
+            self.screen_size = Some(screen_size);
+        }
+    }
+
+    pub(crate) fn clear(&mut self) {
+        self.clear_visible_frame();
+        self.screen_size = None;
+    }
+
+    pub(crate) fn hit_test(
+        &self,
+        x: u16,
+        y: u16,
+        expected_render_revision: u64,
+    ) -> Option<ThreadId> {
+        if expected_render_revision != self.render_revision {
+            return None;
+        }
+        self.hit_regions
+            .iter()
+            .find(|region| {
+                x >= region.rect.x
+                    && x < region.rect.right()
+                    && y >= region.rect.y
+                    && y < region.rect.bottom()
+            })
+            .map(|region| region.thread_id)
+    }
+
+    fn clear_visible_frame(&mut self) {
+        if self.panel_rect.is_some()
+            || !self.hit_regions.is_empty()
+            || !self.csa_orbit_placements.is_empty()
+        {
+            self.render_revision = self.render_revision.wrapping_add(1);
+        }
+        self.state_revision = 0;
+        self.panel_rect = None;
+        self.mode = None;
+        self.hidden_count = 0;
+        self.hit_regions.clear();
+        self.csa_orbit_placements.clear();
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn publish(
+        &mut self,
+        screen_size: Size,
+        state_revision: u64,
+        panel_rect: Rect,
+        mode: LivePanelMode,
+        hidden_count: usize,
+        regions: Vec<(ThreadId, Rect)>,
+        csa_orbit_placements: Vec<CsaOrbitPlacement>,
+    ) {
+        self.render_revision = self.render_revision.wrapping_add(1);
+        self.state_revision = state_revision;
+        self.screen_size = Some(screen_size);
+        self.panel_rect = Some(panel_rect);
+        self.mode = Some(mode);
+        self.hidden_count = hidden_count;
+        self.hit_regions = regions
+            .into_iter()
+            .map(|(thread_id, rect)| LiveAgentHitRegion {
+                thread_id,
+                rect,
+                render_revision: self.render_revision,
+                state_revision,
+            })
+            .collect();
+        self.csa_orbit_placements = csa_orbit_placements;
+    }
+}

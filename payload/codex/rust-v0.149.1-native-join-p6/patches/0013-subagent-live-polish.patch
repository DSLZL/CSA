+/// Terminal-native adaptation of BeautifulUI's perimeter-orbit loading state.
+pub(crate) fn orbit_indicator(
+    start_time: Instant,
+    now: Instant,
+    motion_mode: MotionMode,
+) -> Span<'static> {
+    match motion_mode {
+        MotionMode::Animated => orbit_frame_at(start_time, now).into(),
+        MotionMode::Reduced => "◌".dim(),
+    }
+}
+
+pub(crate) fn orbit_frame_at(start_time: Instant, now: Instant) -> &'static str {
+    let elapsed = now.saturating_duration_since(start_time);
+    let frame_index = (elapsed.as_millis() / ORBIT_FRAME_INTERVAL.as_millis()) as usize;
+    ORBIT_FRAMES[frame_index % ORBIT_FRAMES.len()]
+}

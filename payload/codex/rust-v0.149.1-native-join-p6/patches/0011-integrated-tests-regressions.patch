+#[tokio::test]
+async fn subagent_live_routing_covers_i01_through_i08_without_main_ops() -> Result<()> {
+    let (mut app, _app_event_rx, mut op_rx) = make_test_app_with_channels().await;
+    let main_thread_id = ThreadId::new();
+    let inactive_child_id = ThreadId::new();
+    let active_child_id = ThreadId::new();
+    let side_thread_id = ThreadId::new();
+
+    app.primary_thread_id = Some(main_thread_id);
+    app.active_thread_id = Some(main_thread_id);
+    for (thread_id, nickname) in [(inactive_child_id, "Inactive"), (active_child_id, "Active")] {
+        app.agent_navigation.upsert(
+            thread_id,
+            Some(nickname.to_string()),
+            Some("worker".to_string()),
+            /*is_closed*/ false,
+        );
+        app.agent_navigation.mark_parent_owned(thread_id);
+        app.thread_event_channels
+            .insert(thread_id, ThreadEventChannel::new(/*capacity*/ 8));
+    }
+    app.set_thread_active(active_child_id, /*active*/ true)
+        .await;
+    app.side_threads
+        .insert(side_thread_id, SideThreadState::new(main_thread_id));
+
+    let (frame_requester, mut frame_rx) = crate::tui::FrameRequester::test_channel();
+    app.chat_widget.frame_requester = frame_requester;
+
+    let inactive_started = command_item_notification(
+        inactive_child_id,
+        "turn-inactive",
+        "call-inactive",
+        codex_app_server_protocol::CommandExecutionStatus::InProgress,
+        /*completed*/ false,
+    );
+    app.enqueue_thread_notification(inactive_child_id, inactive_started.clone())
+        .await?;
+    let inactive = app
+        .subagent_live_state()
+        .agent(inactive_child_id)
+        .expect("I-01 inactive child should be projected");
+    assert_eq!(
+        inactive.lifecycle(),
+        subagent_live::LiveAgentStatus::Running
+    );
+    assert_eq!(inactive.recent().len(), 1);
+    assert!(
+        frame_rx.try_recv().is_ok(),
+        "changed state should request a frame"
+    );
+    assert!(frame_rx.try_recv().is_err());
+
+    app.enqueue_thread_notification(inactive_child_id, inactive_started)
+        .await?;
+    assert!(
+        frame_rx.try_recv().is_err(),
+        "duplicate state must not request another frame"
+    );
+
+    app.enqueue_thread_notification(
+        active_child_id,
+        command_item_notification(
+            active_child_id,
+            "turn-active",
+            "call-active",
+            codex_app_server_protocol::CommandExecutionStatus::InProgress,
+            /*completed*/ false,
+        ),
+    )
+    .await?;
+    assert_eq!(
+        app.subagent_live_state()
+            .agent(active_child_id)
+            .expect("I-02 active child should be projected")
+            .recent()
+            .len(),
+        1
+    );
+
+    app.enqueue_thread_notification(
+        inactive_child_id,
+        command_item_notification(
+            inactive_child_id,
+            "turn-inactive",
+            "call-inactive",
+            codex_app_server_protocol::CommandExecutionStatus::Completed,
+            /*completed*/ true,
+        ),
+    )
+    .await?;
+    let inactive = app.subagent_live_state().agent(inactive_child_id).unwrap();
+    assert_eq!(
+        inactive.recent().len(),
+        1,
+        "I-03 completion updates in place"
+    );
+    assert_eq!(
+        inactive.recent()[0].status,
+        agent_status_feed::ActivityStatus::Succeeded
+    );
+    assert_eq!(
+        app.subagent_live_state()
+            .agent(active_child_id)
+            .unwrap()
+            .recent()[0]
+            .status,
+        agent_status_feed::ActivityStatus::Running,
+        "I-04 sibling state must remain isolated"
+    );
+
+    for thread_id in [main_thread_id, side_thread_id] {
+        app.enqueue_thread_notification(
+            thread_id,
+            command_item_notification(
+                thread_id,
+                "turn-filtered",
+                "call-filtered",
+                codex_app_server_protocol::CommandExecutionStatus::InProgress,
+                /*completed*/ false,
+            ),
+        )
+        .await?;
+    }
+    assert!(
+        app.subagent_live_state().agent(main_thread_id).is_none(),
+        "I-05 Main activity must be excluded"
+    );
+    assert!(
+        app.subagent_live_state().agent(side_thread_id).is_none(),
+        "I-06 non-child side activity must be excluded"
+    );
+
+    let approval = exec_approval_request(
+        inactive_child_id,
+        "turn-inactive",
+        "call-inactive",
+        /*approval_id*/ None,
+    );
+    assert_eq!(
+        app.pending_app_server_requests
+            .note_server_request(&approval),
+        None
+    );
+    app.enqueue_thread_request(inactive_child_id, approval)
+        .await?;
+    let inactive = app.subagent_live_state().agent(inactive_child_id).unwrap();
+    assert_eq!(
+        inactive.lifecycle(),
+        subagent_live::LiveAgentStatus::WaitingApproval
+    );
+    assert_eq!(
+        inactive.recent()[0].status,
+        agent_status_feed::ActivityStatus::Succeeded,
+        "I-07 approval must not overwrite a terminal activity"
+    );
+    assert_eq!(
+        app.chat_widget.pending_thread_approvals(),
+        &["Inactive [worker]".to_string()],
+        "I-07 existing approval queue remains authoritative"
+    );
+
+    app.enqueue_thread_notification(
+        inactive_child_id,
+        ServerNotification::ServerRequestResolved(
+            codex_app_server_protocol::ServerRequestResolvedNotification {
+                thread_id: inactive_child_id.to_string(),
+                request_id: AppServerRequestId::Integer(1),
+            },
+        ),
+    )
+    .await?;
+    let inactive = app.subagent_live_state().agent(inactive_child_id).unwrap();
+    assert_eq!(
+        inactive.lifecycle(),
+        subagent_live::LiveAgentStatus::Running
+    );
+    assert_eq!(
+        inactive.recent()[0].status,
+        agent_status_feed::ActivityStatus::Succeeded,
+        "approval resolution must restore, not invent, activity success"
+    );
+
+    app.enqueue_thread_notification(
+        inactive_child_id,
+        turn_completed_notification(inactive_child_id, "turn-inactive", TurnStatus::Completed),
+    )
+    .await?;
+    let inactive = app.subagent_live_state().agent(inactive_child_id).unwrap();
+    assert_eq!(
+        inactive.lifecycle(),
+        subagent_live::LiveAgentStatus::Completed
+    );
+    assert!(!inactive.is_renderable_at(Instant::now()));
+
+    while frame_rx.try_recv().is_ok() {}
+    let before_interrupt = Instant::now();
+    app.enqueue_thread_notification(
+        active_child_id,
+        turn_completed_notification(active_child_id, "turn-active", TurnStatus::Interrupted),
+    )
+    .await?;
+    let active = app.subagent_live_state().agent(active_child_id).unwrap();
+    assert_eq!(
+        active.lifecycle(),
+        subagent_live::LiveAgentStatus::Cancelled
+    );
+    assert!(active.is_renderable_at(before_interrupt));
+    let scheduled = std::iter::from_fn(|| frame_rx.try_recv().ok()).collect::<Vec<_>>();
+    assert_eq!(
+        scheduled.len(),
+        2,
+        "I-08 interrupt draws now and at grace expiry"
+    );
+    assert!(
+        scheduled
+            .iter()
+            .any(|deadline| *deadline > before_interrupt)
+    );
+
+    app.enqueue_thread_notification(active_child_id, thread_closed_notification(active_child_id))
+        .await?;
+    assert!(app.subagent_live_state().agent(active_child_id).is_none());
+    assert!(
+        op_rx.try_recv().is_err(),
+        "live projection routing must not submit a Main model operation"
+    );
+    Ok(())
+}

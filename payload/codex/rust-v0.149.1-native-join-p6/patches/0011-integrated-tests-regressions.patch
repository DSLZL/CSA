+#[tokio::test]
+async fn subagent_live_panel_is_main_only_hidden_by_raw_and_overlay_and_read_only() {
+    let (mut app, mut app_event_rx, mut op_rx) = make_test_app_with_channels().await;
+    let main_thread_id = ThreadId::new();
+    let child_thread_id = ThreadId::new();
+    app.primary_thread_id = Some(main_thread_id);
+    app.active_thread_id = Some(main_thread_id);
+    app.agent_navigation.upsert(
+        child_thread_id,
+        Some("Renderer".to_string()),
+        Some("worker".to_string()),
+        /*is_closed*/ false,
+    );
+    app.agent_navigation.mark_parent_owned(child_thread_id);
+    let _ = app.subagent_live.reduce_activity(
+        child_thread_id,
+        agent_status_feed::WorkActivityInput {
+            id: "render-work".to_string(),
+            kind: agent_status_feed::WorkActivityKind::Command,
+            label: "cargo test".to_string(),
+            status: agent_status_feed::ActivityStatus::Running,
+        },
+    );
+    let state_revision = app.subagent_live.revision();
+    let screen_size = Size::new(120, 40);
+
+    let panel = app
+        .subagent_live_panel_renderable(screen_size, Instant::now())
+        .expect("Main should show a parent-owned live child");
+    let height = panel.desired_height(screen_size.width);
+    let area = Rect::new(0, 0, screen_size.width, height);
+    let mut buffer = Buffer::empty(area);
+    panel.render(area, &mut buffer);
+    drop(panel);
+
+    assert_eq!(app.subagent_live.revision(), state_revision);
+    assert_eq!(
+        app.subagent_live_panel_frame.borrow().panel_rect(),
+        Some(area)
+    );
+    assert!(app_event_rx.try_recv().is_err());
+    assert!(op_rx.try_recv().is_err());
+
+    app.primary_thread_id = None;
+    assert!(
+        app.subagent_live_panel_renderable(screen_size, Instant::now())
+            .is_none()
+    );
+    assert_eq!(app.subagent_live_panel_frame.borrow().panel_rect(), None);
+    app.primary_thread_id = Some(main_thread_id);
+
+    app.chat_widget.set_raw_output_mode(/*enabled*/ true);
+    assert!(
+        app.subagent_live_panel_renderable(screen_size, Instant::now())
+            .is_none()
+    );
+    assert_eq!(app.subagent_live_panel_frame.borrow().panel_rect(), None);
+
+    app.chat_widget.set_raw_output_mode(/*enabled*/ false);
+    app.active_thread_id = Some(child_thread_id);
+    assert!(
+        app.subagent_live_panel_renderable(screen_size, Instant::now())
+            .is_none()
+    );
+
+    app.active_thread_id = Some(main_thread_id);
+    app.overlay = Some(Overlay::new_transcript(
+        Vec::new(),
+        crate::keymap::RuntimeKeymap::defaults().pager,
+    ));
+    assert!(
+        app.subagent_live_panel_renderable(screen_size, Instant::now())
+            .is_none()
+    );
+    assert_eq!(app.subagent_live_panel_frame.borrow().panel_rect(), None);
+
+    app.overlay = None;
+    app.chat_widget.open_multi_agent_enable_prompt();
+    assert!(app.chat_widget.has_active_view());
+    assert!(
+        app.subagent_live_panel_renderable(screen_size, Instant::now())
+            .is_none()
+    );
+}

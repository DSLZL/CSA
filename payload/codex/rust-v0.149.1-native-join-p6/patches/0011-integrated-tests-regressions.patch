+
+    app.handle_mouse_event(click(
+        region.rect.x,
+        region.rect.y + 2,
+        MouseEventKind::Down(MouseButton::Left),
+    ));
+    assert_matches!(
+        app_event_rx.try_recv(),
+        Ok(AppEvent::SelectAgentThread(thread_id)) if thread_id == child_thread_id
+    );
+
+    app.handle_mouse_event(click(
+        region.rect.right(),
+        region.rect.y,
+        MouseEventKind::Down(MouseButton::Left),
+    ));
+    app.handle_mouse_event(click(
+        region.rect.x,
+        region.rect.y,
+        MouseEventKind::Up(MouseButton::Left),
+    ));
+    app.handle_mouse_event(click(
+        region.rect.x,
+        region.rect.y,
+        MouseEventKind::Down(MouseButton::Right),
+    ));
+    assert!(app_event_rx.try_recv().is_err());
+
+    let stale_revision = app.subagent_live_panel_frame.borrow().render_revision();
+    let panel = app
+        .subagent_live_panel_renderable(screen_size, Instant::now())
+        .expect("rerendered live panel");
+    panel.render(area, &mut Buffer::empty(area));
+    drop(panel);
+    app.handle_mouse_event_at_revision(
+        click(
+            region.rect.x,
+            region.rect.y,
+            MouseEventKind::Down(MouseButton::Left),
+        ),
+        stale_revision,
+    );
+    assert!(app_event_rx.try_recv().is_err());
+
+    app.overlay = Some(Overlay::new_transcript(
+        Vec::new(),
+        crate::keymap::RuntimeKeymap::defaults().pager,
+    ));
+    app.handle_mouse_event(click(
+        region.rect.x,
+        region.rect.y,
+        MouseEventKind::Down(MouseButton::Left),
+    ));
+    assert!(app_event_rx.try_recv().is_err());
+    app.overlay = None;
+
+    let _ = app.subagent_live.set_agent_status(
+        child_thread_id,
+        LiveAgentStatus::Completed,
+        Instant::now(),
+    );
+    app.handle_mouse_event(click(
+        region.rect.x,
+        region.rect.y,
+        MouseEventKind::Down(MouseButton::Left),
+    ));
+    assert_matches!(
+        app_event_rx.try_recv(),
+        Ok(AppEvent::SelectAgentThread(thread_id)) if thread_id == child_thread_id
+    );
+
+    app.agent_navigation.remove(child_thread_id);
+    app.handle_mouse_event(click(
+        region.rect.x,
+        region.rect.y,
+        MouseEventKind::Down(MouseButton::Left),
+    ));
+    assert!(app_event_rx.try_recv().is_err());
+
+    app.chat_widget.open_multi_agent_enable_prompt();
+    app.handle_mouse_event(click(
+        region.rect.x,
+        region.rect.y,
+        MouseEventKind::Down(MouseButton::Left),
+    ));
+    assert!(app_event_rx.try_recv().is_err());
+}

{
  "build": {
    "argv": [
      "cargo",
      "build",
      "-p",
      "codex-cli",
      "--bin",
      "codex",
      "--release",
      "--target",
      "x86_64-pc-windows-msvc"
    ],
    "artifact": "{cargo_target}/x86_64-pc-windows-msvc/release/codex.exe",
    "env": {
      "CARGO_BUILD_JOBS": "4",
      "CARGO_PROFILE_RELEASE_DEBUG": "0",
      "SOURCE_DATE_EPOCH": "1786063808"
    }
  },
  "common_env": {
    "CARGO_BUILD_JOBS": "2",
    "CARGO_INCREMENTAL": "0",
    "CARGO_TARGET_DIR": "{cargo_target}",
    "INSTA_OUTPUT": "none",
    "INSTA_UPDATE": "no",
    "INSTA_WORKSPACE_ROOT": "{source}/codex-rs",
    "RUST_MIN_STACK": "8388608"
  },
  "compat_id": "rust-v0.149.1-native-join-p6",
  "cwd": "{source}/codex-rs",
  "generation": [
    {
      "argv": [
        "cargo",
        "test",
        "-p",
        "codex-app-server-protocol",
        "write_schema_fixtures_from_env",
        "--",
        "--ignored",
        "--nocapture"
      ],
      "env": {
        "CODEX_APP_SERVER_SCHEMA_EXPERIMENTAL": "0",
        "CODEX_APP_SERVER_SCHEMA_ROOT": "{source}/codex-rs/app-server-protocol/schema"
      },
      "name": "stable schema and embedded exports"
    },
    {
      "argv": [
        "cargo",
        "test",
        "-p",
        "codex-app-server-protocol",
        "write_schema_fixtures_from_env",
        "--",
        "--ignored",
        "--nocapture"
      ],
      "env": {
        "CODEX_APP_SERVER_SCHEMA_EXPERIMENTAL": "1",
        "CODEX_APP_SERVER_SCHEMA_ROOT": "{source}/codex-rs/app-server-protocol/schema"
      },
      "name": "experimental embedded exports"
    }
  ],
  "known_upstream_errata": [
    "The rust-v0.149.0 Cargo.lock records workspace packages as 0.0.0; Cargo 1.95.0 mechanically normalizes those entries to 0.149.0 before the build.",
    "The upstream codex-tui app::tests::background_exit_tests::exit_interrupts_before_requesting_shutdown test can observe an unrelated asynchronous event first under parallel load; the contract runs it separately with one test thread and skips only its duplicate parallel execution."
  ],
  "parameters": {
    "cargo_target": "absolute disposable Cargo target path",
    "source": "absolute clean checkout path"
  },
  "schema": 1,
  "tests": [
    {
      "argv": [
        "cargo",
        "fmt",
        "--all",
        "--",
        "--check"
      ],
      "name": "workspace formatting"
    },
